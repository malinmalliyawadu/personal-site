{
  "name": "personal-site",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@9.15.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "gh-pages -b gh-pages -d dist",
    "generate-cv": "mkdir -p public/cv && cd cv && docker run --rm -v \"$(pwd):/data\" -w /data texlive/texlive:TL2023-historic lualatex Malin_CV.tex && cp Malin_CV.pdf ../public/cv/"
  },
  "dependencies": {
    "astro": "^7.3.8",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.30"
  },
  "pnpm": {
    "overrides": {
      "postcss-selector-parser@<7.1.6": "^7.1.6"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
