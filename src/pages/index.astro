---

<Layout title="Malin Malliya Wadu | Full-stack Developer">
  <div id="dark-background">
    <MagicParticles />
  </div>
  <div id="light-background" style="display: none;">
    <SkyBackground />
  </div>
  <Navbar />

  <!-- Hero Section -->
  <section id="hero" class="min-h-screen pt-32 md:pt-0 flex items-center relative overflow-hidden">
    <div class="container mx-auto px-4 relative z-10">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-12">
        <div class="md:w-1/2">
          <h1 class="text-5xl sm:text-6xl md:text-8xl font-black mb-4 leading-[0.95] hero-title">
            <span class="block text-white/60 text-2xl sm:text-3xl md:text-4xl font-medium mb-3 font-outfit tracking-tight">Hi, I'm</span>
            <AuroraText
              class="font-outfit font-extrabold block"
              colors={["#667eea", "#764ba2", "#f093fb", "#ff9a9e"]}
              speed={0.8}
            >Malin</AuroraText>
          </h1>
          <p class="text-lg md:text-xl text-gray-400 mb-10 leading-relaxed max-w-xl hero-tagline">
            <span class="text-white font-medium">Full-stack developer</span> from Wellington, NZ with 15+ years of experience building <span class="text-white font-medium">beautiful</span>, <span class="text-white font-medium">performant</span>, and <span class="text-white font-medium">accessible</span> digital experiences.
          </p>
          <div class="flex flex-col sm:flex-row gap-3 md:gap-4 hero-cta">
            <a
              href="#projects"
              class="btn-primary group relative overflow-hidden transform transition-all duration-300"
            >
              <span class="relative z-10 flex items-center gap-2">
                View My Work
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 group-hover:translate-y-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                </svg>
              </span>
            </a>
            <a
              href="/cv/Malin_CV.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary group relative transform transition-all duration-300"
            >
              <span class="relative z-10 flex items-center gap-2">
                Download CV
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </span>
            </a>
          </div>

        </div>
        <div class="md:w-1/2 flex md:justify-end justify-center pb-16 md:pb-0">
          <div class="relative moon-profile group">
            <!-- Orbital ring animation -->
            <div class="absolute -inset-10 rounded-full border border-indigo-500/20 orbital-ring orbital-ring-1 hidden md:block"></div>
            <div class="absolute -inset-16 rounded-full border border-purple-500/10 orbital-ring orbital-ring-2 hidden md:block"></div>

            <!-- Enhanced glow effect -->
            <div class="absolute inset-0 bg-gradient-to-r from-indigo-400/20 to-purple-400/20 rounded-full blur-3xl opacity-20 moon-glow group-hover:opacity-30 transition-all duration-700"></div>

            <!-- Profile image with interactive effect -->
            <Image
              src={profilePic}
              alt="Malin Malliya Wadu"
              width={384}
              height={384}
              class="relative rounded-full w-64 h-64 md:w-96 md:h-96 object-cover shadow-2xl moon-image hover:cursor-pointer"
              id="profile-image"
              loading="eager"
            />
          </div>
        </div>
      </div>

    </div>
    <div class="absolute bottom-10 left-1/2 transform -translate-x-1/2 hidden md:block animate-bounce">
      <a href="#about" class="text-gray-400 hover:text-white transition-colors">
        <span class="sr-only">Scroll to About Me</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </a>
    </div>
  </section>
  
  <!-- About Section -->
  <Section
    id="about"
    title="About Me"
    subtitle="Passionate about creating impactful digital experiences"
  >
    <div class="max-w-3xl mx-auto animate-on-scroll">
      <!-- Professional -->
      <div class="about-prose mb-16">
        <p class="about-text text-lg md:text-xl leading-relaxed mb-5">
          With <span class="about-highlight">15+ years of professional experience</span>, I'm a full-stack developer with expertise in
          <a href="#skills" class="about-link">.NET</a>,
          <a href="#skills" class="about-link">TypeScript</a>,
          <a href="#skills" class="about-link">React</a>, and
          <a href="#skills" class="about-link">AWS</a>.
        </p>
        <p class="about-text text-lg md:text-xl leading-relaxed">
          I have a passion for bleeding-edge technologies and automation — consistently exploring ways to streamline development workflows and implement intelligent CI/CD pipelines. My approach combines <span class="about-highlight">technical excellence</span> with a focus on <span class="about-highlight">delivering business value</span> through robust, maintainable code and scalable architecture.
        </p>
      </div>

      <!-- Beyond coding -->
      <div class="text-center">
        <p class="about-beyond-label text-xs font-medium tracking-widest uppercase mb-4">Beyond the keyboard</p>
        <div class="about-emoji-row flex justify-center gap-3 md:gap-4">
          <span class="about-emoji-tooltip" id="emoji-tooltip"></span>
          <span class="about-emoji" data-tooltip="Chasing sunsets in my van">🚐</span>
          <span class="about-emoji" data-tooltip="Exploring hidden corners of the globe">🌏</span>
          <span class="about-emoji" data-tooltip="Crushing PRs at the gym">💪</span>
          <span class="about-emoji" data-tooltip="Finding my zen through hot yoga">🧘‍♂️</span>
          <span class="about-emoji" data-tooltip="Volunteering with local charities">🌱</span>
          <span class="about-emoji" data-tooltip="Experimenting with new recipes">👨‍🍳</span>
          <span class="about-emoji" data-tooltip="Always learning something new">📚</span>
        </div>
      </div>
    </div>
  </Section>
  
  <!-- Work Experience Section -->
  <Section
    id="experience"
    title="Work Experience"
    subtitle="My professional journey in the tech industry"
  >
    <WorkExperience jobs={jobHistory} />
  </Section>
  
  <!-- Skills Section -->
  <Section
    id="skills"
    title="Skills & Technologies"
    subtitle="The tools and technologies I work with"
  >
    <div class="skills-all-container animate-on-scroll">
      {skillCategories.map((category, catIndex) => (
        <div class="skill-group" data-category={catIndex}>
          <div class="skill-group-label">
            <span class="skill-group-line"></span>
            <span class="skill-group-name">{category.name}</span>
            <span class="skill-group-line"></span>
          </div>
          <div class="skill-group-items">
            {category.skills.map((skill) => (
              <SkillIcon name={skill.name} icon={skill.icon} />
            ))}
          </div>
        </div>
      ))}
    </div>
  </Section>
  
  <!-- Certifications Section -->
  <Section
    id="certifications"
    title="Certifications"
    subtitle="Professional certifications and achievements"
  >
    <div class="grid md:grid-cols-2 gap-4 max-w-4xl mx-auto">
      {certifications.map((cert) => (
        <CertificationCard
          title={cert.title}
          issuer={cert.issuer}
          issueDate={cert.issueDate}
          expiryDate={cert.expiryDate}
          image={cert.image}
          link={cert.link}
        />
      ))}
    </div>
    <div class="mt-8 text-center">
      <a 
        href="https://www.credly.com/users/malin-malliya-wadu" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center text-indigo-400 hover:text-indigo-300 transition-colors"
      >
        <span>View all my certifications on Credly</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-1" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>
  </Section>
  
  <!-- Projects Section -->
  <Section
    id="projects"
    title="Featured Projects"
    subtitle="Explore my latest creations"
  >
    <div class="flex flex-col gap-8 lg:gap-12">
      {projects.map((project, index) => (
        <div class="animate-on-scroll" style={`animation-delay: ${index * 0.2}s`}>
          <ProjectCard
            title={project.title}
            description={project.description}
            image={project.image}
            images={project.images}
            phoneImage={project.phoneImage}
            phoneImageAlt={project.phoneImageAlt}
            github={project.github}
            demo={project.demo}
            appStore={project.appStore}
            playStore={project.playStore}
            stats={project.stats}
            wip={project.wip}
            index={index}
          />
        </div>
      ))}
    </div>
    <div class="mt-12 text-center animate-on-scroll">
      <a
        href="https://github.com/malinmalliyawadu"
        target="_blank"
        rel="noopener noreferrer"
        class="github-link inline-flex items-center gap-3 px-8 py-4 rounded-xl font-semibold text-white bg-gradient-to-r from-gray-800 to-gray-900 border border-gray-700/50 hover:border-purple-500/50 hover:shadow-lg hover:shadow-purple-500/10 transition-all duration-300 hover:-translate-y-1"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
          <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"></path>
        </svg>
        See all projects on GitHub
      </a>
    </div>
  </Section>

  <!-- Contact Section -->
  <section id="contact" class="relative py-24 md:py-32 overflow-hidden">
    <!-- Ambient glow -->
    <div class="contact-glow absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full pointer-events-none"></div>

    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-2xl mx-auto text-center animate-on-scroll">
        <p class="contact-overline text-sm font-medium tracking-widest uppercase mb-4">Get in touch</p>
        <h2 class="contact-heading text-4xl md:text-5xl font-bold text-white mb-6 leading-tight">
          Let's build something<br/>
          <span class="bg-gradient-to-r from-indigo-400 via-purple-400 to-pink-400 bg-clip-text text-transparent">together.</span>
        </h2>
        <p class="contact-subtext text-lg text-gray-400 mb-12 max-w-lg mx-auto leading-relaxed">
          Currently available for freelance projects and exciting opportunities. Drop me a line and let's talk.
        </p>

        <!-- Email as the hero action -->
        <a
          href="mailto:malin.malliya.wadu@gmail.com"
          class="contact-email-link group inline-flex items-center gap-3 text-lg md:text-xl font-medium transition-all duration-300 mb-12"
        >
