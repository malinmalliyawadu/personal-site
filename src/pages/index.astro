---

<Layout title="Malin Malliya Wadu | Full-stack Developer">
  <div id="background-container">
    <MagicParticles />
  </div>
  <Navbar />

  <!-- Hero Section -->
  <section id="hero" class="min-h-screen pt-32 md:pt-0 flex items-center relative">
    <div class="container mx-auto px-4">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-12">
        <div class="md:w-1/2">
          <div class="inline-block mb-2 px-3 py-1 bg-indigo-900/30 border border-indigo-800/50 rounded-full text-sm font-medium text-indigo-300">
            Full-stack Developer
          </div>
          <h1 class="text-6xl md:text-7xl font-black mb-2">
            Hi, I'm <AuroraText 
              class="font-outfit font-extrabold" 
              colors={["#818cf8", "#c084fc", "#6366f1", "#a855f7"]}
              speed={0.8}
            >Malin</AuroraText>
            <span class="inline-block animate-wave">👋</span>
          </h1>
          <p class="text-xl md:text-2xl text-gray-300 mb-8 leading-relaxed">
            A full-stack developer from Wellington, NZ specializing in building beautiful, performant, and accessible web experiences.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a 
              href="#projects" 
              class="btn-primary"
            >
              View Projects
            </a>
            <a 
              href="/cv/Malin_CV.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary"
            >
              Resume
            </a>
          </div>
        </div>
        <div class="md:w-1/2 flex md:justify-end justify-center">
          <div class="relative moon-profile">
            <div class="absolute inset-0 bg-gradient-to-r from-slate-400 to-gray-300 rounded-full blur-3xl opacity-10 moon-glow"></div>
            <img
              src={profilePic.src}
              alt="Malin Malliya Wadu"
              class="relative rounded-full w-64 h-64 md:w-96 md:h-96 object-cover shadow-2xl moon-image"
              id="profile-image"
            />
          </div>
        </div>
      </div>
      
      <div class="absolute bottom-10 left-1/2 transform -translate-x-1/2 hidden md:block animate-bounce">
        <a href="#about" class="text-gray-400 hover:text-white transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </a>
      </div>
    </div>
  </section>
  
  <!-- About Section -->
  <Section
    id="about"
    title="About Me"
    subtitle="Learn more about my background and what drives me"
  >
    <div class="max-w-4xl mx-auto">
      <div class="grid md:grid-cols-2 gap-8 mb-8">
        <!-- Professional card -->
        <div class="bg-gray-800/40 rounded-xl p-8 backdrop-blur-sm border border-gray-700/50 shadow-xl relative overflow-hidden">
          <!-- Gradient accent -->
          <div class="absolute -top-24 -right-24 w-48 h-48 bg-indigo-600/20 rounded-full blur-3xl"></div>
          
          <!-- Professional section -->
          <div class="relative z-10 space-y-4">
            <div class="flex items-center mb-4">
              <div class="p-2 bg-indigo-900/30 rounded-lg mr-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                </svg>
              </div>
              <h3 class="text-xl font-bold text-white">Professional Skills</h3>
            </div>
            <p class="text-lg leading-relaxed">
              With <span class="text-indigo-300 font-medium">14+ years of professional experience</span>, I'm a full-stack developer with expertise in 
              <a href="#skills" class="text-indigo-400 font-medium hover:text-indigo-300 transition-colors">.NET</a>, 
              <a href="#skills" class="text-indigo-400 font-medium hover:text-indigo-300 transition-colors">TypeScript</a>, 
              <a href="#skills" class="text-indigo-400 font-medium hover:text-indigo-300 transition-colors">React</a>, and 
              <a href="#skills" class="text-indigo-400 font-medium hover:text-indigo-300 transition-colors">AWS</a>.
              I've developed a passion for bleeding-edge technologies and automation, consistently exploring ways to streamline development workflows and implement intelligent CI/CD pipelines.
            </p>
            <p class="text-lg leading-relaxed">
              My approach combines <span class="text-purple-300 font-semibold">technical excellence</span> with a focus on <span class="text-purple-300 font-semibold">delivering business value</span> through robust, maintainable code and innovative and scalable architecture.
            </p>
          </div>
        </div>
        
        <!-- Personal card -->
        <div class="bg-gray-800/40 rounded-xl p-8 backdrop-blur-sm border border-gray-700/50 shadow-xl relative overflow-hidden">
          <!-- Gradient accent -->
          <div class="absolute -bottom-24 -left-24 w-48 h-48 bg-purple-600/20 rounded-full blur-3xl"></div>
          
          <!-- Personal section -->
          <div class="relative z-10 space-y-4">
            <div class="flex items-center mb-4">
              <div class="p-2 bg-purple-900/30 rounded-lg mr-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <h3 class="text-xl font-bold text-white">Beyond Coding</h3>
            </div>
            <p class="text-lg leading-relaxed mb-4">
              Off the keyboard, you'll find me:
            </p>
            <ul class="space-y-3">
              <li class="flex items-center">
                <span class="text-xl mr-3">🚐</span>
                <span>Chasing sunsets in my van</span>
              </li>
              <li class="flex items-center">
                <span class="text-xl mr-3">🌏</span>
                <span>Exploring hidden corners of the globe</span>
              </li>
              <li class="flex items-center">
                <span class="text-xl mr-3">💪</span>
                <span>Crushing PRs at the gym</span>
              </li>
              <li class="flex items-center">
                <span class="text-xl mr-3">🧘‍♂️</span>
                <span>Finding my zen through hot yoga</span>
              </li>
              <li class="flex items-center">
                <span class="text-xl mr-3">🌱</span>
                <span>Looking after my plant babies</span>
              </li>
              <li class="flex items-center">
                <span class="text-xl mr-3">👨‍🍳</span>
                <span>Experimenting with new recipes</span>
              </li>
              <li class="flex items-center">
                <span class="text-xl mr-3">📚</span>
                <span>Always learning something new</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
      
      <!-- Experience Counter moved to Work Experience section -->
    </div>
  </Section>
  
  <!-- Work Experience Section -->
  <Section
    id="experience"
    title="Work Experience"
    subtitle="My professional journey in the tech industry"
  >
    <!-- Experience Counter at top of Work Experience section -->
    <ExperienceCounter startDate="2011-10-01" className="mb-12" />
    
    <WorkExperience jobs={jobHistory} />
  </Section>
  
  <!-- Skills Section -->
  <Section
    id="skills"
    title="Skills & Technologies"
    subtitle="The tools and technologies I work with"
  >
    <div class="skills-carousel-container">
      <!-- Category Navigation -->
      <div class="flex justify-center mb-8 overflow-x-auto">
        <div class="flex space-x-2 p-1 bg-gray-800 bg-opacity-40 rounded-lg">
          {skillCategories.map((category, index) => (
            <button 
              class="skills-nav-button px-4 py-2 rounded-md text-sm transition-all duration-300" 
              data-index={index}
              aria-label={`Show ${category.name} skills`}
            >
              {category.name}
            </button>
          ))}
        </div>
      </div>
      
      <!-- Carousel Container with overflow control -->
      <div class="overflow-hidden">
        <div class="skills-carousel relative">
          <div class="skills-carousel-track flex transition-transform duration-500">
            {skillCategories.map((category) => (
              <div class="skills-carousel-slide w-full flex-shrink-0">
                <div class="flex flex-wrap justify-center py-2 px-4">
                  {category.skills.map((skill) => (
                    <SkillIcon name={skill.name} icon={skill.icon} />
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </Section>
  
  <!-- Projects Section -->
  <Section
    id="projects"
    title="Projects"
    subtitle="Check out some of my recent work"
  >
    <div class="grid md:grid-cols-2 gap-8">
      {projects.map((project) => (
        <ProjectCard
          title={project.title}
          description={project.description}
          tags={project.tags}
          image={project.image}
          github={project.github}
          demo={project.demo}
        />
      ))}
    </div>
  </Section>
  
  <!-- Contact Section -->
  <Section
    id="contact"
    title="Get In Touch"
    subtitle="Interested in working together? Let's connect!"
  >
    <div class="max-w-lg mx-auto">
      <div class="bg-gray-800 bg-opacity-50 rounded-xl p-8 backdrop-blur-sm border border-gray-700 text-center">
        <p class="text-lg mb-8">
          I'm currently available for freelance and contract opportunities. Feel free to reach out if you're looking for a developer to help bring your ideas to life!
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="mailto:malin.malliya.wadu@gmail.com"
            class="btn-primary"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
              <rect x="3" y="5" width="18" height="14" rx="2"></rect>
              <polyline points="3 7 12 13 21 7"></polyline>
            </svg>
            Email Me
          </a>
          <a
            href="https://www.linkedin.com/in/malin-malliya-wadu-94956522/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 118.3 6.5a1.78 1.78 0 01-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0013 14.19V19h-3v-9h2.9v1.3a3.11 3.11 0 012.7-1.4c1.55 0 3.36.86 3.36 3.66z"></path>
            </svg>
            LinkedIn
          </a>
        </div>
      </div>
    </div>
  </Section>
  
  <Footer />
  
</Layout>

<style>
  .animate-wave {
    display: inline-block;
    transform-origin: 70% 70%;
    animation: wave 2.5s infinite;
  }

  @keyframes wave {
    0% { transform: rotate(0deg); }
    10% { transform: rotate(14deg); }
    20% { transform: rotate(-8deg); }
    30% { transform: rotate(14deg); }
    40% { transform: rotate(-4deg); }
    50% { transform: rotate(10deg); }
    60% { transform: rotate(0deg); }
    100% { transform: rotate(0deg); }
  }
  
  /* Background container styles */
  #background-container {
    position: fixed;
    inset: 0;
    z-index: -20;
    overflow: hidden;
  }
  
  /* Removing all radial gradient light effects */
  
  /* Hover animation for name */
  .hover-animated {
    position: relative;
    display: inline-block;
    transition: all 0.3s ease;
  }
  
  .hover-animated::after {
    content: '';
    position: absolute;
    width: 100%;
    transform: scaleX(0);
    height: 3px;
    bottom: 0;
    left: 0;
    background: linear-gradient(90deg, rgba(129, 140, 248, 1), rgba(168, 85, 247, 1));
    transform-origin: bottom right;
    transition: transform 0.3s ease-out;
  }
  
  .hover-animated:hover {
    transform: translateY(-2px);
    text-shadow: 0 0 8px rgba(139, 92, 246, 0.5);
  }
  
  .hover-animated:hover::after {
    transform: scaleX(1);
    transform-origin: bottom left;
  }
  
  .skills-carousel-container {
    max-width: 100%;
    padding: 1rem 0;
  }
  
  .skills-carousel {
    position: relative;
    padding: 0.5rem;
    overflow: visible;
  }
  
  .skills-carousel-track {
    display: flex;
    transition: transform 0.5s ease-in-out;
  }
  
  .skills-carousel-slide {
    width: 100%;
    flex-shrink: 0;
    padding: 0.5rem;
  }
  
  .skills-nav-button.active {
    background-color: rgba(99, 102, 241, 0.8);
    color: white;
    font-weight: 500;
  }
  
  .skills-nav-button:not(.active) {
    color: #d1d5db;
    background-color: transparent;
  }
  
  .skills-nav-button:hover:not(.active) {
    background-color: rgba(75, 85, 99, 0.5);
  }
  
  /* Moon profile styling */
  .moon-profile {
    position: relative;
    z-index: 1;
    transition: transform 0.3s ease-out;
  }
  
  .moon-profile:hover {
    transform: scale(1.03);
  }
  
  .moon-image {
    position: relative;
    z-index: 2;
    
    box-shadow: 
      inset 0 0 15px #e6e6ee,
      inset 20px 0 30px #b8b8dd,
      inset -20px 0 30px #c5c5d5,
      inset 20px 0 120px rgba(184, 184, 221, 0.5),
      inset -20px 0 120px rgba(197, 197, 213, 0.5),
      0 0 15px rgba(230, 230, 238, 0.3),
      0 0 20px rgba(170, 170, 170, 0.2);
    transition: all 0.5s ease;
  }
  
  .moon-glow {
    z-index: 1;
    opacity: 0.15;
    background: radial-gradient(circle, 
      rgba(210, 210, 235, 0.35) 0%, 
      rgba(200, 200, 225, 0.3) 15%,
      rgba(190, 190, 220, 0.25) 25%,
      rgba(180, 180, 210, 0.2) 35%, 
      rgba(160, 160, 200, 0.15) 50%,
      rgba(140, 140, 190, 0.1) 65%, 
      rgba(120, 120, 180, 0.07) 75%,
      rgba(100, 100, 150, 0.03) 85%,
      rgba(90, 90, 140, 0.01) 100%);
    filter: blur(25px);
    transform: scale(1.2);
    animation: moon-pulse 10s ease-in-out infinite alternate;
  }
  
  .moon-profile:hover .moon-image {
    filter: grayscale(5%) brightness(1.03) contrast(1.08);
    box-shadow: 
      inset 0 0 20px #e6e6ee,
      inset 20px 0 35px #b8b8dd,
      inset -20px 0 35px #c5c5d5,
      inset 20px 0 140px rgba(184, 184, 221, 0.6),
      inset -20px 0 140px rgba(197, 197, 213, 0.6),
      0 0 15px rgba(230, 230, 238, 0.4),
      0 0 20px rgba(170, 170, 170, 0.3);
  }
  
  .moon-profile:hover .moon-glow {
    opacity: 0.2;
    filter: blur(22px);
