---
import BaseLayout from "../layouts/BaseLayout.astro";
import TopologyHero from "../components/TopologyHero.astro";
import LogoStrip from "../components/LogoStrip.astro";
import Capabilities from "../components/Capabilities.astro";
import Projects from "../components/Projects.astro";
import StackInventory from "../components/StackInventory.astro";
import DeployTimeline from "../components/DeployTimeline.astro";
import Certifications from "../components/Certifications.astro";
import ContactPanel from "../components/ContactPanel.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="Malin Malliya Wadu - Senior Full-Stack Engineer & Technical Lead">
  <div class="shell page">
    <TopologyHero />
    <LogoStrip />
    <Capabilities />
    <Projects />
    <StackInventory />
    <DeployTimeline />
    <Certifications />
    <ContactPanel />
    <Footer />
  </div>
</BaseLayout>

<style>
  .page {
    padding-bottom: 1rem;
  }
</style>

<script>
  import "../scripts/reveal.ts";
</script>
