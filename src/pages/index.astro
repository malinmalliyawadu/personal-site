    box-shadow: 0 0 15px rgba(99, 102, 241, 0.2);
  }
  
  .scroll-indicator {
    animation: fadeInUp 2s ease 1s forwards;
    opacity: 0;
  }
  
  @keyframes fadeInUp {
    from { opacity: 0; transform: translate(-50%, 20px); }
    to { opacity: 1; transform: translate(-50%, 0); }
  }
  
  .hero-title, .hero-tagline, .hero-cta, .hero-skills {
    animation: slideUp 0.8s ease-out forwards;
    opacity: 0;
    transform: translateY(20px);
  }
  
  .hero-title {
    animation-delay: 0.2s;
  }
  
  .hero-tagline {
    animation-delay: 0.4s;
  }
  
  .hero-cta {
    animation-delay: 0.6s;
  }
  
  .hero-skills {
    animation-delay: 0.8s;
  }
  
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  /* Enhanced scroll animations */
  .animate-on-scroll {
    opacity: 0;
    transform: translateY(50px);
    transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .animate-on-scroll.visible {
    opacity: 1;
    transform: translateY(0);
  }
  
  /* Enhanced orbital rings */
  .orbital-ring {
    animation: orbit 20s linear infinite;
    opacity: 0.3;
  }
  
  .orbital-ring-1 {
    animation-duration: 15s;
    animation-direction: normal;
  }
  
  .orbital-ring-2 {
    animation-duration: 25s;
    animation-direction: reverse;
  }
  
  @keyframes orbit {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  
  /* Enhanced gradient backgrounds */
  .gradient-bg {
    background: linear-gradient(
      135deg,
      rgba(147, 51, 234, 0.1) 0%,
      rgba(79, 70, 229, 0.05) 25%,
      rgba(236, 72, 153, 0.1) 50%,
      rgba(245, 101, 101, 0.05) 75%,
      rgba(251, 191, 36, 0.1) 100%
    );
    animation: gradientShift 10s ease-in-out infinite;
  }
  
  @keyframes gradientShift {
    0%, 100% { filter: hue-rotate(0deg) brightness(1); }
    50% { filter: hue-rotate(30deg) brightness(1.1); }
  }
  
  /* Mobile optimizations */
  @media (max-width: 768px) {
    .hero-title {
      font-size: 3.5rem;
      line-height: 1.1;
    }
    
    .hero-tagline {
      font-size: 1.125rem;
      margin-bottom: 2rem;
    }
    
    .about-card {
      padding: 1.5rem;
    }
    
    .btn-primary, .btn-secondary {
      width: 100%;
      justify-content: center;
    }
  }
  
  /* Improved focus states for accessibility */
  .btn-primary:focus,
  .btn-secondary:focus,
  .card-button:focus {
    outline: 2px solid rgba(147, 51, 234, 0.8);
    outline-offset: 2px;
  }
</style>

<script>
  // Initialize carousel
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.querySelector('.skills-carousel-track') as HTMLElement;
    const slides = document.querySelectorAll('.skills-carousel-slide');
    const navButtons = document.querySelectorAll('.skills-nav-button');
    const skillsSection = document.querySelector('#skills');
    const carouselContainer = document.querySelector('.skills-carousel-container');
    
    let currentIndex = 0;
    let interval: ReturnType<typeof setInterval> | undefined;
    let isAutoPlaying = true;
    const slidesCount = slides.length;
    
    // Set up initial state
    function updateCarousel() {
      // Update track position
      if (track) {
        track.style.transform = `translateX(-${currentIndex * 100}%)`;
      }
      
      // Update active nav button
      navButtons.forEach((button, index) => {
        if (index === currentIndex) {
          button.classList.add('active');
        } else {
          button.classList.remove('active');
        }
      });
    }
    
    // Start auto-rotation
    function startAutoPlay() {
      if (interval) clearInterval(interval);
      
      interval = setInterval(() => {
        if (isAutoPlaying) {
          currentIndex = (currentIndex + 1) % slidesCount;
          updateCarousel();
        }
      }, 5000); // Change slide every 5 seconds
    }
    
    // Pause auto-scrolling
    function pauseAutoPlay() {
      isAutoPlaying = false;
    }
    
    // Resume auto-scrolling
    function resumeAutoPlay() {
      if (!interval) {
        startAutoPlay();
      }
      isAutoPlaying = true;
    }
    
    // Permanently stop auto-scrolling
    function stopAutoPlay() {
      isAutoPlaying = false;
      if (interval) {
        clearInterval(interval);
        interval = undefined;
      }
    }
    
    // Event handlers
    function handleNavButtonClick(e: Event) {
      e.preventDefault();
      const clickedIndex = parseInt((e.currentTarget as HTMLElement).dataset.index || '0', 10);
      if (!isNaN(clickedIndex)) {
        currentIndex = clickedIndex;
        updateCarousel();
        stopAutoPlay();
      }
    }
    
    // Attach event listeners to nav buttons
    navButtons.forEach(button => {
      button.addEventListener('click', handleNavButtonClick);
    });
    
    // Add click event to the entire skills section to stop auto-scrolling
    if (skillsSection) {
      skillsSection.addEventListener('click', stopAutoPlay);
    }
    
    // Add hover events to pause/resume auto-scrolling
    if (carouselContainer) {
      carouselContainer.addEventListener('mouseenter', pauseAutoPlay);
      carouselContainer.addEventListener('mouseleave', resumeAutoPlay);
    }
    
    // Initialize
    updateCarousel();
    startAutoPlay();
    
    // Set first nav button as active initially
    if (navButtons.length > 0) {
      navButtons[0].classList.add('active');
    }
  });

  // Add click handler to profile image to add more stars or clouds
  document.addEventListener('DOMContentLoaded', () => {
    const profileImage = document.getElementById('profile-image');
    if (profileImage) {
      let clickCount = 0;
      
      profileImage.addEventListener('click', () => {
        const isLightMode = document.documentElement.classList.contains('light');
        
        if (isLightMode) {
          // Light mode - add clouds
          if (typeof window.addMoreClouds === 'function') {
            clickCount++;
            const cloudsToAdd = 3 + Math.floor(clickCount * 1.5); // Start with 3, gradually increase
            window.addMoreClouds(cloudsToAdd);
            
            // Reset count if it gets too high
            if (clickCount >= 8) {
              clickCount = 0;
            }
          }
        } else {
          // Dark mode - add stars
          if (typeof window.addMoreStars === 'function') {
            clickCount++;
            const starsToAdd = 100 + (clickCount * 50);
            window.addMoreStars(starsToAdd);
            
            // Reset count if it gets too high
            if (clickCount >= 10) {
              clickCount = 0;
            }
          }
        }
      });
    }
  });
  
  // Enhanced scroll animations
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -100px 0px'
  };
  
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, observerOptions);
  
  // Observe all animated elements
  document.querySelectorAll('.animate-on-scroll').forEach(el => {
    observer.observe(el);
  });
</script>

