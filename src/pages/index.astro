---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Background from "../components/Background.astro";
import Section from "../components/Section.astro";
import SkillIcon from "../components/SkillIcon.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Footer from "../components/Footer.astro";

import profilePic from "../images/profile.jpg";
import resume from "../pdfs/resume.pdf";

// Skill icons are typically stored in public/icons/ folder - you'll need to add these
const skills = [
  { name: ".NET", icon: "/icons/dotnet.svg" },
  { name: "TypeScript", icon: "/icons/typescript.svg" },
  { name: "React", icon: "/icons/react.svg" },
  { name: "AWS", icon: "/icons/aws.svg" },
  { name: "Node.js", icon: "/icons/nodejs.svg" },
  { name: "Astro", icon: "/icons/astro.svg" },
  { name: "Azure", icon: "/icons/azure.svg" },
  { name: "Tailwind CSS", icon: "/icons/tailwindcss.svg" },
  { name: "GitHub", icon: "/icons/github.svg" },
  { name: "Docker", icon: "/icons/docker.svg" },
  { name: "CI/CD", icon: "/icons/cicd.svg" },
];

// Projects from your GitHub
const projects = [
  {
    title: "FlakeManager",
    description: "Automated flaky test management for Cypress test suites. Helps identify and manage inconsistent tests.",
    tags: ["TypeScript", "Cypress", "Testing", "Automation"],
    github: "https://github.com/malinmalliyawadu/FlakeManager",
    image: undefined,
    demo: undefined
  },
  {
    title: "CapDevReporter",
    description: "Automated time tracking with Jira integration. Simplifies project time management.",
    tags: ["TypeScript", "Jira API", "Time Tracking", "Reporting"],
    github: "https://github.com/malinmalliyawadu/CapDevReporter",
    image: undefined,
    demo: undefined
  },
  {
    title: "Sally",
    description: "Mobile app for van life in Aotearoa, New Zealand. Helps travelers find camping spots and essentials.",
    tags: ["TypeScript", "Mobile", "Maps", "Travel"],
    github: "https://github.com/malinmalliyawadu/Sally",
    image: undefined,
    demo: undefined
  },
  {
    title: "Import Map Devtools",
    description: "Browser devtools for import maps. Makes working with modern JavaScript imports easier.",
    tags: ["TypeScript", "Browser Extension", "Developer Tools"],
    github: "https://github.com/malinmalliyawadu/import-map-devtools",
    image: undefined,
    demo: undefined
  }
];
---

<Layout title="Malin Malliya Wadu | Full-stack Developer">
  <Background />
  <Navbar />

  <!-- Hero Section -->
  <section id="hero" class="min-h-screen pt-32 md:pt-0 flex items-center relative">
    <div class="container mx-auto px-4">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-12">
        <div class="md:w-1/2">
          <div class="inline-block mb-2 px-3 py-1 bg-indigo-900/30 border border-indigo-800/50 rounded-full text-sm font-medium text-indigo-300">
            Full-stack Developer
          </div>
          <h1 class="text-4xl md:text-6xl font-black mb-6">
            Hi, I'm <span class="bg-gradient-to-r from-indigo-400 to-purple-500 bg-clip-text text-transparent">Malin</span>
            <div class="inline-block animate-wave">👋</div>
          </h1>
          <p class="text-xl md:text-2xl text-gray-300 mb-8 leading-relaxed">
            A full-stack developer from Wellington, NZ specializing in building beautiful, performant, and accessible web experiences.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a 
              href="#projects" 
              class="inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors"
            >
              View Projects
            </a>
            <a 
              href={resume} 
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center px-6 py-3 border border-gray-300 text-base font-medium rounded-md shadow-sm text-white bg-gray-800 hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors"
            >
              Resume
            </a>
          </div>
        </div>
        <div class="md:w-1/2 flex justify-center">
          <div class="relative">
            <div class="absolute inset-0 bg-gradient-to-r from-indigo-600 to-purple-600 rounded-full blur-3xl opacity-20 animate-pulse"></div>
            <img
              src={profilePic.src}
              alt="Malin Malliya Wadu"
              class="relative rounded-full w-64 h-64 md:w-80 md:h-80 object-cover border-4 border-gray-800 shadow-2xl"
            />
          </div>
        </div>
      </div>
      
      <div class="absolute bottom-10 left-1/2 transform -translate-x-1/2 hidden md:block animate-bounce">
        <a href="#about" class="text-gray-400 hover:text-white transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </a>
      </div>
    </div>
  </section>
  
  <!-- About Section -->
  <Section
    id="about"
    title="About Me"
    subtitle="Learn more about my background and what drives me"
  >
    <div class="max-w-4xl mx-auto">
      <div class="bg-gray-800 bg-opacity-50 rounded-xl p-8 backdrop-blur-sm border border-gray-700">
        <p class="text-lg mb-4 leading-relaxed">
          I'm a full-stack developer with expertise in .NET, TypeScript, React, and AWS.
          I specialize in Continuous Delivery, DevOps, and Cloud-first development, focusing
          on creating clean, efficient, and scalable solutions.
        </p>
        <p class="text-lg mb-4 leading-relaxed">
          With a passion for cutting-edge technologies, I'm currently exploring Expo, Remix, and
          Prisma to expand my toolkit and stay ahead of industry trends.
        </p>
        <p class="text-lg leading-relaxed">
          When I'm not coding, I enjoy cooking 👨‍🍳, traveling the world 🌏, going to the gym 💪,
          and taking care of my plant collection 👨‍🌾.
        </p>
      </div>
    </div>
  </Section>
  
  <!-- Skills Section -->
  <Section
    id="skills"
    title="Skills & Technologies"
    subtitle="The tools and technologies I work with"
  >
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4">
      {skills.map((skill) => (
        <SkillIcon name={skill.name} icon={skill.icon} />
      ))}
    </div>
  </Section>
  
  <!-- Projects Section -->
  <Section
    id="projects"
    title="Projects"
    subtitle="Check out some of my recent work"
  >
    <div class="grid md:grid-cols-2 gap-8">
      {projects.map((project) => (
        <ProjectCard
          title={project.title}
          description={project.description}
          tags={project.tags}
          image={project.image}
          github={project.github}
          demo={project.demo}
        />
      ))}
    </div>
  </Section>
  
  <!-- Contact Section -->
  <Section
    id="contact"
    title="Get In Touch"
    subtitle="Interested in working together? Let's connect!"
  >
    <div class="max-w-lg mx-auto">
      <div class="bg-gray-800 bg-opacity-50 rounded-xl p-8 backdrop-blur-sm border border-gray-700 text-center">
        <p class="text-lg mb-8">
          I'm currently available for freelance and contract opportunities. Feel free to reach out if you're looking for a developer to help bring your ideas to life!
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="mailto:malin.malliya.wadu@gmail.com"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 border border-transparent text-base font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
              <rect x="3" y="5" width="18" height="14" rx="2"></rect>
              <polyline points="3 7 12 13 21 7"></polyline>
            </svg>
            Email Me
          </a>
          <a
            href="https://www.linkedin.com/in/malin-malliya-wadu-94956522/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 border border-gray-300 text-base font-medium rounded-md shadow-sm text-white bg-gray-800 hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 118.3 6.5a1.78 1.78 0 01-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0013 14.19V19h-3v-9h2.9v1.3a3.11 3.11 0 012.7-1.4c1.55 0 3.36.86 3.36 3.66z"></path>
            </svg>
            LinkedIn
          </a>
        </div>
      </div>
    </div>
  </Section>
  
  <Footer />
  
</Layout>

<style>
  .animate-wave {
    display: inline-block;
    transform-origin: 70% 70%;
    animation: wave 2.5s infinite;
  }

  @keyframes wave {
    0% { transform: rotate(0deg); }
    10% { transform: rotate(14deg); }
    20% { transform: rotate(-8deg); }
    30% { transform: rotate(14deg); }
    40% { transform: rotate(-4deg); }
    50% { transform: rotate(10deg); }
    60% { transform: rotate(0deg); }
    100% { transform: rotate(0deg); }
  }
</style>
