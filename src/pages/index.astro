---

<Layout title="Malin Malliya Wadu | Full-stack Developer">
  <Navbar />

  <!-- Hero Section -->
  <section id="hero" class="min-h-screen flex flex-col justify-center relative pt-24 pb-16 md:pt-20 md:pb-28">
    <div class="mx-auto max-w-6xl px-5 md:px-8 w-full">
      <div class="grid md:grid-cols-12 gap-10 md:gap-12 items-center">
        <div class="md:col-span-7">
          <p class="hero-reveal hero-reveal-1 font-mono text-[0.7rem] md:text-xs font-medium tracking-[0.3em] uppercase text-accent mb-6">
            Full-stack developer — Wellington, NZ
          </p>

          <h1 class="hero-reveal hero-reveal-2 font-display font-semibold text-ink tracking-tight leading-[0.95] text-[clamp(3.25rem,7vw,6rem)] mb-8">
            Malin<br />
            <em class="italic text-accent">Malliya Wadu</em>
          </h1>

          <p class="hero-reveal hero-reveal-3 text-lg md:text-xl text-ink-soft leading-relaxed max-w-xl mb-8">
            Fifteen-plus years building <em class="font-display italic text-ink">beautiful</em>,
            <em class="font-display italic text-ink">performant</em>, and
            <em class="font-display italic text-ink">accessible</em> digital experiences —
            from open banking APIs to volunteer platforms feeding communities across Aotearoa.
          </p>

          <div class="hero-reveal hero-reveal-4 flex flex-col sm:flex-row gap-3 md:gap-4 mb-10">
            <a href="#projects" class="btn-primary">
              View my work
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </a>
            <a
              href="/cv/Malin_CV.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary"
            >
              Download CV
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>

          <p class="hero-reveal hero-reveal-5 font-mono text-[0.65rem] tracking-[0.15em] uppercase text-ink-faint border-t border-line pt-4">
            .NET&ensp;·&ensp;TypeScript&ensp;·&ensp;React&ensp;·&ensp;AWS&ensp;—&ensp;Available for contract work
          </p>
        </div>

        <div class="md:col-span-5 flex md:justify-end">
          <figure class="hero-reveal hero-reveal-3 hero-photo">
            <Image
              src={profilePic}
              alt="Malin Malliya Wadu"
              width={384}
              height={384}
              class="hero-photo-img"
              loading="eager"
            />
            <figcaption class="font-mono text-[0.6rem] tracking-[0.2em] uppercase text-ink-faint pt-3">
              Fig. 01
            </figcaption>
          </figure>
        </div>
      </div>
    </div>

    <a href="#about" class="hero-scroll-cue hidden md:flex absolute bottom-8 left-1/2 -translate-x-1/2 flex-col items-center gap-2 font-mono text-[0.6rem] tracking-[0.3em] uppercase text-ink-faint hover:text-accent transition-colors">
      <span>Scroll</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </a>
  </section>

  <!-- About Section -->
  <Section
    id="about"
    index="01"
    title="About"
    subtitle="Passionate about creating impactful digital experiences"
  >
    <div class="grid md:grid-cols-12 gap-10 animate-on-scroll">
      <div class="md:col-span-8">
        <p class="font-display text-2xl md:text-3xl leading-snug text-ink mb-8">
          With <span class="text-accent">15+ years of professional experience</span>,
          I'm a full-stack developer with expertise in
          <a href="#skills" class="text-link">.NET</a>,
          <a href="#skills" class="text-link">TypeScript</a>,
          <a href="#skills" class="text-link">React</a>, and
          <a href="#skills" class="text-link">AWS</a>.
        </p>
        <p class="text-lg text-ink-soft leading-relaxed max-w-2xl">
          I have a passion for bleeding-edge technologies and automation — consistently exploring
          ways to streamline development workflows and implement intelligent CI/CD pipelines.
          My approach combines <em class="font-display italic text-ink">technical excellence</em> with a focus on
          <em class="font-display italic text-ink">delivering business value</em> through robust, maintainable code
          and scalable architecture.
        </p>
      </div>

      <div class="md:col-span-4 md:border-l md:border-line md:pl-10">
        <p class="font-mono text-[0.7rem] font-medium tracking-[0.25em] uppercase text-ink-faint mb-5">Beyond the keyboard</p>
        <ul class="flex flex-wrap gap-2">
          {interests.map((interest) => (
            <li>
              <button type="button" class="hobby-emoji" data-label={interest.label} aria-label={interest.label}>
                {interest.emoji}
              </button>
            </li>
          ))}
        </ul>
        <p class="hobby-caption font-display italic text-base text-ink-faint mt-5" id="hobby-caption" aria-hidden="true">
          Hover for the full story —
        </p>
      </div>
    </div>
  </Section>

  <!-- Work Experience Section -->
  <Section
    id="experience"
    index="02"
    title="Experience"
    subtitle="My professional journey in the tech industry"
  >
    <WorkExperience jobs={jobHistory} />
  </Section>

  <!-- Skills Section -->
  <Section
    id="skills"
    index="03"
    title="Skills"
    subtitle="The tools and technologies I work with"
  >
    <div class="border-y border-line divide-y divide-line animate-on-scroll">
      {skillCategories.map((category) => (
        <div class="grid md:grid-cols-12 gap-3 md:gap-8 py-6">
          <h3 class="md:col-span-3 font-mono text-[0.7rem] font-medium tracking-[0.2em] uppercase text-ink-faint md:pt-2.5">
            {category.name}
          </h3>
          <ul class="md:col-span-9 flex flex-wrap gap-2">
            {category.skills.map((skill) => (
              <SkillIcon name={skill.name} icon={skill.icon} />
            ))}
          </ul>
        </div>
      ))}
    </div>
  </Section>

  <!-- Certifications Section -->
  <Section
    id="certifications"
    index="04"
    title="Certifications"
    subtitle="Professional certifications and achievements"
  >
    <div class="grid md:grid-cols-2 gap-4 animate-on-scroll">
      {certifications.map((cert) => (
        <CertificationCard
          title={cert.title}
          issuer={cert.issuer}
          issueDate={cert.issueDate}
          expiryDate={cert.expiryDate}
          image={cert.image}
          link={cert.link}
        />
      ))}
    </div>
    <div class="mt-10">
      <a
        href="https://www.credly.com/users/malin-malliya-wadu"
        target="_blank"
        rel="noopener noreferrer"
        class="text-link font-mono text-[0.7rem] font-medium tracking-[0.12em] uppercase"
      >
        View all my certifications on Credly ↗
      </a>
    </div>
  </Section>

  <!-- Projects Section -->
  <Section
    id="projects"
    index="05"
    title="Selected work"
    subtitle="Projects built for communities and cities"
  >
    <div class="flex flex-col">
      {projects.map((project, index) => (
        <div class="animate-on-scroll">
          <ProjectCard
            title={project.title}
            description={project.description}
            image={project.image}
            images={project.images}
            phoneImage={project.phoneImage}
            phoneImageAlt={project.phoneImageAlt}
            github={project.github}
            demo={project.demo}
            appStore={project.appStore}
            playStore={project.playStore}
            stats={project.stats}
            wip={project.wip}
            index={index}
          />
        </div>
      ))}
    </div>
    <div class="mt-4 pt-10 border-t border-line animate-on-scroll">
      <a
        href="https://github.com/malinmalliyawadu"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-secondary"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
          <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"></path>
        </svg>
        See all projects on GitHub
      </a>
    </div>
  </Section>

  <!-- Contact Section -->
  <section id="contact" class="py-24 md:py-36 border-t border-line">
    <div class="mx-auto max-w-6xl px-5 md:px-8">
      <div class="animate-on-scroll">
        <p class="font-mono text-[0.7rem] font-medium tracking-[0.25em] uppercase mb-5">
          <span class="text-accent">06</span>
          <span class="text-ink-faint"> / Get in touch</span>
        </p>

        <h2 class="font-display text-5xl md:text-7xl font-semibold tracking-tight text-ink leading-[1.02] mb-6">
          Let's build something<br />
          <em class="italic text-accent">together.</em>
        </h2>

        <p class="text-lg text-ink-soft leading-relaxed max-w-lg mb-12">
          Currently available for freelance projects and exciting opportunities.
          Drop me a line and let's talk.
        </p>

        <a
          href="mailto:malin.malliya.wadu@gmail.com"
          class="contact-email font-display text-xl sm:text-2xl md:text-4xl text-ink inline-block mb-12 break-all sm:break-normal"
        >
          malin.malliya.wadu@gmail.com
        </a>

        <div class="flex items-center gap-8 font-mono text-[0.7rem] font-medium tracking-[0.15em] uppercase">
          <a
            href="https://www.linkedin.com/in/malin-malliya-wadu-94956522/"
            target="_blank"
            rel="noopener noreferrer"
            class="contact-social"
          >
            LinkedIn<span class="contact-social-arrow">↗</span>
          </a>
          <a
            href="https://github.com/malinmalliyawadu"
            target="_blank"
            rel="noopener noreferrer"
            class="contact-social"
          >
            GitHub<span class="contact-social-arrow">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer />

</Layout>

<style>
  /* ——— Hero ——— */
  .hero-reveal {
    animation: heroReveal 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    opacity: 0;
    transform: translateY(24px);
  }

  .hero-reveal-1 { animation-delay: 0.1s; }
  .hero-reveal-2 { animation-delay: 0.2s; }
  .hero-reveal-3 { animation-delay: 0.35s; }
  .hero-reveal-4 { animation-delay: 0.5s; }
  .hero-reveal-5 { animation-delay: 0.65s; }

  @keyframes heroReveal {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-photo {
    background: var(--paper-raised);
    border: 1px solid var(--line);
    padding: 0.75rem 0.75rem 0.5rem;
    max-width: 18rem;
  }

  @media (min-width: 768px) {
    .hero-photo {
      max-width: 22rem;
    }
  }

  .hero-photo-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    filter: saturate(0.92) contrast(1.02);
    transition: filter 0.4s ease;
  }

  .hero-photo:hover .hero-photo-img {
    filter: saturate(1.05) contrast(1.04);
  }

  .hero-scroll-cue {
    animation: heroReveal 0.8s ease 1.1s forwards;
    opacity: 0;
  }

  .hero-scroll-cue svg {
    animation: scrollNudge 2.2s ease-in-out infinite;
  }

  @keyframes scrollNudge {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }

  /* ——— About ——— */
  .hobby-emoji {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    font-size: 1.35rem;
    border: 1px solid var(--line);
    background: var(--paper-raised);
    cursor: default;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .hobby-emoji:hover,
  .hobby-emoji:focus-visible {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .hobby-caption {
    min-height: 1.75rem;
    transition: color 0.2s ease;
  }

  .hobby-caption.active {
    color: var(--ink);
  }

  /* ——— Contact ——— */
  .contact-email {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 8px;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .contact-email:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .contact-social {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--ink-soft);
    padding-bottom: 0.2rem;
    border-bottom: 1px solid var(--line-strong);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .contact-social:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .contact-social-arrow {
    font-family: "Archivo", sans-serif;
    transition: transform 0.2s ease;
  }

  .contact-social:hover .contact-social-arrow {
    transform: translate(2px, -2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-reveal,
    .hero-scroll-cue {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  // Scroll-triggered reveals
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      }
    });
  }, {
    threshold: 0.1,
    rootMargin: '0px 0px -80px 0px'
  });

  document.querySelectorAll('.animate-on-scroll').forEach(el => {
    observer.observe(el);
  });

  // Hobby emoji reveals
  const hobbyCaption = document.getElementById('hobby-caption');
  const hobbyDefault = hobbyCaption?.textContent ?? '';
  document.querySelectorAll<HTMLElement>('.hobby-emoji').forEach(el => {
    const show = () => {
      if (!hobbyCaption) return;
      hobbyCaption.textContent = `${el.dataset.label} —`;
      hobbyCaption.classList.add('active');
    };
    const hide = () => {
      if (!hobbyCaption) return;
      hobbyCaption.textContent = hobbyDefault;
      hobbyCaption.classList.remove('active');
    };
    el.addEventListener('mouseenter', show);
    el.addEventListener('mouseleave', hide);
    el.addEventListener('focus', show);
    el.addEventListener('blur', hide);
  });
</script>
