<style>
  .animate-wave {
    display: inline-block;
    transform-origin: 70% 70%;
    animation: wave 2.5s infinite;
  }

  @keyframes wave {
    0% { transform: rotate(0deg); }
    10% { transform: rotate(14deg); }
    20% { transform: rotate(-8deg); }
    30% { transform: rotate(14deg); }
    40% { transform: rotate(-4deg); }
    50% { transform: rotate(10deg); }
    60% { transform: rotate(0deg); }
    100% { transform: rotate(0deg); }
  }
  
  /* Hover animation for name */
  .hover-animated {
    position: relative;
    display: inline-block;
    transition: all 0.3s ease;
  }
  
  .hover-animated::after {
    content: '';
    position: absolute;
    width: 100%;
    transform: scaleX(0);
    height: 3px;
    bottom: 0;
    left: 0;
    background: linear-gradient(90deg, rgba(129, 140, 248, 1), rgba(168, 85, 247, 1));
    transform-origin: bottom right;
    transition: transform 0.3s ease-out;
  }
  
  .hover-animated:hover {
    transform: translateY(-2px);
    text-shadow: 0 0 8px rgba(139, 92, 246, 0.5);
  }
  
  .hover-animated:hover::after {
    transform: scaleX(1);
    transform-origin: bottom left;
  }
  
  .skills-carousel-container {
    max-width: 100%;
    overflow: hidden;
    padding: 1rem 0;
  }
  
  .skills-carousel {
    position: relative;
    padding: 0.5rem;
    overflow: visible;
  }
  
  .skills-carousel-track {
    display: flex;
    transition: transform 0.5s ease-in-out;
  }
  
  .skills-carousel-slide {
    width: 100%;
    flex-shrink: 0;
    padding: 0.5rem;
  }
  
  .skills-nav-button.active {
    background-color: rgba(99, 102, 241, 0.8);
    color: white;
    font-weight: 500;
  }
  
  .skills-nav-button:not(.active) {
    color: #d1d5db;
    background-color: transparent;
  }
  
  .skills-nav-button:hover:not(.active) {
    background-color: rgba(75, 85, 99, 0.5);
  }
  
  /* Profile image styling */
  .profile-image-container {
    position: relative;
    width: 16rem;
    height: 16rem;
    border-radius: 50%;
    overflow: visible;
    filter: drop-shadow(0 0 25px rgba(99, 102, 241, 0.3));
    transition: transform 0.3s ease-out;
  }

  .profile-image-container:hover {
    transform: scale(1.03);
    filter: drop-shadow(0 0 30px rgba(99, 102, 241, 0.4));
  }

  @media (min-width: 768px) {
    .profile-image-container {
      width: 24rem;
      height: 24rem;
    }
  }
  
  .profile-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 4px solid rgba(99, 102, 241, 0.3);
    position: relative;
    z-index: 1;
    box-shadow: 
      0 10px 25px -5px rgba(0, 0, 0, 0.3),
      0 0 0 1px rgba(99, 102, 241, 0.2);
    transition: all 0.3s ease;
  }
  
  .profile-image-container:hover .profile-image {
    border-color: rgba(139, 92, 246, 0.5);
    box-shadow: 
      0 15px 30px -5px rgba(0, 0, 0, 0.3),
      0 0 0 2px rgba(139, 92, 246, 0.3);
  }
  
  .profile-image-glow {
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    background: conic-gradient(
      from 180deg at 50% 50%,
      rgba(99, 102, 241, 0.8) 0deg,
      rgba(168, 85, 247, 0.8) 72deg,
      rgba(139, 92, 246, 0.8) 144deg,
      rgba(124, 58, 237, 0.8) 216deg,
      rgba(99, 102, 241, 0.8) 288deg,
      rgba(99, 102, 241, 0.8) 360deg
    );
    filter: blur(20px);
    z-index: 0;
    opacity: 0.6;
    animation: pulse 8s ease-in-out infinite alternate, rotate 12s linear infinite;
    mix-blend-mode: overlay;
  }
  
  .profile-image-accent {
    position: absolute;
    width: 40px;
    height: 40px;
    background-color: #6366f1;
    border-radius: 50%;
    bottom: 15%;
    right: 0;
    z-index: 2;
    box-shadow: 0 0 20px rgba(99, 102, 241, 0.6);
    opacity: 0.9;
    transform: translateX(50%);
    transition: all 0.3s ease;
  }
  
  .profile-image-container:hover .profile-image-accent {
    background-color: #8b5cf6;
    transform: translateX(50%) scale(1.1);
  }
  
  @keyframes pulse {
    0% {
      opacity: 0.4;
      transform: scale(0.97);
    }
    100% {
      opacity: 0.7;
      transform: scale(1.03);
    }
  }
  
  @keyframes rotate {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
  
  /* Don't delete this - may be used elsewhere */
  .text-reveal:not(.aurora-text) {
    position: relative;
    display: inline-block;
    color: #818cf8;
    overflow: hidden;
    background: linear-gradient(90deg, #818cf8, #a855f7);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  
  .text-reveal:not(.aurora-text)::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
    background: #111827;
    animation: showRight 1s ease forwards;
    animation-delay: 0.5s;
  }
  
  @keyframes showRight {
    0% {
      width: 100%;
    }
    100% {
      width: 0;
    }
  }
</style>

<script>
  // Initialize carousel
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.querySelector('.skills-carousel-track') as HTMLElement;
    const slides = document.querySelectorAll('.skills-carousel-slide');
    const navButtons = document.querySelectorAll('.skills-nav-button');
    const skillsSection = document.querySelector('#skills');
    const carouselContainer = document.querySelector('.skills-carousel-container');
    
    let currentIndex = 0;
    let interval: ReturnType<typeof setInterval> | undefined;
    let isAutoPlaying = true;
    const slidesCount = slides.length;
    
    // Set up initial state
    function updateCarousel() {
      // Update track position
      if (track) {
        track.style.transform = `translateX(-${currentIndex * 100}%)`;
      }
      
      // Update active nav button
      navButtons.forEach((button, index) => {
        if (index === currentIndex) {
          button.classList.add('active');
        } else {
          button.classList.remove('active');
        }
      });
    }
    
    // Start auto-rotation
    function startAutoPlay() {
      if (interval) clearInterval(interval);
      
      interval = setInterval(() => {
        if (isAutoPlaying) {
          currentIndex = (currentIndex + 1) % slidesCount;
          updateCarousel();
        }
      }, 5000); // Change slide every 5 seconds
    }
    
    // Pause auto-scrolling
    function pauseAutoPlay() {
      isAutoPlaying = false;
    }
    
    // Resume auto-scrolling
    function resumeAutoPlay() {
      if (!interval) {
        startAutoPlay();
      }
      isAutoPlaying = true;
    }
    
    // Permanently stop auto-scrolling
    function stopAutoPlay() {
      isAutoPlaying = false;
      if (interval) {
        clearInterval(interval);
        interval = undefined;
      }
    }
    
    // Event handlers
    function handleNavButtonClick(e: Event) {
      e.preventDefault();
      const clickedIndex = parseInt((e.currentTarget as HTMLElement).dataset.index || '0', 10);
      if (!isNaN(clickedIndex)) {
        currentIndex = clickedIndex;
        updateCarousel();
        stopAutoPlay();
      }
    }
    
    // Attach event listeners to nav buttons
    navButtons.forEach(button => {
      button.addEventListener('click', handleNavButtonClick);
    });
    
    // Add click event to the entire skills section to stop auto-scrolling
    if (skillsSection) {
      skillsSection.addEventListener('click', stopAutoPlay);
    }
    
    // Add hover events to pause/resume auto-scrolling
    if (carouselContainer) {
      carouselContainer.addEventListener('mouseenter', pauseAutoPlay);
      carouselContainer.addEventListener('mouseleave', resumeAutoPlay);
    }
    
    // Initialize
    updateCarousel();
    startAutoPlay();
    
    // Set first nav button as active initially
    if (navButtons.length > 0) {
      navButtons[0].classList.add('active');
    }
  });
</script>

