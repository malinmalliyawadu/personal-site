const projects = [
  {
    title: "FlakeManager",
    description: "Automated flaky test management for Cypress test suites. Helps identify and manage inconsistent tests.",
    tags: ["TypeScript", "Cypress", "Testing", "Automation"],
    github: "https://github.com/malinmalliyawadu/FlakeManager",
    image: undefined,
    demo: undefined
  },
  {
    title: "CapDevReporter",
    description: "Automated time tracking with Jira integration. Simplifies project time management.",
    tags: ["TypeScript", "Jira API", "Time Tracking", "Reporting"],
    github: "https://github.com/malinmalliyawadu/CapDevReporter",
    image: undefined,
    demo: undefined
  },
  {
    title: "Sally",
    description: "Mobile app for van life in Aotearoa, New Zealand. Helps travelers find camping spots and essentials.",
