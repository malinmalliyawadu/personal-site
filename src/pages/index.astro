---

<Layout title="Malin Malliya Wadu | Full-stack Developer">
  <div id="dark-background">
    <MagicParticles />
  </div>
  <div id="light-background" style="display: none;">
    <SkyBackground />
  </div>
  <Navbar />

  <!-- Hero Section -->
  <section id="hero" class="min-h-screen pt-32 md:pt-0 flex items-center relative overflow-hidden">
    <!-- Enhanced background gradients -->
    <div class="absolute inset-0 bg-gradient-to-br from-purple-900/10 via-blue-900/5 to-indigo-900/10 pointer-events-none"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-purple-900/20 via-transparent to-transparent pointer-events-none"></div>
    
    <div class="container mx-auto px-4 relative z-10">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-12">
        <div class="md:w-1/2">
          <div class="role-pill inline-block mb-6 px-6 py-3 bg-gradient-to-r from-purple-900/30 to-indigo-900/30 border border-purple-500/30 rounded-full text-sm font-semibold text-purple-200 backdrop-blur-md transform hover:scale-105 transition-all duration-300 shadow-2xl hover:shadow-purple-500/25">
            <span class="inline-flex items-center gap-3">
              <span class="status-dot inline-block w-3 h-3 bg-gradient-to-r from-green-400 to-emerald-400 rounded-full shadow-lg shadow-green-400/50 animate-pulse"></span>
              <span class="tracking-wide">Available for Work</span>
            </span>
          </div>
          <h1 class="text-5xl sm:text-6xl md:text-8xl font-black mb-6 leading-tight hero-title">
            <span class="block text-white/90 mb-2">Hi, I'm</span>
            <AuroraText 
              class="font-outfit font-extrabold block" 
              colors={["#667eea", "#764ba2", "#f093fb", "#ff9a9e"]}
              speed={0.8}
            >Malin</AuroraText>
            <span class="inline-block animate-wave text-6xl ml-4">👋</span>
          </h1>
          <p class="text-xl md:text-2xl text-gray-300 mb-10 leading-relaxed max-w-2xl hero-tagline">
            A passionate <span class="bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent font-semibold">full-stack developer</span> from Wellington, NZ specializing in crafting <span class="bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent font-semibold">beautiful</span>, <span class="bg-gradient-to-r from-green-400 to-blue-400 bg-clip-text text-transparent font-semibold">performant</span>, and <span class="bg-gradient-to-r from-pink-400 to-red-400 bg-clip-text text-transparent font-semibold">accessible</span> digital experiences.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 md:gap-8 hero-cta">
            <a 
              href="#projects" 
              class="btn-primary group relative overflow-hidden transform transition-all duration-300"
            >
              <span class="relative z-10 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
                View My Work
              </span>
            </a>
            <a 
              href="/cv/Malin_CV.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary group relative transform transition-all duration-300"
            >
              <span class="relative z-10 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                Download CV
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </span>
            </a>
          </div>
          
        </div>
        <div class="md:w-1/2 flex md:justify-end justify-center">
          <div class="relative moon-profile group">
            <!-- Orbital ring animation -->
            <div class="absolute -inset-10 rounded-full border border-indigo-500/20 orbital-ring orbital-ring-1"></div>
            <div class="absolute -inset-16 rounded-full border border-purple-500/10 orbital-ring orbital-ring-2"></div>
            
            <!-- Enhanced glow effect -->
            <div class="absolute inset-0 bg-gradient-to-r from-indigo-400/20 to-purple-400/20 rounded-full blur-3xl opacity-20 moon-glow group-hover:opacity-30 transition-all duration-700"></div>
            
            <!-- Profile image with interactive effect -->
            <Image
              src={profilePic}
              alt="Malin Malliya Wadu"
              width={384}
              height={384}
              class="relative rounded-full w-64 h-64 md:w-96 md:h-96 object-cover shadow-2xl moon-image hover:cursor-pointer"
              id="profile-image"
              loading="eager"
            />
          </div>
        </div>
      </div>
      
      <div class="absolute bottom-10 left-1/2 transform -translate-x-1/2 hidden md:block animate-bounce">
        <a href="#about" class="text-gray-400 hover:text-white transition-colors">
          <span class="sr-only">Scroll to About Me</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </a>
      </div>
    </div>
  </section>
  
  <!-- About Section -->
  <Section
    id="about"
    title="About Me"
    subtitle="Passionate about creating impactful digital experiences"
  >
    <div class="max-w-5xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12 mb-12">
        <!-- Professional card -->
        <div class="about-card bg-gradient-to-br from-gray-800/60 to-gray-900/60 rounded-2xl p-10 backdrop-blur-xl border border-gray-600/30 shadow-2xl relative overflow-hidden animate-on-scroll">
          <!-- Enhanced gradient accent -->
          <div class="absolute -top-32 -right-32 w-64 h-64 bg-gradient-to-br from-purple-600/20 to-pink-600/20 rounded-full blur-3xl"></div>
          <div class="absolute -bottom-16 -left-16 w-32 h-32 bg-gradient-to-tr from-blue-600/15 to-purple-600/15 rounded-full blur-2xl"></div>
          
          <!-- Professional section -->
          <div class="relative z-10 space-y-4">
            <div class="flex items-center mb-4">
              <div class="about-icon-box p-2 bg-indigo-900/30 rounded-lg mr-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="about-icon h-6 w-6 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                </svg>
              </div>
              <h3 class="about-heading text-xl font-bold text-white">Professional Skills</h3>
            </div>
            <p class="about-text text-lg leading-relaxed">
              With <span class="text-indigo-300 font-medium">14+ years of professional experience</span>, I'm a full-stack developer with expertise in 
              <a href="#skills" class="text-indigo-400 font-medium hover:text-indigo-300 transition-colors">.NET</a>, 
              <a href="#skills" class="text-indigo-400 font-medium hover:text-indigo-300 transition-colors">TypeScript</a>, 
              <a href="#skills" class="text-indigo-400 font-medium hover:text-indigo-300 transition-colors">React</a>, and 
              <a href="#skills" class="text-indigo-400 font-medium hover:text-indigo-300 transition-colors">AWS</a>.
              I've developed a passion for bleeding-edge technologies and automation, consistently exploring ways to streamline development workflows and implement intelligent CI/CD pipelines.
            </p>
            <p class="about-text text-lg leading-relaxed">
              My approach combines <span class="text-purple-300 font-semibold">technical excellence</span> with a focus on <span class="text-purple-300 font-semibold">delivering business value</span> through robust, maintainable code and innovative and scalable architecture.
            </p>
          </div>
        </div>
        
        <!-- Personal card -->
        <div class="about-card bg-gradient-to-br from-gray-800/60 to-gray-900/60 rounded-2xl p-10 backdrop-blur-xl border border-gray-600/30 shadow-2xl relative overflow-hidden animate-on-scroll" style="animation-delay: 0.3s">
          <!-- Enhanced gradient accent -->
          <div class="absolute -bottom-32 -left-32 w-64 h-64 bg-gradient-to-tr from-pink-600/20 to-red-600/20 rounded-full blur-3xl"></div>
          <div class="absolute -top-16 -right-16 w-32 h-32 bg-gradient-to-bl from-green-600/15 to-blue-600/15 rounded-full blur-2xl"></div>
          
          <!-- Personal section -->
          <div class="relative z-10 space-y-4">
            <div class="flex items-center mb-4">
              <div class="about-icon-box p-2 bg-purple-900/30 rounded-lg mr-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="about-icon h-6 w-6 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <h3 class="about-heading text-xl font-bold text-white">Beyond Coding</h3>
            </div>
            <p class="about-text text-lg leading-relaxed mb-4">
              Off the keyboard, you'll find me:
            </p>
            <ul class="space-y-3">
              <li class="flex items-center">
                <span class="text-xl mr-3">🚐</span>
                <span>Chasing sunsets in my van</span>
              </li>
              <li class="flex items-center">
                <span class="text-xl mr-3">🌏</span>
                <span>Exploring hidden corners of the globe</span>
              </li>
              <li class="flex items-center">
                <span class="text-xl mr-3">💪</span>
                <span>Crushing PRs at the gym</span>
              </li>
              <li class="flex items-center">
                <span class="text-xl mr-3">🧘‍♂️</span>
                <span>Finding my zen through hot yoga</span>
              </li>
              <li class="flex items-center">
                <span class="text-xl mr-3">🌱</span>
                <span>Looking after my plant babies</span>
              </li>
              <li class="flex items-center">
                <span class="text-xl mr-3">👨‍🍳</span>
                <span>Experimenting with new recipes</span>
              </li>
              <li class="flex items-center">
                <span class="text-xl mr-3">📚</span>
                <span>Always learning something new</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
      
      <!-- Experience Counter moved to Work Experience section -->
    </div>
  </Section>
  
  <!-- Work Experience Section -->
  <Section
    id="experience"
    title="Work Experience"
    subtitle="My professional journey in the tech industry"
  >
    <WorkExperience jobs={jobHistory} />
  </Section>
  
  <!-- Skills Section -->
  <Section
    id="skills"
    title="Skills & Technologies"
    subtitle="The tools and technologies I work with"
  >
    <div class="skills-carousel-container">
      <!-- Category Navigation -->
      <div class="flex justify-center mb-8 overflow-x-auto">
        <div class="skills-nav-container flex space-x-2 p-1 bg-gray-800 bg-opacity-40 rounded-lg">
          {skillCategories.map((category, index) => (
            <button 
              class="skills-nav-button px-4 py-2 rounded-md text-sm transition-all duration-300" 
              data-index={index}
              aria-label={`Show ${category.name} skills`}
            >
              {category.name}
            </button>
          ))}
        </div>
      </div>
      
      <!-- Carousel Container with overflow control -->
      <div class="overflow-hidden">
        <div class="skills-carousel relative">
          <div class="skills-carousel-track flex transition-transform duration-500">
            {skillCategories.map((category) => (
              <div class="skills-carousel-slide w-full flex-shrink-0">
                <div class="flex flex-wrap justify-center py-2 px-4">
                  {category.skills.map((skill) => (
                    <SkillIcon name={skill.name} icon={skill.icon} />
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </Section>
  
  <!-- Certifications Section -->
  <Section
    id="certifications"
    title="Certifications"
    subtitle="Professional certifications and achievements"
  >
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {certifications.map((cert) => (
        <CertificationCard
          title={cert.title}
          issuer={cert.issuer}
          issueDate={cert.issueDate}
          expiryDate={cert.expiryDate}
          image={cert.image}
          link={cert.link}
        />
      ))}
    </div>
    <div class="mt-8 text-center">
      <a 
        href="https://www.credly.com/users/malin-malliya-wadu" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center text-indigo-400 hover:text-indigo-300 transition-colors"
      >
        <span>View all my certifications on Credly</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-1" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>
  </Section>
  
  <!-- Projects Section -->
  <Section
    id="projects"
    title="Featured Projects"
    subtitle="Explore my latest creations"
  >
