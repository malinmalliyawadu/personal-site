              <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
              <rect x="3" y="5" width="18" height="14" rx="2"></rect>
              <polyline points="3 7 12 13 21 7"></polyline>
            </svg>
            Email Me
          </a>
          <a
            href="https://www.linkedin.com/in/malin-malliya-wadu-94956522/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 border border-gray-300 text-base font-medium rounded-md shadow-sm text-white bg-gray-800 hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 118.3 6.5a1.78 1.78 0 01-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0013 14.19V19h-3v-9h2.9v1.3a3.11 3.11 0 012.7-1.4c1.55 0 3.36.86 3.36 3.66z"></path>
            </svg>
            LinkedIn
          </a>
        </div>
      </div>
    </div>
  </Section>
  
  <Footer />
  
</Layout>

<style>
  .animate-wave {
    display: inline-block;
    transform-origin: 70% 70%;
    animation: wave 2.5s infinite;
  }

  @keyframes wave {
    0% { transform: rotate(0deg); }
    10% { transform: rotate(14deg); }
    20% { transform: rotate(-8deg); }
    30% { transform: rotate(14deg); }
    40% { transform: rotate(-4deg); }
    50% { transform: rotate(10deg); }
    60% { transform: rotate(0deg); }
    100% { transform: rotate(0deg); }
  }
  
  .skills-carousel-container {
    max-width: 100%;
    overflow: hidden;
    padding: 1rem 0;
  }
  
  .skills-carousel {
    position: relative;
    padding: 0.5rem;
    overflow: visible;
  }
  
  .skills-carousel-track {
    display: flex;
    transition: transform 0.5s ease-in-out;
  }
  
  .skills-carousel-slide {
    width: 100%;
    flex-shrink: 0;
    padding: 0.5rem;
  }
  
  .skills-nav-button.active {
    background-color: rgba(99, 102, 241, 0.8);
    color: white;
    font-weight: 500;
  }
  
  .skills-nav-button:not(.active) {
    color: #d1d5db;
    background-color: transparent;
  }
  
  .skills-nav-button:hover:not(.active) {
    background-color: rgba(75, 85, 99, 0.5);
  }
</style>

<script>
  // Initialize carousel
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.querySelector('.skills-carousel-track') as HTMLElement;
    const slides = document.querySelectorAll('.skills-carousel-slide');
    const navButtons = document.querySelectorAll('.skills-nav-button');
    const skillsSection = document.querySelector('#skills');
    
    let currentIndex = 0;
    let interval: ReturnType<typeof setInterval> | undefined;
    let isAutoPlaying = true;
    const slidesCount = slides.length;
    
    // Set up initial state
    function updateCarousel() {
      // Update track position
      if (track) {
        track.style.transform = `translateX(-${currentIndex * 100}%)`;
      }
      
      // Update active nav button
      navButtons.forEach((button, index) => {
        if (index === currentIndex) {
          button.classList.add('active');
        } else {
          button.classList.remove('active');
        }
      });
    }
    
    // Start auto-rotation
    function startAutoPlay() {
      if (interval) clearInterval(interval);
      
      interval = setInterval(() => {
        if (isAutoPlaying) {
          currentIndex = (currentIndex + 1) % slidesCount;
          updateCarousel();
        }
      }, 5000); // Change slide every 5 seconds
    }
    
    // Permanently stop auto-scrolling
    function stopAutoPlay() {
      isAutoPlaying = false;
      if (interval) {
        clearInterval(interval);
        interval = undefined;
      }
    }
    
    // Event handlers
    function handleNavButtonClick(e: Event) {
      e.preventDefault();
      const clickedIndex = parseInt((e.currentTarget as HTMLElement).dataset.index || '0', 10);
      if (!isNaN(clickedIndex)) {
        currentIndex = clickedIndex;
        updateCarousel();
        stopAutoPlay();
      }
    }
    
    // Attach event listeners to nav buttons
    navButtons.forEach(button => {
      button.addEventListener('click', handleNavButtonClick);
    });
    
    // Add click event to the entire skills section to stop auto-scrolling
    if (skillsSection) {
      skillsSection.addEventListener('click', stopAutoPlay);
    }
    
    // Initialize
    updateCarousel();
    startAutoPlay();
    
    // Set first nav button as active initially
    if (navButtons.length > 0) {
      navButtons[0].classList.add('active');
    }
  });
</script>

