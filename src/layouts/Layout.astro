---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Full-stack developer specializing in .NET, TypeScript, React, and AWS. Based in Wellington, New Zealand." } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Outfit:wght@400;500;600;700;800;900&display=swap">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    </noscript>
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=UA-165385706-1"></script>
    <script>
      interface Window {
        dataLayer: any[];
        gtag: (...args: any[]) => void;
      }
      
      // @ts-ignore
      window.dataLayer = window.dataLayer || [];
      function gtag(...args: any[]) {
        // @ts-ignore
        window.dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "UA-165385706-1");
    </script>
  </head>
  <body class="bg-gray-950 text-white">
    <slot />
  </body>
</html>
<style is:global>
  @font-face {
    font-family: 'Outfit';
    font-style: normal;
    font-weight: 400 900;
    font-display: swap;
    src: url('/fonts/outfit.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  
  html {
    font-family: 'Inter', system-ui, sans-serif;
    scroll-behavior: smooth;
  }
  
  body {
    min-height: 100vh;
  }
  
  code {
    font-family: Menlo, Monaco, Lucida Console, Liberation Mono,
      DejaVu Sans Mono, Bitstream Vera Sans Mono, Courier New, monospace;
  }
  
  .font-outfit {
    font-family: 'Outfit', sans-serif;
  }
  
  .gradient-text {
    background: linear-gradient(90deg, #818cf8, #a855f7);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    display: inline-block;
    padding-bottom: 0.25em;
  }
  
  .hover\:text-shadow-lg:hover {
    text-shadow: 0 0 15px rgba(139, 92, 246, 0.5);
  }
  
  /* Enhanced button styles */
  .btn-primary {
    @apply inline-flex items-center justify-center gap-2 px-6 py-3 font-medium rounded-md;
    background: linear-gradient(135deg, rgba(129, 140, 248, 0.8) 0%, rgba(99, 102, 241, 0.8) 100%);
    position: relative;
    z-index: 1;
    border: 1px solid rgba(129, 140, 248, 0.4);
    box-shadow: 0 4px 14px 0 rgba(99, 102, 241, 0.39);
    transition: all 0.3s ease;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    overflow: hidden;
  }
  
  .btn-primary::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.9) 0%, rgba(79, 70, 229, 0.9) 100%);
    transition: opacity 0.3s ease;
  }
  
  .btn-primary::after {
    content: '';
    position: absolute;
    top: -100%;
    left: -20%;
    width: 140%;
    height: 200%;
    background: linear-gradient(
      to bottom right,
      rgba(255, 255, 255, 0.25) 0%,
      rgba(255, 255, 255, 0.1) 40%,
      transparent 100%
    );
    transform: rotate(30deg);
    pointer-events: none;
    z-index: -1;
    transition: transform 0.5s ease;
  }
  
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(99, 102, 241, 0.6);
    border-color: rgba(129, 140, 248, 0.7);
  }
  
  .btn-primary:hover::before {
    opacity: 1;
  }
  
  .btn-primary:hover::after {
    transform: rotate(30deg) translateY(-10px);
  }
  
  .btn-primary:active {
    transform: translateY(0);
    box-shadow: 0 3px 10px rgba(99, 102, 241, 0.4);
  }
  
  .btn-secondary {
    @apply inline-flex items-center justify-center gap-2 px-6 py-3 font-medium rounded-md text-white;
    background: rgba(31, 41, 55, 0.4);
    border: 1px solid rgba(107, 114, 128, 0.3);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    position: relative;
    z-index: 1;
    box-shadow: 0 4px 14px 0 rgba(31, 41, 55, 0.25);
    transition: all 0.3s ease;
    overflow: hidden;
  }
  
  .btn-secondary::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0;
    border-radius: inherit;
    background: rgba(55, 65, 81, 0.6);
    transition: opacity 0.3s ease;
  }
  
  .btn-secondary::after {
    content: '';
    position: absolute;
    top: -100%;
    left: -20%;
    width: 140%;
    height: 200%;
    background: linear-gradient(
      to bottom right,
      rgba(255, 255, 255, 0.15) 0%,
      rgba(255, 255, 255, 0.05) 40%,
      transparent 100%
    );
    transform: rotate(30deg);
    pointer-events: none;
    z-index: -1;
    transition: transform 0.5s ease;
  }
  
  .btn-secondary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(17, 24, 39, 0.45);
    border-color: rgba(156, 163, 175, 0.5);
  }
  
  .btn-secondary:hover::before {
    opacity: 1;
  }
  
  .btn-secondary:hover::after {
    transform: rotate(30deg) translateY(-10px);
  }
  
  .btn-secondary:active {
    transform: translateY(0);
    box-shadow: 0 3px 10px rgba(17, 24, 39, 0.3);
  }
</style>
