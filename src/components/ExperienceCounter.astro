---
import Terminal from './Terminal.astro';
import TypingAnimation from './TypingAnimation.astro';
import AnimatedSpan from './AnimatedSpan.astro';

interface Props {
  startDate: string; // Format: YYYY-MM-DD
  className?: string;
}

const { startDate, className = "" } = Astro.props;
---

<Terminal className={className}>
  <div class="flex flex-col space-y-3">
    <!-- First command with pre-rendered $ -->
    <div class="flex items-center">
      <span class="text-green-400">$</span>
      <span class="ml-2">
        <TypingAnimation delay={300} duration={30}>
          cat ~/.career/profile.json | jq -r '.start_date'
        </TypingAnimation>
      </span>
    </div>
    
    <!-- First command response -->
    <div class="text-gray-400 ml-4">
      <TypingAnimation delay={1500} duration={15} id="first-response">
        <AnimatedSpan>{startDate}  # First developer job at Trade Me</AnimatedSpan>
      </TypingAnimation>
    </div>
    
    <!-- Second command with pre-rendered $ -->
    <div class="flex items-center mt-2">
      <span class="text-green-400">$</span>
      <span class="ml-2">
        <TypingAnimation delay={3000} duration={30}>
          cat ~/.career/profile.json | jq -r '.start_date' | cut -d'#' -f1 | tr -d ' ' | node ~/.scripts/calculate-experience.js
        </TypingAnimation>
      </span>
    </div>
    
    <!-- Second command response -->
    <div class="text-green-300 ml-4">
      <TypingAnimation delay={4500} duration={15}>
        <div id="experience-years">
          <!-- This will be filled by JavaScript -->
        </div>
      </TypingAnimation>
    </div>
  </div>
</Terminal>

<script define:vars={{ startDate }}>
  // Calculate experience based on start date
  function calculateExperience() {
    // Parse start date
    const start = new Date(startDate);
    const now = new Date();
    
    // Calculate difference in milliseconds
    const diffTime = Math.abs(now - start);
    
    // Convert to years with decimal precision (days/365.25 to account for leap years)
    const diffDays = diffTime / (1000 * 60 * 60 * 24);
    const years = diffDays / 365.25;
    
    // Extract whole years and decimal part
    const wholeYears = Math.floor(years);
    
    // Calculate more detailed time units
    const totalDays = Math.floor(diffDays);
    const totalHours = Math.floor(totalDays * 24);
    const totalMinutes = Math.floor(totalHours * 60);
    const totalSeconds = Math.floor(totalMinutes * 60);
    
    // Calculate coffees (2 per day)
    const totalCoffees = totalDays * 2;
    
    // Format with 8 decimal places for a cool "counting up" effect
    const formattedYears = years.toFixed(8);
    
    return {
      years,
      wholeYears,
      formattedYears,
      totalDays,
      totalHours, 
      totalMinutes,
      totalSeconds,
      totalCoffees
    };
  }
  
  // Update the display
  function updateExperienceDisplay() {
    const experienceElement = document.getElementById('experience-years');
    if (!experienceElement) return;
    
    const exp = calculateExperience();
    
    // Create a visually interesting display with colored output
    experienceElement.innerHTML = `
      <div class="font-mono space-y-1">
        <div>
          <span class="text-yellow-300">Experience:</span> <span class="text-green-300 font-bold">${exp.wholeYears}</span><span class="text-green-400 opacity-90">.</span><span class="text-green-400 opacity-80">${exp.formattedYears.split('.')[1].substring(0, 2)}</span><span class="text-green-500 opacity-70">${exp.formattedYears.split('.')[1].substring(2, 4)}</span><span class="text-green-500 opacity-60">${exp.formattedYears.split('.')[1].substring(4, 6)}</span><span class="text-green-600 opacity-50">${exp.formattedYears.split('.')[1].substring(6, 8)}</span> <span class="text-gray-300">years</span>
        </div>
        <div>
          <span class="text-yellow-300">Days:</span> <span class="text-indigo-400" id="days-counter">${exp.totalDays.toLocaleString()}</span>
        </div>
        <div>
          <span class="text-yellow-300">Hours:</span> <span class="text-purple-400" id="hours-counter">${exp.totalHours.toLocaleString()}</span>
        </div>
        <div>
          <span class="text-yellow-300">Minutes:</span> <span class="text-pink-400" id="minutes-counter">${exp.totalMinutes.toLocaleString()}</span>
        </div>
        <div>
          <span class="text-yellow-300">Seconds:</span> <span class="text-red-400" id="seconds-counter">${exp.totalSeconds.toLocaleString()}</span>
        </div>
        <div>
          <span class="text-yellow-300">Coffees:</span> <span class="text-amber-500" id="coffee-counter">☕ × ${exp.totalCoffees.toLocaleString()}</span>
        </div>
      </div>
    `;
  }
  
  // Update metrics in real-time
  function startRealtimeUpdates() {
    // Update counters every 50ms
    setInterval(() => {
      const exp = calculateExperience();
      
      // Update individual counters
      document.getElementById('days-counter')?.textContent = exp.totalDays.toLocaleString();
      document.getElementById('hours-counter')?.textContent = exp.totalHours.toLocaleString();
      document.getElementById('minutes-counter')?.textContent = exp.totalMinutes.toLocaleString();
      document.getElementById('seconds-counter')?.textContent = exp.totalSeconds.toLocaleString();
      
      // Occasionally add a coffee
      if (Math.random() < 0.0001) {
        const coffeeElement = document.getElementById('coffee-counter');
        if (coffeeElement) {
          const currentCoffees = parseInt(coffeeElement.textContent.replace(/[^\d]/g, '').replace(/,/g, ''));
          coffeeElement.textContent = `☕ × ${(currentCoffees + 1).toLocaleString()}`;
        }
      }
    }, 50);
  }
  
  // Initialize when the animation is likely to be complete
  document.addEventListener('DOMContentLoaded', () => {
    setTimeout(() => {
      updateExperienceDisplay();
      startRealtimeUpdates();
    }, 5000); // Wait for typing animations to complete
  });
  
  // Handle Astro view transitions
  document.addEventListener('astro:page-load', () => {
    setTimeout(() => {
      updateExperienceDisplay();
      startRealtimeUpdates();
    }, 5000);
  });
</script> 