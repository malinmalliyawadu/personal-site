---
interface Props {
  title: string;
  issuer: string;
  issueDate: string;
  expiryDate: string;
  image: string;
  link: string;
}
const { title, issuer, issueDate, expiryDate, image, link } = Astro.props;

const fmt = (d: string) =>
  new Date(d + "T00:00:00").toLocaleDateString("en-NZ", { month: "short", year: "numeric" });
const isPro = /professional/i.test(title);
---

<a href={link} target="_blank" rel="noopener noreferrer" class={`cert reveal ${isPro ? "is-pro" : ""}`}>
  <div class="cert-badge">
    <img src={image} alt={`${title} badge`} loading="lazy" decoding="async" width="76" height="76" />
  </div>
  <div class="cert-body">
    {isPro && <span class="cert-pro font-mono">professional</span>}
    <h3 class="cert-title">{title}</h3>
    <p class="cert-issuer">{issuer}</p>
    <div class="cert-meta font-mono">
      <span>issued {fmt(issueDate)}</span>
      <span class="cert-dot">·</span>
      <span>exp {fmt(expiryDate)}</span>
    </div>
  </div>
  <span class="cert-verify font-mono">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m5 12 4 4L19 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    verify
  </span>
</a>

<style>
  .cert {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.1rem;
    padding: 1.1rem 1.2rem;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: linear-gradient(180deg, rgba(167, 139, 250, 0.04), transparent 40%), var(--tile);
    transition: border-color 0.18s var(--ease), transform 0.18s var(--ease), box-shadow 0.18s var(--ease);
  }
  .cert:hover {
    border-color: rgba(167, 139, 250, 0.5);
    transform: translateY(-2px);
    box-shadow: 0 18px 40px -28px rgba(167, 139, 250, 0.5);
  }
  .cert-badge {
    width: 64px;
    height: 64px;
    display: grid;
    place-items: center;
    flex: none;
  }
  .cert-badge img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: saturate(0.95);
  }
  .cert-body {
    min-width: 0;
  }
  .cert-pro {
    display: inline-block;
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--violet);
    border: 1px solid rgba(167, 139, 250, 0.4);
    border-radius: 5px;
    padding: 0.05rem 0.4rem;
    margin-bottom: 0.4rem;
  }
  .cert-title {
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--fg);
    line-height: 1.2;
    margin-bottom: 0.2rem;
  }
  .cert-issuer {
    font-size: 0.78rem;
    color: var(--fg-dim);
    margin-bottom: 0.4rem;
  }
  .cert-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.66rem;
    color: var(--fg-faint);
  }
  .cert-verify {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.68rem;
    color: var(--fg-faint);
    transition: color 0.16s var(--ease);
    flex: none;
  }
  .cert-verify svg {
    width: 14px;
    height: 14px;
  }
  .cert:hover .cert-verify {
    color: var(--violet);
  }

  @media (max-width: 460px) {
    .cert {
      grid-template-columns: auto 1fr;
      gap: 0.9rem;
    }
    .cert-verify {
      grid-column: 1 / -1;
      justify-self: start;
      padding-left: calc(64px + 0.9rem);
    }
  }
</style>
