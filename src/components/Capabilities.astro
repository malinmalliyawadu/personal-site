---
import Panel from "./Panel.astro";
import { capabilities } from "../data/site";

const icons: Record<string, string> = {
  architecture:
    '<path d="M12 3 4 7v10l8 4 8-4V7l-8-4Z"/><path d="M12 12 4 7M12 12l8-5M12 12v9" stroke-linecap="round"/>',
  fullstack:
    '<rect x="3" y="4" width="18" height="5" rx="1.5"/><rect x="3" y="15" width="18" height="5" rx="1.5"/><path d="M7 6.5h.01M7 17.5h.01" stroke-linecap="round"/>',
  delivery:
    '<path d="M5 12a4 4 0 1 0 4-4c-2.5 0-3.5 2-5 4s-2.5 4-5 4" stroke-linecap="round"/><circle cx="18.5" cy="12" r="2.6"/>',
  leadership:
    '<circle cx="12" cy="8" r="3.2"/><path d="M5 20c0-3.6 3.1-6 7-6s7 2.4 7 6" stroke-linecap="round"/>',
};
---

<Panel id="capabilities" svc="svc-02" path="svc://service-catalog" status="4 endpoints" tone="route">
  <div class="sec-head reveal">
    <p class="eyebrow">capabilities · what to engage me for</p>
    <h2 class="section-title">A senior operator across the whole stack</h2>
    <p class="section-lede">
      Four services I run end to end - from cloud architecture in regulated environments to polished
      product, reliable delivery pipelines, and the technical leadership that keeps a team shipping.
    </p>
  </div>

  <div class="cap-grid">
    {
      capabilities.map((c, i) => (
        <article class="cap reveal" style={`--reveal-delay:${i * 60}ms`}>
          <div class="cap-top">
            <span class="cap-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" set:html={icons[c.id]} />
            </span>
            <span class="cap-endpoint font-mono">svc.{c.id}</span>
          </div>
          <h3 class="cap-title">{c.title}</h3>
          <p class="cap-blurb">{c.blurb}</p>
          <ul class="cap-points">
            {c.points.map((p) => (
              <li class="chip">{p}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</Panel>

<style>
  .sec-head {
    margin-bottom: 1.6rem;
    max-width: 46rem;
  }
  .sec-head .eyebrow {
    margin-bottom: 0.7rem;
    display: block;
  }
  .sec-head .section-title {
    margin-bottom: 0.6rem;
  }

  .cap-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.85rem;
  }
  .cap {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.015), transparent 30%), var(--tile);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1.3rem 1.35rem 1.45rem;
    transition: border-color 0.18s var(--ease), transform 0.18s var(--ease);
  }
  .cap:hover {
    border-color: rgba(77, 163, 255, 0.4);
    transform: translateY(-2px);
  }
  .cap-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.95rem;
  }
  .cap-icon {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 9px;
    background: var(--inset);
    border: 1px solid var(--line);
    color: var(--route);
  }
  .cap-icon svg {
    width: 20px;
    height: 20px;
  }
  .cap-endpoint {
    font-size: 0.66rem;
    color: var(--fg-faint);
  }
  .cap-title {
    font-family: "Clash Display", sans-serif;
    font-weight: 600;
    font-size: 1.2rem;
    letter-spacing: -0.01em;
    color: var(--fg);
    margin-bottom: 0.45rem;
  }
  .cap-blurb {
    font-size: 0.92rem;
    color: var(--fg-dim);
    line-height: 1.55;
    margin-bottom: 1rem;
  }
  .cap-points {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cap-points .chip {
    font-size: 0.66rem;
    padding: 0.22rem 0.5rem;
  }

  @media (max-width: 760px) {
    .cap-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
