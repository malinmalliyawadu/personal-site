---
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<div class={`relative group rounded-lg border border-gray-700 bg-gray-800/50 backdrop-blur-sm ${className}`}>
  <div class="flex items-center justify-between p-2 border-b border-gray-700/50">
    <div class="flex items-center space-x-1.5">
      <span class="w-3 h-3 rounded-full bg-red-500"></span>
      <span class="w-3 h-3 rounded-full bg-yellow-500"></span>
      <span class="w-3 h-3 rounded-full bg-green-500"></span>
    </div>
    <div class="text-xs text-gray-400">Terminal</div>
    <div class="w-12"></div>
  </div>
  <div class="p-4 font-mono text-sm text-gray-300 overflow-auto max-h-[400px]">
    <slot />
  </div>
</div> 