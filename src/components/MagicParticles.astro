---
// MagicParticles.astro
// Inspired by Magic UI's Particles component
// https://magicui.design/docs/components/particles
---

<div class="magic-particles-container">
  <div class="balayage-background"></div>
  <div id="particles" class="magic-particles"></div>
</div>

<style>
  .magic-particles-container {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  
  .magic-particles {
    position: absolute;
    inset: 0;
    background: transparent;
  }
  
  .balayage-background {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      #070709 0%,
      #0a0a18 15%,
      #0e0e20 30%,
      #0f0f24 45%,
      #12101f 60%,
      #14102a 75%,
      #18102e 90%,
      #1c0f32 100%
    );
    z-index: -1;
    opacity: 1;
  }
  
  /* Remove radial gradient light effects */
  .balayage-background::after {
    display: none;
  }
</style>

<script>
  // Use a simpler approach with a properly typed global declaration
  interface Particle {
    x: number;
    y: number;
    size: number;
    speedX: number;
    speedY: number;
    opacity: number;
    color: string;
    twinkleSpeed: number;
    twinklePhase: number;
    age: number;         // Track the age of the particle for animation
    maxAge: number;      // Maximum age for full opacity
    isNew: boolean;      // Flag for new particles
  }

  // Declare global functions for use in other scripts
  declare global {
    interface Window {
      addMoreStars: (count?: number) => number;
      removeStars: (count?: number) => number;
      getStarCount: () => number;
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const config = {
      quantity: 100,
      staticity: 0,
      ease: 1,
      size: 0.5,
      colors: ['#d8cfffb0', '#c4b5ffb0', '#bfa6ffb0', '#a5b4ffb0', '#9f8ceeb0'],
      minSize: 0.3,
      maxSize: 5.5,
      twinkleMax: 3.0,
      twinkleMin: 0.1
    };

    class ParticleSystem {
      canvas: HTMLCanvasElement = document.createElement('canvas');
      ctx!: CanvasRenderingContext2D;
      particles: Particle[] = [];
      width: number = window.innerWidth;
      height: number = window.innerHeight;
      mouseX: number = 0;
      mouseY: number = 0;
      mouseMoveEvent: boolean = false;
      lastTime: number = 0;
      frameThrottle: number = 15;
      config: any;
      
      constructor(particleConfig: any) {
        this.config = particleConfig;
        const container = document.getElementById('particles');
        if (!container) return;
        
        // Create canvas
        this.canvas.classList.add('particles-canvas');
        this.canvas.style.position = 'absolute';
        this.canvas.style.inset = '0';
        container.appendChild(this.canvas);
        
        // Get context
        const ctx = this.canvas.getContext('2d');
        if (!ctx) return;
        this.ctx = ctx;
        
        // Initialize
        this.resize();
        this.initParticles();
        this.bindEvents();
        this.animate();
      }
      
      resize() {
        this.width = window.innerWidth;
        this.height = window.innerHeight;
        this.canvas.width = this.width;
        this.canvas.height = this.height;
        
        // Reset particles on resize
        if (this.particles.length > 0) {
          this.particles = [];
          this.initParticles();
        }
      }
      
      initParticles() {
        for (let i = 0; i < this.config.quantity; i++) {
          this.particles.push(this.createParticle());
        }
      }
      
      // Add new stars with animation
      addStars(count: number) {
        for (let i = 0; i < count; i++) {
          const newStar = this.createParticle();
          newStar.isNew = true;
          newStar.age = 0;
          // Make animation faster to be more visible
          newStar.maxAge = 30;
          // Make new stars start completely invisible
          newStar.opacity = 0;
          this.particles.push(newStar);
        }
        return this.particles.length;
      }
      
      // Remove stars
      removeStars(count: number) {
        if (this.particles.length > count) {
          this.particles = this.particles.slice(0, this.particles.length - count);
        }
        return this.particles.length;
      }
      
      createParticle(): Particle {
        // Random size with bias toward smaller particles
        const size = (Math.random() * (this.config.maxSize - this.config.minSize) + this.config.minSize) * this.config.size;
        
        // Random color from the color array
        const color = this.config.colors[Math.floor(Math.random() * this.config.colors.length)];
        
        // Even distribution of particles
        return {
          x: Math.random() * this.width,
          y: Math.random() * this.height,
          size: size,
          speedX: (Math.random() - 0.5) * (100 - this.config.staticity) / 1000,
          speedY: (Math.random() - 0.5) * (100 - this.config.staticity) / 1000,
          opacity: Math.random() * 0.4 + 0.4, // Higher base opacity
          color: color,
          twinkleSpeed: Math.random() * 0.01 + 0.005, // Faster twinkling
          twinklePhase: Math.random() * Math.PI * 2,
          age: 100,           // Existing stars start at full age
          maxAge: 60,         // Frames until full opacity 
          isNew: false        // Not a new star by default
        };
      }
      
      bindEvents() {
        // Throttled resize listener
        let resizeTimeout: number;
        window.addEventListener('resize', () => {
          clearTimeout(resizeTimeout);
          resizeTimeout = setTimeout(() => this.resize(), 200) as unknown as number;
        });
        
        // Throttled mousemove listener
        let mouseMoveTimeout: number;
        window.addEventListener('mousemove', (e) => {
          if (mouseMoveTimeout) return;
          
          mouseMoveTimeout = setTimeout(() => {
            this.mouseX = e.clientX;
            this.mouseY = e.clientY;
            this.mouseMoveEvent = true;
            mouseMoveTimeout = 0;
          }, 10) as unknown as number;
        });
      }
      
      animate(timestamp = 0) {
        // Frame rate throttling
        if (timestamp - this.lastTime < this.frameThrottle) {
          requestAnimationFrame((t) => this.animate(t));
          return;
        }
        
        this.lastTime = timestamp;
        this.ctx.clearRect(0, 0, this.width, this.height);
        
        // Update and draw particles
        this.particles.forEach(p => {
          // Move particles
          p.x += p.speedX;
          p.y += p.speedY;
          
          // Update twinkle phase
          p.twinklePhase += p.twinkleSpeed;
          if (p.twinklePhase > Math.PI * 2) {
            p.twinklePhase = 0;
          }
          
          // Calculate current twinkle factor
          const twinkleFactor = 
            this.config.twinkleMin + 
            (Math.sin(p.twinklePhase) + 1) / 2 * 
            (this.config.twinkleMax - this.config.twinkleMin);
          
          // Handle new star animation - increase age and animate size/opacity
          if (p.isNew) {
            p.age++;
            if (p.age >= p.maxAge) {
              p.isNew = false;
              // Ensure it reaches full opacity when animation completes
              p.opacity = Math.random() * 0.4 + 0.4;
            }
          }
          
          // Wrap particles around the screen
          if (p.x > this.width) p.x = 0;
          else if (p.x < 0) p.x = this.width;
          
          if (p.y > this.height) p.y = 0;
          else if (p.y < 0) p.y = this.height;
          
          // Mouse interaction - only process if mouse moved
          if (this.mouseMoveEvent) {
            const dx = this.mouseX - p.x;
            const dy = this.mouseY - p.y;
            const distance = Math.sqrt(dx * dx + dy * dy);
            const maxDistance = 150;
            
            if (distance < maxDistance) {
              // Calculate the force (stronger when closer)
              const force = (maxDistance - distance) / maxDistance;
              
              // Apply the "soft" push effect based on ease setting
              const angle = Math.atan2(dy, dx);
              const pushX = Math.cos(angle) * force * (100 - this.config.ease) / 500;
              const pushY = Math.sin(angle) * force * (100 - this.config.ease) / 500;
              
              // Push particles away from mouse
              p.x -= pushX;
              p.y -= pushY;
            }
          }
          
          // Draw particle with twinkle and age-based scaling
          this.ctx.beginPath();
          
          // Calculate age ratio with smoother easing (cubic easing)
          const ageRatio = p.isNew ? Math.min(p.age / p.maxAge, 1) : 1;
          // Cubic easing for more dramatic growing effect
          const easing = ageRatio * ageRatio * (3 - 2 * ageRatio);
          
          // Apply scale and opacity based on age
          const currentSize = p.isNew ? p.size * easing : p.size;
          const currentOpacity = p.isNew ? 
            (Math.random() * 0.4 + 0.4) * easing : // Target opacity with easing
            p.opacity;
          
          this.ctx.arc(p.x, p.y, currentSize, 0, Math.PI * 2);
          this.ctx.fillStyle = p.color;
          this.ctx.globalAlpha = currentOpacity * twinkleFactor;
          this.ctx.fill();
          this.ctx.globalAlpha = 1;
        });
        
        // Reset mouse event flag
        this.mouseMoveEvent = false;
        
        // Request next frame
        requestAnimationFrame((t) => this.animate(t));
      }
    }
    
    // Create a global reference to the particle system
    let particleSystemInstance: ParticleSystem | null = null;
    
    try {
      particleSystemInstance = new ParticleSystem(config);

      // Expose methods to the global scope
      window.addMoreStars = (count = 100) => {
        if (particleSystemInstance) {
          return particleSystemInstance.addStars(count);
        }
        return 0;
      };
      
      window.removeStars = (count = 100) => {
        if (particleSystemInstance) {
          return particleSystemInstance.removeStars(count);
        }
        return 0;
      };
      
      window.getStarCount = () => {
        if (particleSystemInstance) {
          return particleSystemInstance.particles.length;
        }
        return 0;
      };
      
    } catch (e) {
      console.error("Could not initialize particle system", e);
    }
  });
</script> 