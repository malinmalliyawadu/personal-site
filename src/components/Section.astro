---
interface Props {
  id: string;
  title: string;
  subtitle?: string;
  index?: string;
  class?: string;
}

const { id, title, subtitle, index, class: className = "" } = Astro.props;
---

<section id={id} class={`py-20 md:py-28 border-t border-line ${className}`}>
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <header class="mb-12 md:mb-16 animate-on-scroll">
      <p class="font-mono text-[0.7rem] font-medium tracking-[0.25em] uppercase mb-5">
        {index && <span class="text-accent">{index}</span>}
        <span class="text-ink-faint">{index && " / "}{title}</span>
      </p>
      <h2 class="font-display text-4xl md:text-6xl font-semibold tracking-tight text-ink leading-[1.05]">
        {title}
      </h2>
      {subtitle && (
        <p class="mt-4 font-display italic text-lg md:text-xl text-ink-soft max-w-2xl">
          {subtitle}
        </p>
      )}
    </header>

    <slot />
  </div>
</section>
