---
interface Props {
  id: string;
  title: string;
  subtitle?: string;
  class?: string;
}

const { id, title, subtitle, class: className = "" } = Astro.props;
---

<section id={id} class={`py-20 ${className}`}>
  <div class="container mx-auto px-4">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-5xl font-extrabold inline-block tracking-tight font-outfit">
        <div class="gradient-text">
          {title}
        </div>
      </h2>
      
      {subtitle && (
        <p class="text-xl text-gray-300 max-w-3xl mx-auto">
          {subtitle}
        </p>
      )}
    </div>
    
    <slot />
  </div>
</section> 