---
interface Props {
  id: string;
  title: string;
  subtitle?: string;
  class?: string;
}

const { id, title, subtitle, class: className = "" } = Astro.props;
---

<section id={id} class={`py-20 md:py-32 ${className} relative overflow-hidden`}>
  <!-- Enhanced section background -->
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-purple-900/5 to-transparent pointer-events-none"></div>
  
  <div class="container mx-auto px-4 relative z-10">
    <div class="text-center mb-12 md:mb-20">
      <h2 class="text-4xl md:text-6xl lg:text-7xl font-black tracking-tight font-outfit">
        <div class="gradient-text bg-gradient-to-r from-purple-400 via-pink-400 to-red-400 bg-clip-text text-transparent">
          {title}
        </div>
      </h2>
      
      {subtitle && (
        <p class="text-xl md:text-2xl text-gray-300 max-w-4xl mx-auto leading-relaxed">
          {subtitle}
        </p>
      )}
    </div>
    
    <slot />
  </div>
</section> 