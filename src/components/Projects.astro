---
import Panel from "./Panel.astro";
import ProjectPanel from "./ProjectPanel.astro";
import { projects, profile } from "../data/site";

const anchors = ["work-ee", "work-eeweb", "work-ff", "work-csk"];
---

<Panel id="work" svc="svc-03" path="svc://flagship-projects" status="4 running">
  <div class="sec-head reveal">
    <p class="eyebrow">selected work · monitored services</p>
    <h2 class="section-title">Real products, shipped and running</h2>
    <p class="section-lede">
      Between contracts, I build and run custom software pro-bono for Aotearoa charities - real
      platforms, shipped end to end and live in production today.
    </p>
  </div>

  <div class="proj-list">
    {
      projects.map((p, i) => (
        <ProjectPanel
          anchor={anchors[i]}
          index={i}
          title={p.title}
          tag={p.tag}
          year={p.year}
          description={p.description}
          image={p.image}
          imageW={p.imageW}
          imageH={p.imageH}
          phoneImage={"phoneImage" in p ? (p as any).phoneImage : undefined}
          phoneImageW={"phoneImageW" in p ? (p as any).phoneImageW : undefined}
          phoneImageH={"phoneImageH" in p ? (p as any).phoneImageH : undefined}
          phoneImageAlt={"phoneImageAlt" in p ? (p as any).phoneImageAlt : undefined}
          demo={p.demo}
          github={p.github}
          appStore={"appStore" in p ? (p as any).appStore : undefined}
          playStore={"playStore" in p ? (p as any).playStore : undefined}
          stack={p.stack}
          stats={p.stats}
          wip={"wip" in p ? (p as any).wip : false}
          reverse={i % 2 === 1}
        />
      ))
    }
  </div>

  <div class="proj-foot reveal">
    <a href={profile.socials.github} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2A10 10 0 0 0 8.84 21.5c.5.08.66-.22.66-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.74c0 .27.16.57.67.48A10 10 0 0 0 12 2Z"/></svg>
      More on GitHub
    </a>
  </div>
</Panel>

<style>
  .sec-head {
    margin-bottom: 0.5rem;
    max-width: 46rem;
  }
  .sec-head .eyebrow {
    margin-bottom: 0.7rem;
    display: block;
  }
  .sec-head .section-title {
    margin-bottom: 0.6rem;
  }
  .proj-foot {
    margin-top: 1.6rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--line);
  }
</style>
