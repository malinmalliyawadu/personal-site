---
interface Props {
  className?: string;
  containerRef: string;
  fromRef: string;
  toRef: string;
  curvature?: number;
  reverse?: boolean;
  duration?: number;
  delay?: number;
  pathColor?: string;
  pathWidth?: number;
  pathOpacity?: number;
  gradientStartColor?: string;
  gradientStopColor?: string;
  startXOffset?: number;
  startYOffset?: number;
  endXOffset?: number;
  endYOffset?: number;
}

const {
  className,
  containerRef,
  fromRef,
  toRef,
  curvature = 0,
  reverse = false,
  duration = 5,
  delay = 0,
  pathColor = "gray",
  pathWidth = 2,
  pathOpacity = 0.2,
  gradientStartColor = "#ffaa40",
  gradientStopColor = "#9c40ff",
  startXOffset = 0,
  startYOffset = 0,
  endXOffset = 0,
  endYOffset = 0,
} = Astro.props;

const id = Math.random().toString(36).substring(2, 11);
---

<div class={`animated-beam-container ${className || ""}`}>
  <svg
    class="animated-beam-svg"
    width="100%"
    height="100%"
    viewBox="0 0 100 100"
    preserveAspectRatio="none"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none;"
  >
    <defs>
      <linearGradient id={`beam-gradient-${id}`}>
        <stop offset="0%" stop-color={gradientStartColor}></stop>
        <stop offset="100%" stop-color={gradientStopColor}></stop>
      </linearGradient>
    </defs>
    <path
      id={`beam-path-${id}`}
      stroke={pathColor}
      stroke-width={pathWidth}
      stroke-opacity={pathOpacity}
      vector-effect="non-scaling-stroke"
    >
    </path>
    <circle id={`beam-point-${id}`} r="2" fill={`url(#beam-gradient-${id})`}>
      <animate
        attributeName="opacity"
        values="0;1;0"
        dur="0.5s"
        begin="0s"
        repeatCount="indefinite"
      />
    </circle>
  </svg>
</div>

<script define:vars={{
  id,
  containerRef,
  fromRef,
  toRef,
  curvature,
  reverse,
  duration,
  delay,
  startXOffset,
  startYOffset,
  endXOffset,
  endYOffset,
}}>
// Initialize the animation when the document is loaded
document.addEventListener('DOMContentLoaded', () => {
  const container = document.getElementById(containerRef);
  const fromElement = document.getElementById(fromRef);
  const toElement = document.getElementById(toRef);
  
  if (!container || !fromElement || !toElement) {
    console.error('AnimatedBeam: One or more references not found', { containerRef, fromRef, toRef });
    return;
  }
  
  const pathElement = document.getElementById(`beam-path-${id}`);
  const pointElement = document.getElementById(`beam-point-${id}`);
  
  if (!pathElement || !pointElement) {
    console.error('AnimatedBeam: SVG elements not found');
    return;
  }
  
  // Function to get the element's position relative to the container
  function getRelativePosition(element, container) {
    const containerRect = container.getBoundingClientRect();
    const elementRect = element.getBoundingClientRect();
    
    return {
      x: elementRect.left - containerRect.left + elementRect.width / 2,
      y: elementRect.top - containerRect.top + elementRect.height / 2
    };
  }
  
  // Function to update the path and animation
  function updatePath() {
    const fromPos = getRelativePosition(fromElement, container);
    const toPos = getRelativePosition(toElement, container);
    
    // Apply offsets
    fromPos.x += startXOffset;
    fromPos.y += startYOffset;
    toPos.x += endXOffset;
    toPos.y += endYOffset;
    
    // Calculate control point for curve
    const mx = fromPos.x + (toPos.x - fromPos.x) / 2;
    const my = fromPos.y + (toPos.y - fromPos.y) / 2;
    const cpx = mx;
    const cpy = my - (Math.abs(toPos.x - fromPos.x) * curvature);
    
    // Create the path
    const path = `M ${fromPos.x},${fromPos.y} Q ${cpx},${cpy} ${toPos.x},${toPos.y}`;
    pathElement.setAttribute('d', path);
    
    // Set up the animation for the point
    const animationDuration = duration;
    const animationDelay = delay;
    
    // Create animation
    pointElement.innerHTML = '';
    const animate = document.createElementNS('http://www.w3.org/2000/svg', 'animateMotion');
    animate.setAttribute('dur', `${animationDuration}s`);
    animate.setAttribute('repeatCount', 'indefinite');
    animate.setAttribute('path', path);
    
    if (animationDelay > 0) {
      animate.setAttribute('begin', `${animationDelay}s`);
    }
    
    if (reverse) {
      animate.setAttribute('keyPoints', '1;0');
      animate.setAttribute('keyTimes', '0;1');
      animate.setAttribute('calcMode', 'linear');
      animate.setAttribute('keySplines', '0.42 0 0.58 1');
    }
    
    pointElement.appendChild(animate);
  }
  
  // Initial update
  updatePath();
  
  // Update path on window resize
  window.addEventListener('resize', updatePath);
  
  // Update on scroll to handle positioning when elements move
  window.addEventListener('scroll', updatePath);
  
  // Set a small delay to ensure elements are properly positioned
  setTimeout(updatePath, 500);
  
  // Also update periodically during the first few seconds
  let updateCount = 0;
  const periodicUpdate = setInterval(() => {
    updatePath();
    updateCount++;
    if (updateCount >= 5) {
      clearInterval(periodicUpdate);
    }
  }, 1000);
});
</script>

<style>
.animated-beam-container {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: visible;
  z-index: 0;
}

.animated-beam-svg {
  overflow: visible;
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}
</style> 