---
import { profile } from "../data/site";

const systems = [
  { label: "everybody-eats", href: "#work-ee", tone: "signal" },
  { label: "fair-food", href: "#work-ff", tone: "signal" },
  { label: "open-banking-api", href: "#experience", tone: "route" },
  { label: "census-pipeline", href: "#experience", tone: "violet" },
  { label: "aws", href: "#certs", tone: "violet" },
];
---

<section id="hero" class="section hero">
  <article class="panel hero-panel">
    <header class="panel-chrome">
      <span class="dot"></span>
      <span class="svc-tag">svc-00</span>
      <span class="title">svc://control-plane</span>
      <span class="chrome-host">root@malin.nz</span>
      <span class="status">
        <span class="status-dot"></span>
        all green
      </span>
      <span class="winbtns" aria-hidden="true"><i></i><i></i><i></i></span>
    </header>

    <div id="topo-wrap" class="topo-wrap">
      <canvas
        id="topo-canvas"
        role="img"
        aria-label="Live service topology of systems Malin has built: front-end edge apps (everybody-eats, fair-food) routing through .NET and Node compute, Kubernetes and ArgoCD platform, AWS and Azure cloud, into Postgres and Redis data stores."
      ></canvas>
      <div id="topo-tip" class="topo-tip font-mono" aria-hidden="true"></div>

      <div class="hud">
        <p class="hud-kicker font-mono">// senior full-stack engineer · technical lead</p>
        <h1 class="hud-name font-display">Malin Malliya&nbsp;Wadu</h1>
        <p class="hud-role">{profile.tagline}</p>
        <p class="boot font-mono" data-bootline="$ establishing connection ... 200 OK"></p>
        <div class="hud-cta">
          <a href="#contact" class="btn btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 6h16v12H4z" stroke-linejoin="round"/><path d="m4 7 8 6 8-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Open a conversation
          </a>
          <a href={profile.cv} download class="btn btn-ghost">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Pull CV (PDF)
          </a>
        </div>
      </div>
    </div>

    <nav class="hero-systems font-mono" aria-label="Live systems index">
      <span class="hsys-label">live systems:</span>
      <ul>
        {
          systems.map((s) => (
            <li>
              <a href={s.href} class={`hsys tone-${s.tone}`}>
                <span class="hsys-dot" />
                {s.label}
                <span class="hsys-arrow">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </article>
</section>

<style>
  .hero {
    margin-top: clamp(0.75rem, 2vw, 1.4rem);
  }
  .chrome-host {
    color: var(--fg-faint);
    margin-left: 0.2rem;
  }
  @media (max-width: 600px) {
    .chrome-host {
      display: none;
    }
  }

  .topo-wrap {
    position: relative;
    height: clamp(600px, 78vh, 720px);
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    /* Static dot grid lives in CSS so the canvas only paints edges/packets/nodes. */
    background-image: radial-gradient(rgba(134, 150, 168, 0.13) 1px, transparent 1.6px);
    background-size: 28px 28px;
    background-position: 18px 24px;
  }
  #topo-canvas {
    position: absolute;
    inset: 0;
    display: block;
  }

  /* HUD - full-width cinematic bottom band */
  .hud {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: clamp(1.25rem, 3vw, 2.2rem) clamp(1.25rem, 3vw, 2.4rem) clamp(1.4rem, 3vw, 2.2rem);
    background: linear-gradient(
      180deg,
      rgba(8, 11, 17, 0) 0%,
      rgba(8, 11, 17, 0) 48%,
      rgba(8, 11, 17, 0.8) 70%,
      rgba(8, 11, 17, 0.97) 100%
    );
    border-radius: 0 0 14px 14px;
    pointer-events: none;
  }
  .hud > * {
    pointer-events: auto;
    position: relative;
    max-width: 40rem;
  }
  .hud-kicker {
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    color: var(--signal);
    margin-bottom: 0.8rem;
  }
  .hud-name {
    font-weight: 600;
    font-size: clamp(2.2rem, 5.3vw, 3.85rem);
    line-height: 0.98;
    letter-spacing: -0.025em;
    color: var(--fg);
    margin-bottom: 0.65rem;
    text-wrap: balance;
  }
  .hud-role {
    color: var(--fg-dim);
    font-size: clamp(0.98rem, 1.5vw, 1.15rem);
    line-height: 1.5;
    max-width: 34rem;
    margin-bottom: 0.9rem;
  }
  .boot {
    font-size: 0.74rem;
    color: var(--fg-faint);
    min-height: 1.1rem;
    margin-bottom: 1.2rem;
    white-space: nowrap;
  }
  .boot::after {
    content: "▋";
    color: var(--signal);
    animation: caret 1s steps(1) infinite;
    margin-left: 1px;
  }
  .boot.boot-done::after {
    animation: none;
    opacity: 0;
  }
  @keyframes caret {
    50% { opacity: 0; }
  }
  .hud-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  /* Tooltip */
  .topo-tip {
    position: absolute;
    z-index: 20;
    transform: translate(-50%, -100%);
    pointer-events: none;
    background: var(--inset);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0.5rem 0.7rem;
    min-width: 140px;
    max-width: 240px;
    opacity: 0;
    transition: opacity 0.14s var(--ease);
    box-shadow: 0 14px 30px -16px rgba(0, 0, 0, 0.9);
  }
  .topo-tip.below {
    transform: translate(-50%, 0);
  }
  .topo-tip.show {
    opacity: 1;
  }
  /* These spans are injected via JS (innerHTML), so they carry no scoped
     attribute - the rules must be :global to reach them. */
  .topo-tip :global(.tip-label) {
    display: block;
    font-size: 0.78rem;
    color: var(--fg);
    font-weight: 500;
    line-height: 1.3;
  }
  .topo-tip :global(.tip-sub) {
    display: block;
    font-size: 0.68rem;
    color: var(--fg-dim);
    margin-top: 0.2rem;
    line-height: 1.35;
  }
  .topo-tip :global(.tip-go) {
    display: block;
    font-size: 0.66rem;
    color: var(--route);
    margin-top: 0.35rem;
  }
  .topo-tip[data-tone="violet"] :global(.tip-go) { color: var(--violet); }

  /* Systems index */
  .hero-systems {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    padding: 0.85rem clamp(1rem, 3vw, 1.6rem);
    font-size: 0.72rem;
  }
  .hsys-label {
    color: var(--fg-faint);
    letter-spacing: 0.05em;
  }
  .hero-systems ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .hsys {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.26rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--tile);
    color: var(--fg-dim);
    transition: border-color 0.16s var(--ease), color 0.16s var(--ease), transform 0.16s var(--ease);
  }
  .hsys:hover {
    color: var(--fg);
    transform: translateY(-1px);
  }
  .hsys-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex: none;
  }
  .tone-signal .hsys-dot { background: var(--signal); box-shadow: 0 0 6px var(--signal-glow); }
  .tone-route .hsys-dot { background: var(--route); box-shadow: 0 0 6px var(--route-glow); }
  .tone-violet .hsys-dot { background: var(--violet); box-shadow: 0 0 6px rgba(167,139,250,0.5); }
  .tone-signal:hover { border-color: rgba(61,220,151,0.5); }
  .tone-route:hover { border-color: rgba(77,163,255,0.5); }
  .tone-violet:hover { border-color: rgba(167,139,250,0.5); }
  .hsys-arrow {
    color: var(--fg-faint);
    font-size: 0.7rem;
  }

  /* Mobile: hide canvas, HUD flows in normal layout */
  @media (max-width: 860px) {
    .topo-wrap {
      height: auto;
    }
    #topo-canvas {
      display: none;
    }
    .topo-tip {
      display: none;
    }
    .hud {
      position: static;
      width: 100%;
      background: none;
      padding: clamp(1.5rem, 6vw, 2rem);
    }
    .boot {
      white-space: normal;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .boot::after { animation: none; }
  }
</style>

<script>
  import "../scripts/topology.ts";
</script>
