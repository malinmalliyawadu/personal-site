---
interface Props {
  name: string;
  icon: string;
}

import { Image } from 'astro:assets';
const { name, icon } = Astro.props;
---

<li class="skill-chip">
  <Image
    src={icon}
    alt=""
    width={32}
    height={32}
    class="skill-chip-icon"
    loading="lazy"
  />
  <span>{name}</span>
</li>

<style>
  .skill-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--line);
    background: var(--paper-raised);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ink-soft);
    transition: border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .skill-chip:hover {
    border-color: var(--ink);
    color: var(--ink);
    transform: translateY(-1px);
  }

  .skill-chip-icon {
    width: 1rem;
    height: 1rem;
    object-fit: contain;
  }
</style>
