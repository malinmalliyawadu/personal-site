---
interface Props {
  name: string;
  icon: string;
}

const { name, icon } = Astro.props;
---

<div class="flex flex-col items-center gap-2 bg-gray-800 bg-opacity-50 rounded-xl p-4 hover:bg-gray-700 hover:scale-105 transition-all duration-300">
  <img 
    src={icon} 
    alt={name} 
    class="w-10 h-10 object-contain"
  />
  <span class="text-sm font-medium">{name}</span>
</div> 