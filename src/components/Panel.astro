---
interface Props {
  id: string;
  svc?: string;
  path: string;
  status?: string;
  tone?: "signal" | "route" | "violet" | "amber";
  pad?: boolean;
  class?: string;
}

const {
  id,
  svc,
  path,
  status = "200 OK",
  tone = "signal",
  pad = true,
  class: extra = "",
} = Astro.props;
---

<section id={id} class={`section ${extra}`}>
  <article class="panel reveal">
    <header class={`panel-chrome tone-${tone}`}>
      <span class="dot"></span>
      {svc && <span class="svc-tag">{svc}</span>}
      <span class="title">{path}</span>
      <span class="status">
        <span class="status-dot"></span>
        {status}
      </span>
      <span class="winbtns" aria-hidden="true"><i></i><i></i><i></i></span>
    </header>
    <div class={pad ? "panel-body" : ""}>
      <slot />
    </div>
  </article>
</section>

<style>
  .svc-tag {
    color: var(--fg-faint);
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 0.02rem 0.34rem;
    font-size: 0.62rem;
    letter-spacing: 0.05em;
  }
  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 7px currentColor;
  }
  .tone-route .dot { background: var(--route); box-shadow: 0 0 8px var(--route-glow); }
  .tone-route .status { color: var(--route); }
  .tone-violet .dot { background: var(--violet); box-shadow: 0 0 8px rgba(167, 139, 250, 0.5); }
  .tone-violet .status { color: var(--violet); }
  .tone-amber .dot { background: var(--amber); box-shadow: 0 0 8px rgba(255, 180, 84, 0.5); }
  .tone-amber .status { color: var(--amber); }

  @media (max-width: 560px) {
    .winbtns { display: none; }
    .panel-chrome { font-size: 0.64rem; }
  }
</style>
