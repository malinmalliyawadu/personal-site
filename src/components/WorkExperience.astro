---
import { Image } from 'astro:assets';

interface Job {
  company: string;
  role: string;
  period: string;
  description: string;
  technologies: string[];
  logo?: string;
  border?: boolean;
  logoBg?: boolean;
}

interface Props {
  jobs: Job[];
}

const { jobs } = Astro.props;
---

<ol class="border-y border-line divide-y divide-line">
  {jobs.map((job) => (
    <li class="job-row grid md:grid-cols-12 gap-3 md:gap-8 py-8 md:py-10 animate-on-scroll">
      <div class="md:col-span-3 font-mono text-[0.7rem] font-medium tracking-[0.15em] uppercase text-ink-faint md:pt-2">
        {job.period}
      </div>

      <div class="md:col-span-9">
        <div class="flex items-start gap-4 mb-3">
          {job.logo && (
            <div class="job-logo flex-shrink-0">
              <Image
                src={job.logo}
                alt={`${job.company} logo`}
                width={96}
                height={96}
                class="w-full h-full object-contain"
              />
            </div>
          )}
          <div>
            <h3 class="font-display text-2xl md:text-3xl font-semibold text-ink leading-tight">{job.company}</h3>
            <p class="font-mono text-[0.7rem] font-medium tracking-[0.15em] uppercase text-accent mt-1.5">{job.role}</p>
          </div>
        </div>

        <p class="text-ink-soft leading-relaxed max-w-2xl mb-4">{job.description}</p>

        <p class="font-mono text-[0.7rem] tracking-[0.08em] text-ink-faint">
          {job.technologies.join("  ·  ")}
        </p>
      </div>
    </li>
  ))}
</ol>

<style>
  .job-logo {
    width: 3rem;
    height: 3rem;
    padding: 0.4rem;
    background: #ffffff;
    border: 1px solid var(--line);
  }
</style>
