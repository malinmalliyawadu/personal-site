---
// Inspired by Magic UI's backgrounds
---

<div class="fixed inset-0 -z-10 overflow-hidden">
  <!-- Base gradient layer -->
  <div class="absolute inset-0 bg-gradient-to-br from-gray-950 via-indigo-950/20 to-purple-950/20"></div>
  
  <!-- Magic warp effect -->
  <div class="magic-warp">
    <div class="warp-layer"></div>
  </div>
  
</div>

<style>
  /* Base background styles */
  .magic-warp {
    position: absolute;
    inset: 0;
    overflow: hidden;
    opacity: 0.5;
  }
  
  .warp-layer {
    position: absolute;
    inset: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(
      ellipse at center,
      rgba(99, 102, 241, 0.15) 0%,
      rgba(139, 92, 246, 0.1) 25%,
      rgba(17, 24, 39, 0) 80%
    );
    animation: warpSpin 60s linear infinite;
  }
  
  @keyframes warpSpin {
    0% {
      transform: rotate(0deg) scale(1);
    }
    50% {
      transform: rotate(180deg) scale(1.2);
    }
    100% {
      transform: rotate(360deg) scale(1);
    }
  }
  
  /* Noise texture for visual depth */
  .noise-texture {
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    opacity: 0.03;
    mix-blend-mode: overlay;
  }
  
  /* Animated gradient blobs */
  .gradient-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.2;
    pointer-events: none;
  }
  
  .blob-1 {
    width: 35vw;
    height: 35vw;
    top: 20%;
    right: 15%;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.6) 0%, rgba(79, 70, 229, 0.4) 50%, transparent 80%);
    animation: blobFloat 30s ease-in-out infinite;
  }
  
  .blob-2 {
    width: 25vw;
    height: 25vw;
    bottom: 15%;
    left: 10%;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.6) 0%, rgba(124, 58, 237, 0.4) 50%, transparent 80%);
    animation: blobFloat 25s ease-in-out infinite reverse;
  }
  
  .blob-3 {
    width: 20vw;
    height: 20vw;
    top: 60%;
    left: 30%;
    background: radial-gradient(circle, rgba(79, 70, 229, 0.6) 0%, rgba(67, 56, 202, 0.4) 50%, transparent 80%);
    animation: blobFloat 28s ease-in-out infinite 5s;
  }
  
  @keyframes blobFloat {
    0% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(5%, 5%) scale(1.05); }
    50% { transform: translate(-5%, 8%) scale(0.95); }
    75% { transform: translate(-8%, -4%) scale(1.02); }
    100% { transform: translate(0, 0) scale(1); }
  }
  
  /* Star field */
  .star-field {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  
  .star {
    position: absolute;
    background-color: #fff;
    border-radius: 50%;
    opacity: 0;
    animation: twinkle var(--twinkle-duration) ease-in-out infinite alternate var(--twinkle-delay);
  }
  
  @keyframes twinkle {
    0% { opacity: 0.2; transform: scale(0.8); }
    100% { opacity: 0.7; transform: scale(1); }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Star field generation
    const starField = document.getElementById('star-field');
    if (!starField) return;
    
    const viewportWidth = window.innerWidth;
    const viewportHeight = window.innerHeight;
    const starDensity = 0.00005; // Adjust for more or fewer stars
    const starCount = Math.floor(viewportWidth * viewportHeight * starDensity);
    
    // Create stars
    for (let i = 0; i < starCount; i++) {
      const star = document.createElement('div');
      star.className = 'star';
      
      // Random properties for variety
      const size = Math.random() * 2 + 0.5;
      const x = Math.random() * 100;
      const y = Math.random() * 100;
      const twinkleSpeed = Math.random() * 5 + 3;
      const twinkleDelay = Math.random() * 5;
      
      // Apply styles
      star.style.width = `${size}px`;
      star.style.height = `${size}px`;
      star.style.left = `${x}%`;
      star.style.top = `${y}%`;
      star.style.setProperty('--twinkle-duration', `${twinkleSpeed}s`);
      star.style.setProperty('--twinkle-delay', `${twinkleDelay}s`);
      
      // Apply glow for brighter stars
      if (Math.random() > 0.7) {
        star.style.boxShadow = `0 0 ${Math.random() * 3 + 1}px rgba(255, 255, 255, 0.7)`;
      }
      
      starField.appendChild(star);
    }
  });
</script> 