---
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="fixed top-0 z-50 left-1/2 transform -translate-x-1/2 mt-6 bg-black/20 backdrop-blur-2xl border border-white/10 shadow-2xl rounded-2xl max-w-7xl w-[95%] navbar-header transition-all duration-300">
  <div class="container mx-auto px-8">
    <nav class="flex items-center justify-between h-20">
      <a href="#hero" class="text-2xl font-black text-white group hover-animated navbar-logo">
        <span class="bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">Malin</span><span class="text-purple-400">.nz</span>
      </a>
      
      <div class="hidden md:flex items-center space-x-8">
        <a href="#about" class="text-gray-300 hover:text-white transition-colors nav-link">About</a>
        <a href="#experience" class="text-gray-300 hover:text-white transition-colors nav-link">Experience</a>
        <a href="#skills" class="text-gray-300 hover:text-white transition-colors nav-link">Skills</a>
        <a href="#certifications" class="text-gray-300 hover:text-white transition-colors nav-link">Certifications</a>
        <a href="#projects" class="text-gray-300 hover:text-white transition-colors nav-link">Projects</a>
        <a href="#contact" class="text-gray-300 hover:text-white transition-colors nav-link">Contact</a>
        <a 
          href="/cv/Malin_CV.pdf" 
          target="_blank"
          rel="noopener noreferrer" 
          class="nav-resume-btn inline-flex items-center px-6 py-3 text-sm font-semibold rounded-xl transition-all duration-300 bg-gradient-to-r from-purple-500 to-pink-500 text-white hover:from-purple-600 hover:to-pink-600 hover:shadow-xl hover:shadow-purple-500/40 transform hover:-translate-y-1 hover:scale-105"
        >
          Resume
        </a>
        <ThemeToggle />
      </div>
      
      <div class="md:hidden flex items-center space-x-2">
        <ThemeToggle />
        <button id="mobile-menu-button" class="flex items-center p-3 rounded-xl bg-white/10 border border-white/20 hover:bg-white/20 hover:border-purple-500/50 transition-all duration-300 hover:shadow-lg hover:shadow-purple-500/20 backdrop-blur-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-purple-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </nav>
  </div>
  
  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-700 rounded-b-xl overflow-hidden">
    <div class="flex flex-col px-4 pt-2 pb-3 space-y-1">
      <a href="#about" class="text-gray-300 hover:text-white px-3 py-2 rounded-md hover:bg-gray-700 transition-colors nav-link">About</a>
      <a href="#experience" class="text-gray-300 hover:text-white px-3 py-2 rounded-md hover:bg-gray-700 transition-colors nav-link">Experience</a>
      <a href="#skills" class="text-gray-300 hover:text-white px-3 py-2 rounded-md hover:bg-gray-700 transition-colors nav-link">Skills</a>
      <a href="#certifications" class="text-gray-300 hover:text-white px-3 py-2 rounded-md hover:bg-gray-700 transition-colors nav-link">Certifications</a>
      <a href="#projects" class="text-gray-300 hover:text-white px-3 py-2 rounded-md hover:bg-gray-700 transition-colors nav-link">Projects</a>
      <a href="#contact" class="text-gray-300 hover:text-white px-3 py-2 rounded-md hover:bg-gray-700 transition-colors nav-link">Contact</a>
      <a 
        href="/cv/Malin_CV.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="nav-resume-btn inline-flex items-center justify-center px-4 py-2 text-sm font-medium rounded-md transition-all duration-300 bg-gradient-to-r from-indigo-500 to-purple-500 text-white hover:from-indigo-600 hover:to-purple-600 hover:shadow-lg hover:shadow-indigo-500/30 transform hover:-translate-y-0.5"
      >
        Resume
      </a>
    </div>
  </div>
</header>

<script>
  // Toggle mobile menu
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  
  if (mobileMenuButton && mobileMenu) {
    mobileMenuButton.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
    
    // Close mobile menu when clicking on links
    const mobileLinks = mobileMenu.querySelectorAll('a');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
      });
    });
  }

  // Track active section
  document.addEventListener('DOMContentLoaded', () => {
    const sections = document.querySelectorAll('section[id]');
    const navLinks = document.querySelectorAll('.nav-link');
    
    function setActiveLink() {
      let scrollY = window.pageYOffset;
      
      // Find the current section
      sections.forEach(section => {
        const sectionTop = (section as HTMLElement).offsetTop - 100;
        const sectionHeight = (section as HTMLElement).offsetHeight;
        const sectionId = section.getAttribute('id');
        
        if (scrollY >= sectionTop && scrollY < sectionTop + sectionHeight) {
          // Remove active class from all links
          navLinks.forEach(link => {
            link.classList.remove('active');
          });
          
          // Add active class to corresponding nav links
          document.querySelectorAll(`.nav-link[href="#${sectionId}"]`).forEach(link => {
            link.classList.add('active');
          });
        }
      });
    }
    
    window.addEventListener('scroll', setActiveLink);
    setActiveLink(); // Set initial state
  });
</script>

<style>
  .hover-animated {
    position: relative;
    display: inline-block;
    transition: all 0.3s ease;
  }
  
  .hover-animated::after {
    content: '';
    position: absolute;
    width: 100%;
    transform: scaleX(0);
    height: 3px;
    bottom: 0;
    left: 0;
    background: linear-gradient(90deg, rgba(129, 140, 248, 1), rgba(168, 85, 247, 1));
    transform-origin: bottom right;
    transition: transform 0.3s ease-out;
  }
  
  .hover-animated:hover {
    transform: translateY(-2px);
    text-shadow: 0 0 8px rgba(139, 92, 246, 0.5);
  }
  
  .hover-animated:hover::after {
    transform: scaleX(1);
    transform-origin: bottom left;
  }
  
  .nav-link {
    position: relative;
    padding-bottom: 2px;
  }
  
  .nav-link::after {
    content: '';
    position: absolute;
    width: 100%;
    transform: scaleX(0);
    height: 2px;
    bottom: 0;
    left: 0;
    background: linear-gradient(90deg, rgba(129, 140, 248, 1), rgba(168, 85, 247, 1));
    transform-origin: bottom right;
    transition: transform 0.3s ease-out;
  }
  
  .nav-link:hover::after,
  .nav-link.active::after {
    transform: scaleX(1);
    transform-origin: bottom left;
  }
  
  .nav-link.active {
    color: white;
    text-shadow: 0 0 8px rgba(139, 92, 246, 0.3);
  }
  /* Light mode styles for navbar */
  :global(html.light) .navbar-header {
    background: rgba(255, 255, 255, 0.7);
    border-color: rgba(0, 0, 0, 0.1);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
  }
  
  :global(html.light) .navbar-logo {
    color: #1f2937;
  }
  
  :global(html.light) .navbar-logo span:last-child {
    color: #4f46e5;
  }
  
  :global(html.light) .nav-link {
    color: #4b5563;
  }
  
  :global(html.light) .nav-link:hover {
    color: #1f2937;
  }
  
  :global(html.light) .nav-link.active {
    color: #1f2937;
    text-shadow: 0 0 8px rgba(79, 70, 229, 0.3);
  }
  
  :global(html.light) #mobile-menu-button {
    background: rgba(255, 255, 255, 0.9);
    border-color: rgba(0, 0, 0, 0.1);
  }
  
  :global(html.light) #mobile-menu-button:hover {
    background: rgba(255, 255, 255, 1);
    border-color: #6366f1;
  }
  
  :global(html.light) #mobile-menu-button svg {
    color: #6366f1;
  }
  
  :global(html.light) #mobile-menu {
    background: rgba(255, 255, 255, 0.95);
    border-color: rgba(0, 0, 0, 0.1);
  }
  
  :global(html.light) #mobile-menu a {
    color: #4b5563;
  }
  
  :global(html.light) #mobile-menu a:hover {
    color: #1f2937;
    background: rgba(99, 102, 241, 0.1);
  }
  
  /* Light mode Resume button fix */
  :global(html.light) .nav-resume-btn {
    background: linear-gradient(to right, #6366f1, #8b5cf6);
    color: white !important;
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.2);
  }
  
  :global(html.light) .nav-resume-btn:hover {
    background: linear-gradient(to right, #4f46e5, #7c3aed);
    color: white !important;
    box-shadow: 0 6px 16px rgba(99, 102, 241, 0.3);
  }
</style>