---
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="fixed top-0 z-50 left-1/2 transform -translate-x-1/2 mt-6 bg-black/20 backdrop-blur-2xl border border-white/10 shadow-2xl rounded-2xl max-w-7xl w-[95%] navbar-header transition-all duration-300">
  <div class="container mx-auto px-8">
    <nav class="flex items-center justify-between h-20">
      <a href="#hero" class="text-2xl font-black text-white group hover-animated navbar-logo">
        <span class="bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">Malin</span><span class="text-purple-400">.nz</span>
      </a>

      <div class="hidden md:flex items-center space-x-8">
        <a href="#about" class="text-gray-300 hover:text-white transition-colors nav-link">About</a>
        <a href="#experience" class="text-gray-300 hover:text-white transition-colors nav-link">Experience</a>
        <a href="#skills" class="text-gray-300 hover:text-white transition-colors nav-link">Skills</a>
        <a href="#certifications" class="text-gray-300 hover:text-white transition-colors nav-link">Certifications</a>
        <a href="#projects" class="text-gray-300 hover:text-white transition-colors nav-link">Projects</a>
        <a href="#contact" class="text-gray-300 hover:text-white transition-colors nav-link">Contact</a>
        <a
          href="/cv/Malin_CV.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="nav-resume-btn inline-flex items-center px-6 py-3 text-sm font-semibold rounded-xl transition-all duration-300 bg-gradient-to-r from-purple-500 to-pink-500 text-white hover:from-purple-600 hover:to-pink-600 hover:shadow-xl hover:shadow-purple-500/40 transform hover:-translate-y-1 hover:scale-105"
        >
          Resume
        </a>
        <ThemeToggle />
      </div>

      <div class="md:hidden flex items-center space-x-2">
        <ThemeToggle />
        <button id="mobile-menu-button" class="hamburger flex items-center justify-center w-11 h-11 rounded-xl bg-white/10 border border-white/20 hover:bg-white/20 hover:border-purple-500/50 transition-all duration-300 hover:shadow-lg hover:shadow-purple-500/20 backdrop-blur-sm" aria-label="Toggle menu">
          <div class="hamburger-lines">
            <span></span>
            <span></span>
            <span></span>
          </div>
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="mobile-menu md:hidden">
    <div class="px-6 py-3 space-y-1">
      <a href="#about" class="mobile-nav-link nav-link">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
        About
      </a>
      <a href="#experience" class="mobile-nav-link nav-link">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
        Experience
      </a>
      <a href="#skills" class="mobile-nav-link nav-link">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
        Skills
      </a>
      <a href="#certifications" class="mobile-nav-link nav-link">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" /></svg>
        Certifications
      </a>
      <a href="#projects" class="mobile-nav-link nav-link">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
        Projects
      </a>
      <a href="#contact" class="mobile-nav-link nav-link">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
        Contact
      </a>
      <div class="pt-2">
        <a
          href="/cv/Malin_CV.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="nav-resume-btn flex items-center justify-center gap-2 px-4 py-3 text-sm font-semibold rounded-xl transition-all duration-300 bg-gradient-to-r from-purple-500 to-pink-500 text-white hover:from-purple-600 hover:to-pink-600 hover:shadow-lg hover:shadow-purple-500/30"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          Resume
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  if (mobileMenuButton && mobileMenu) {
    mobileMenuButton.addEventListener('click', () => {
      const isOpen = mobileMenuButton.classList.toggle('is-active');
      mobileMenu.classList.toggle('is-open', isOpen);
    });

    const mobileLinks = mobileMenu.querySelectorAll('a');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenuButton.classList.remove('is-active');
        mobileMenu.classList.remove('is-open');
      });
    });
  }

  // Track active section
  document.addEventListener('DOMContentLoaded', () => {
    const sections = document.querySelectorAll('section[id]');
    const navLinks = document.querySelectorAll('.nav-link');

    function setActiveLink() {
      let scrollY = window.pageYOffset;

      sections.forEach(section => {
        const sectionTop = (section as HTMLElement).offsetTop - 100;
        const sectionHeight = (section as HTMLElement).offsetHeight;
        const sectionId = section.getAttribute('id');

        if (scrollY >= sectionTop && scrollY < sectionTop + sectionHeight) {
          navLinks.forEach(link => {
            link.classList.remove('active');
          });

          document.querySelectorAll(`.nav-link[href="#${sectionId}"]`).forEach(link => {
            link.classList.add('active');
          });
        }
      });
    }

    window.addEventListener('scroll', setActiveLink);
    setActiveLink();
  });
</script>

<style>
  /* Animated hamburger */
  .hamburger-lines {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 20px;
    height: 20px;
  }

  .hamburger-lines span {
    display: block;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, #c084fc, #e879f9);
    border-radius: 2px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    transform-origin: center;
  }

  .hamburger.is-active .hamburger-lines span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .hamburger.is-active .hamburger-lines span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  .hamburger.is-active .hamburger-lines span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile menu slide */
  .mobile-menu {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    border-top: 1px solid transparent;
  }

  .mobile-menu > div {
    overflow: hidden;
  }

  .mobile-menu.is-open {
    grid-template-rows: 1fr;
    border-color: rgba(255, 255, 255, 0.1);
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    color: rgba(209, 213, 219, 1);
    font-weight: 500;
    font-size: 0.9375rem;
    line-height: 1.25rem;
    transition: all 0.2s ease;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.active {
    color: white;
    background: rgba(255, 255, 255, 0.08);
  }

  .mobile-nav-link svg {
    opacity: 0.5;
    transition: opacity 0.2s ease;
  }

  .mobile-nav-link:hover svg,
  .mobile-nav-link.active svg {
    opacity: 1;
  }

  /* Existing styles */
  .hover-animated {
    position: relative;
    display: inline-block;
    transition: all 0.3s ease;
  }

  .hover-animated::after {
    content: '';
    position: absolute;
    width: 100%;
    transform: scaleX(0);
    height: 3px;
    bottom: 0;
    left: 0;
    background: linear-gradient(90deg, rgba(129, 140, 248, 1), rgba(168, 85, 247, 1));
    transform-origin: bottom right;
    transition: transform 0.3s ease-out;
  }

  .hover-animated:hover {
    transform: translateY(-2px);
    text-shadow: 0 0 8px rgba(139, 92, 246, 0.5);
  }

  .hover-animated:hover::after {
    transform: scaleX(1);
    transform-origin: bottom left;
  }

  .nav-link:not(.mobile-nav-link) {
    position: relative;
    padding-bottom: 2px;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    width: 100%;
    transform: scaleX(0);
    height: 2px;
    bottom: 0;
    left: 0;
    background: linear-gradient(90deg, rgba(129, 140, 248, 1), rgba(168, 85, 247, 1));
    transform-origin: bottom right;
    transition: transform 0.3s ease-out;
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    transform: scaleX(1);
    transform-origin: bottom left;
  }

  .nav-link.active {
    color: white;
    text-shadow: 0 0 8px rgba(139, 92, 246, 0.3);
  }

  /* Mobile nav links don't need underline */
  .mobile-nav-link::after {
    display: none;
  }

  /* Light mode styles for navbar */
  :global(html.light) .navbar-header {
    background: rgba(255, 255, 255, 0.7);
    border-color: rgba(0, 0, 0, 0.1);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
  }

  :global(html.light) .navbar-logo {
    color: #1f2937;
  }

  :global(html.light) .navbar-logo span:last-child {
    color: #4f46e5;
  }

  :global(html.light) .nav-link {
    color: #4b5563;
  }

  :global(html.light) .nav-link:hover {
    color: #1f2937;
  }

  :global(html.light) .nav-link.active {
    color: #1f2937;
    text-shadow: 0 0 8px rgba(79, 70, 229, 0.3);
  }

  :global(html.light) #mobile-menu-button {
    background: rgba(255, 255, 255, 0.9);
    border-color: rgba(0, 0, 0, 0.1);
  }

  :global(html.light) #mobile-menu-button:hover {
    background: rgba(255, 255, 255, 1);
    border-color: #6366f1;
  }

  :global(html.light) .hamburger-lines span {
    background: linear-gradient(90deg, #6366f1, #8b5cf6);
  }

  :global(html.light) .mobile-menu.is-open {
    border-color: rgba(0, 0, 0, 0.1);
  }

  :global(html.light) .mobile-nav-link {
    color: #4b5563;
  }

  :global(html.light) .mobile-nav-link:hover,
  :global(html.light) .mobile-nav-link.active {
    color: #1f2937;
    background: rgba(99, 102, 241, 0.08);
  }

  :global(html.light) .nav-resume-btn {
    background: linear-gradient(to right, #6366f1, #8b5cf6);
    color: white !important;
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.2);
  }

  :global(html.light) .nav-resume-btn:hover {
    background: linear-gradient(to right, #4f46e5, #7c3aed);
    color: white !important;
    box-shadow: 0 6px 16px rgba(99, 102, 241, 0.3);
  }
</style>