---
const markers = [
  { svc: "00", id: "hero", label: "entry" },
  { svc: "01", id: "trusted", label: "deps" },
  { svc: "02", id: "capabilities", label: "services" },
  { svc: "03", id: "work", label: "projects" },
  { svc: "04", id: "stack", label: "stack" },
  { svc: "05", id: "experience", label: "log" },
  { svc: "06", id: "certs", label: "certs" },
  { svc: "07", id: "contact", label: "connect" },
];
---

<nav class="rail font-mono" aria-label="Section navigation">
  <a href="#hero" class="rail-mark" aria-label="Top">
    <svg viewBox="0 0 32 32" width="22" height="22" fill="none" aria-hidden="true">
      <path d="M9 11 16 16 M16 16 23 11 M16 16 16 24" stroke="#243040" stroke-width="2" stroke-linecap="round" />
      <circle cx="9" cy="11" r="3" fill="#4da3ff" />
      <circle cx="23" cy="11" r="3" fill="#a78bfa" />
      <circle cx="16" cy="24" r="3" fill="#4da3ff" />
      <circle cx="16" cy="16" r="4" fill="#3ddc97" />
    </svg>
  </a>

  <ul class="rail-list">
    {
      markers.map((m) => (
        <li>
          <a href={`#${m.id}`} class="rail-item" data-target={m.id}>
            <span class="rail-svc">{m.svc}</span>
            <span class="rail-tip">{m.label}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="rail-conn" aria-hidden="true">
    <span class="rail-conn-dot"></span>
    <span class="rail-conn-text">live</span>
  </div>
</nav>

<style>
  .rail {
    position: fixed;
    top: var(--statusbar-h);
    bottom: 0;
    left: 0;
    width: var(--rail-w);
    z-index: 80;
    display: none;
    flex-direction: column;
    align-items: center;
    padding: 1.1rem 0 1rem;
    border-right: 1px solid var(--line);
    background: linear-gradient(180deg, rgba(15, 20, 28, 0.5), rgba(8, 11, 17, 0.2));
  }
  @media (min-width: 1100px) {
    .rail { display: flex; }
  }

  .rail-mark {
    margin-bottom: 1.5rem;
    opacity: 0.95;
    transition: transform 0.2s var(--ease);
  }
  .rail-mark:hover { transform: translateY(-1px) scale(1.04); }

  .rail-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    position: relative;
  }
  .rail-list::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 8px;
    bottom: 8px;
    width: 1px;
    background: var(--line);
    transform: translateX(-0.5px);
  }

  .rail-item {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 30px;
    border-radius: 7px;
    color: var(--fg-faint);
    font-size: 0.66rem;
    background: var(--base);
    transition: color 0.16s var(--ease), background 0.16s var(--ease);
  }
  .rail-svc { position: relative; z-index: 1; }
  .rail-item::before {
    content: "";
    position: absolute;
    left: -3px;
    top: 50%;
    height: 0;
    width: 2px;
    border-radius: 2px;
    background: var(--signal);
    transform: translateY(-50%);
    transition: height 0.2s var(--ease);
  }
  .rail-item:hover { color: var(--fg-dim); background: var(--tile); }
  .rail-item.is-active {
    color: var(--signal);
    background: var(--tile);
  }
  .rail-item.is-active::before { height: 18px; }

  .rail-tip {
    position: absolute;
    left: calc(100% + 8px);
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    background: var(--inset);
    border: 1px solid var(--line);
    color: var(--fg-dim);
    font-size: 0.64rem;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transform: translateX(-4px);
    transition: opacity 0.16s var(--ease), transform 0.16s var(--ease);
  }
  .rail-item:hover .rail-tip,
  .rail-item:focus-visible .rail-tip {
    opacity: 1;
    transform: translateX(0);
  }

  .rail-conn {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .rail-conn-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 8px var(--signal-glow);
    animation: railBlink 2.6s steps(1) infinite;
  }
  .rail-conn-text {
    writing-mode: vertical-rl;
    font-size: 0.6rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  @keyframes railBlink {
    0%, 60% { opacity: 1; }
    70%, 100% { opacity: 0.35; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rail-conn-dot { animation: none; }
  }
</style>

<script>
  const items = Array.from(document.querySelectorAll<HTMLElement>(".rail-item"));
  const byId = new Map(items.map((el) => [el.dataset.target, el]));
  const sections = items
    .map((el) => document.getElementById(el.dataset.target || ""))
    .filter((s): s is HTMLElement => Boolean(s));

  let current: string | null = null;
  const setActive = (id: string) => {
    if (id === current) return;
    current = id;
    items.forEach((el) => el.classList.toggle("is-active", el.dataset.target === id));
  };

  const io = new IntersectionObserver(
    (entries) => {
      const visible = entries
        .filter((e) => e.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
      if (visible[0]) setActive(visible[0].target.id);
    },
    { rootMargin: "-30% 0px -55% 0px", threshold: [0, 0.25, 0.5, 1] }
  );
  sections.forEach((s) => io.observe(s));
</script>
