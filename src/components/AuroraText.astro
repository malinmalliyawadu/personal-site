---
// AuroraText.astro - Inspired by Magic UI's Aurora Text component
// https://magicui.design/docs/components/aurora-text

interface Props {
  class?: string;
  className?: string;
  colors?: string[];
  speed?: number;
}

const { 
  class: className, 
  className: classNameAlias, 
  colors = ["#818cf8", "#c084fc", "#6366f1", "#a855f7"],
  speed = 1 
} = Astro.props;

// Merge class and className (for flexibility)
const classList = [className, classNameAlias].filter(Boolean).join(' ');
---

<span class={`aurora-wrapper ${classList}`}>
  <slot />
</span>

<style define:vars={{
  colorOne: colors[0],
  colorTwo: colors[1],
  colorThree: colors[2],
  colorFour: colors[3],
  animationDuration: `${10 / speed}s`
}}>
  .aurora-wrapper {
    display: inline-block;
    position: relative;
    color: transparent;
    background: linear-gradient(
      to right,
      var(--colorOne),
      var(--colorTwo),
      var(--colorThree),
      var(--colorFour),
      var(--colorOne)
    );
    background-size: 200% auto;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: aurora var(--animationDuration) linear infinite;
    will-change: background-position;
  }

  @keyframes aurora {
    to {
      background-position: 200% center;
    }
  }
</style> 