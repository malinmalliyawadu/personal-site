---
interface Props {
  title: string;
  description: string;
  tags: string[];
  image?: string;
  github: string;
  demo?: string;
}

import { Image } from 'astro:assets';
const { title, description, tags, image, github, demo } = Astro.props;
---

<div class="project-card relative group overflow-hidden rounded-xl border border-gray-800 bg-gradient-to-br from-gray-900 to-gray-950">
  <div class="p-6 flex flex-col h-full z-10 relative">
    {image && (
      <div class="mb-6 rounded-lg overflow-hidden h-48 shadow-lg">
        <Image
          src={image}
          alt={title}
          width={800}
          height={450}
          class="w-full h-full object-cover object-top transform group-hover:scale-105 transition-transform duration-500 ease-out"
        />
      </div>
    )}
    
    <h3 class="text-xl font-bold mb-2 text-white group-hover:text-indigo-300 transition-colors">{title}</h3>
    <p class="text-gray-300 mb-4 flex-grow text-sm leading-relaxed">{description}</p>
    
    <div class="flex flex-wrap gap-2 mb-4">
      {tags.map((tag) => (
        <span class="tag-pill">{tag}</span>
      ))}
    </div>
    
    <div class="flex gap-3 mt-auto">
      <a
        href={github}
        target="_blank"
        rel="noopener noreferrer"
        class="card-button card-button-github"
        aria-label="View GitHub repository"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
          <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"></path>
        </svg>
        GitHub
      </a>
      {demo && (
        <a
          href={demo}
          target="_blank"
          rel="noopener noreferrer"
          class="card-button card-button-demo"
          aria-label="View live demo"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6"></path>
            <path d="M11 13l9 -9"></path>
            <path d="M15 4h5v5"></path>
          </svg>
          Live Demo
        </a>
      )}
    </div>
  </div>
</div>

<style>
  .project-card {
    position: relative;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2), 0 6px 6px rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(10px);
  }
  
  .project-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.3), 0 10px 10px rgba(0, 0, 0, 0.2);
    border-color: rgba(99, 102, 241, 0.4);
  }
  
  .project-card::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 0.75rem;
    padding: 1px;
    background: linear-gradient(
      to bottom right, 
      rgba(99, 102, 241, 0.3), 
      transparent 50%
    );
    mask: linear-gradient(#fff 0 0) content-box, 
          linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  
  .project-card:hover::after {
    opacity: 1;
  }
  
  .tag-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.6rem;
    font-size: 0.7rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.8);
    background: rgba(99, 102, 241, 0.15);
    border: 1px solid rgba(99, 102, 241, 0.25);
    border-radius: 9999px;
    transition: all 0.3s ease;
    margin-bottom: 0.25rem;
  }
  
  .card-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    font-weight: 500;
    border-radius: 0.5rem;
    transition: all 0.3s ease;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }
  
  .card-button-github {
    color: white;
    background-color: rgba(31, 41, 55, 0.8);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(75, 85, 99, 0.3);
  }
  
  .card-button-github:hover {
    background-color: rgba(55, 65, 81, 0.9);
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
  }
  
  .card-button-demo {
    color: white;
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.8), rgba(79, 70, 229, 0.8));
    backdrop-filter: blur(10px);
    border: 1px solid rgba(99, 102, 241, 0.4);
  }
  
  .card-button-demo:hover {
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.9), rgba(79, 70, 229, 0.9));
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(79, 70, 229, 0.4);
  }
  
  /* Light mode styles - Glassy white appearance */
  :global(html.light) .project-card {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0.5));
    border-color: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 
      0 8px 32px rgba(31, 38, 135, 0.15),
      inset 0 1px 0 rgba(255, 255, 255, 0.8),
      inset 0 -1px 0 rgba(255, 255, 255, 0.3);
  }
  
  :global(html.light) .project-card:hover {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.8), rgba(255, 255, 255, 0.6));
    border-color: rgba(99, 102, 241, 0.3);
    box-shadow: 
      0 12px 40px rgba(31, 38, 135, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      inset 0 -1px 0 rgba(255, 255, 255, 0.4);
  }
  
  :global(html.light) .project-card h3 {
    color: #1f2937;
  }
  
  :global(html.light) .project-card p {
    color: #4b5563;
  }
  
  :global(html.light) .tag-pill {
    color: #4f46e5;
    background: rgba(99, 102, 241, 0.1);
    border-color: rgba(99, 102, 241, 0.3);
  }
  
  :global(html.light) .card-button-github {
    background: rgba(255, 255, 255, 0.8);
    color: #1f2937;
    border-color: rgba(0, 0, 0, 0.1);
  }
  
  :global(html.light) .card-button-github:hover {
    background: rgba(255, 255, 255, 0.95);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
  }
  
  :global(html.light) .card-button-demo {
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.9), rgba(79, 70, 229, 0.9));
  }
</style>

<script>
  // Mouse move effect for cards
  document.addEventListener('DOMContentLoaded', () => {
    const cards = document.querySelectorAll('.project-card');
    
    cards.forEach(card => {
      card.addEventListener('mousemove', (e: Event) => {
        const mouseEvent = e as MouseEvent;
        const rect = (card as HTMLElement).getBoundingClientRect();
        const x = mouseEvent.clientX - rect.left;
        const y = mouseEvent.clientY - rect.top;
        
        (card as HTMLElement).style.setProperty('--mouse-x', `${x}px`);
        (card as HTMLElement).style.setProperty('--mouse-y', `${y}px`);
      });
    });
  });
</script> 