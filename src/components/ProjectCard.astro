---
interface Stat {
  label: string;
  value: string;
}

interface Props {
  title: string;
  description: string;
  image?: string;
  images?: string[];
  phoneImage?: string;
  phoneImageAlt?: string;
  github?: string;
  demo?: string;
  appStore?: string;
  playStore?: string;
  stats?: Stat[];
  index?: number;
  wip?: boolean;
}

const { title, description, image, images, phoneImage, phoneImageAlt, github, demo, appStore, playStore, stats, index = 0, wip = false } = Astro.props;
const isReversed = index % 2 !== 0;
const hasMultipleImages = images && images.length > 1;
const projectNumber = String(index + 1).padStart(2, "0");
---

<article class="project-entry py-12 md:py-16 border-t border-line">
  <div class:list={["grid md:grid-cols-12 gap-8 md:gap-12 items-center"]}>
    <!-- Visual -->
    <div class:list={["md:col-span-7", { "md:order-2": isReversed }]}>
      {hasMultipleImages ? (
        <div class="project-figure flex items-stretch justify-center gap-3 md:gap-4 p-4 md:p-6">
          {images.map((img, i) => (
            <div class="phone-frame">
              <img
                src={img}
                alt={`${title} screenshot ${i + 1}`}
                class="w-full h-full object-cover object-top"
                loading="lazy"
                decoding="async"
              />
            </div>
          ))}
        </div>
      ) : image ? (
        <div class="project-figure relative overflow-hidden">
          <img
            src={image}
            alt={title}
            class="w-full h-64 md:h-[26rem] object-cover object-top"
            loading="lazy"
            decoding="async"
          />
          {phoneImage && (
            <div class="phone-overlay" aria-hidden="false">
              <div class="phone-overlay-frame">
                <img
                  src={phoneImage}
                  alt={phoneImageAlt ?? ""}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
          )}
        </div>
      ) : null}
    </div>

    <!-- Text -->
    <div class:list={["md:col-span-5", { "md:order-1": isReversed }]}>
      <p class="font-mono text-[0.7rem] font-medium tracking-[0.25em] uppercase text-accent mb-4">
        P.{projectNumber}
        {wip && <span class="wip-badge">Work in progress</span>}
      </p>

      <h3 class="font-display text-2xl md:text-4xl font-semibold text-ink leading-tight mb-4">{title}</h3>

      <p class="text-ink-soft leading-relaxed mb-6">{description}</p>

      {stats && stats.length > 0 && (
        <dl class="flex gap-8 mb-6 border-y border-line py-4">
          {stats.map((stat) => (
            <div>
              <dd class="font-display text-2xl md:text-3xl font-semibold text-ink">{stat.value}</dd>
              <dt class="font-mono text-[0.6rem] tracking-[0.15em] uppercase text-ink-faint mt-1">{stat.label}</dt>
            </div>
          ))}
        </dl>
      )}

      <ul class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-[0.7rem] font-medium tracking-[0.12em] uppercase">
        {demo && (
          <li>
            <a href={demo} target="_blank" rel="noopener noreferrer" class="project-link project-link-primary" aria-label={`Visit ${title} live site`}>
              Visit site<span class="project-link-arrow">↗</span>
            </a>
          </li>
        )}
        {github && (
          <li>
            <a href={github} target="_blank" rel="noopener noreferrer" class="project-link" aria-label={`View ${title} on GitHub`}>
              GitHub<span class="project-link-arrow">↗</span>
            </a>
          </li>
        )}
        {appStore && (
          <li>
            <a href={appStore} target="_blank" rel="noopener noreferrer" class="project-link" aria-label={`Download ${title} on the App Store`}>
              App Store<span class="project-link-arrow">↗</span>
            </a>
          </li>
        )}
        {playStore && (
          <li>
            <a href={playStore} target="_blank" rel="noopener noreferrer" class="project-link" aria-label={`Download ${title} on Google Play`}>
              Google Play<span class="project-link-arrow">↗</span>
            </a>
          </li>
        )}
      </ul>
    </div>
  </div>
</article>

<style>
  .project-figure {
    border: 1px solid var(--line);
    background: var(--paper-raised);
    transition: border-color 0.3s ease;
  }

  .project-entry:hover .project-figure {
    border-color: var(--line-strong);
  }

  .wip-badge {
    display: inline-block;
    margin-left: 0.75rem;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--accent);
    color: var(--accent);
    font-size: 0.6rem;
    letter-spacing: 0.15em;
  }

  .phone-frame {
    flex: 1;
    min-width: 0;
    max-width: 150px;
    aspect-ratio: 9 / 19.5;
    border-radius: 1.1rem;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    background: var(--paper);
  }

  /* iPhone silhouette overlay — bottom-right of the desktop screenshot */
  .phone-overlay {
    position: absolute;
    right: 5.5%;
    bottom: 5%;
    width: 22%;
    aspect-ratio: 1206 / 2622;
    pointer-events: none;
    z-index: 2;
  }

  /* Volume rocker on the left of the chassis */
  .phone-overlay::before {
    content: "";
    position: absolute;
    left: -1.6%;
    top: 22%;
    width: 1.8%;
    height: 14%;
    background: #0a0e0d;
    border-radius: 1.5px 0 0 1.5px;
  }

  /* Power button on the right of the chassis */
  .phone-overlay::after {
    content: "";
    position: absolute;
    right: -1.6%;
    top: 26%;
    width: 1.8%;
    height: 9%;
    background: #0a0e0d;
    border-radius: 0 1.5px 1.5px 0;
  }

  .phone-overlay-frame {
    position: relative;
    width: 100%;
    height: 100%;
    background: #0e1413;
    border-radius: 14% / 6.5%;
    padding: 2.5%;
    box-shadow:
      0 18px 38px -10px rgba(14, 20, 19, 0.45),
      0 4px 10px -2px rgba(14, 20, 19, 0.25);
    overflow: hidden;
  }

  .phone-overlay-frame img {
    width: 100%;
    height: 100%;
    border-radius: 11% / 5%;
    object-fit: cover;
    object-position: top;
    display: block;
  }

  @media (max-width: 768px) {
    .phone-overlay {
      width: 24%;
      right: 8%;
      bottom: 6%;
    }
  }

  /* Links */
  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--ink-soft);
    padding-bottom: 0.2rem;
    border-bottom: 1px solid var(--line-strong);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .project-link-primary {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .project-link:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .project-link-arrow {
    font-family: "Archivo", sans-serif;
    transition: transform 0.2s ease;
  }

  .project-link:hover .project-link-arrow {
    transform: translate(2px, -2px);
  }
</style>
