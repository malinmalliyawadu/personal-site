---
import { profile } from "../data/site";
---

<div class="statusbar font-mono">
  <div class="sb-inner">
    <div class="sb-left">
      <span class="sb-region">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M12 21s-7-6.5-7-11a7 7 0 1 1 14 0c0 4.5-7 11-7 11Z" />
          <circle cx="12" cy="10" r="2.4" />
        </svg>
        <span class="sb-region-full">origin: wellington, nz</span>
        <span class="sb-region-short">wellington</span>
        <span class="sb-zone">· ap-southeast-2</span>
      </span>
    </div>

    <a href="#hero" class="sb-center" aria-label="Malin Malliya Wadu - uptime 15+ years">
      <span class="sb-id">MM</span>
      <span class="sb-uptime">uptime <b>15y+</b></span>
    </a>

    <div class="sb-right">
      <a href={profile.cv} class="sb-cv" download>
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span>cv.pdf</span>
      </a>
      <span class="sb-divider" aria-hidden="true"></span>
      <a href="#contact" class="sb-avail">
        <span class="sb-pulse" aria-hidden="true"></span>
        <span class="sb-avail-full">available for contract</span>
        <span class="sb-avail-short">available</span>
      </a>
    </div>
  </div>
</div>

<style>
  .statusbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--statusbar-h);
    z-index: 90;
    background: rgba(8, 11, 17, 0.82);
    backdrop-filter: blur(10px) saturate(140%);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    border-bottom: 1px solid var(--line);
  }
  .sb-inner {
    height: 100%;
    max-width: 1480px;
    margin-inline: auto;
    padding-inline: clamp(0.75rem, 3vw, 1.4rem);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    color: var(--fg-faint);
  }
  .sb-left { justify-self: start; min-width: 0; }
  .sb-right { justify-self: end; display: inline-flex; align-items: center; gap: 0.7rem; }

  .sb-region { display: inline-flex; align-items: center; gap: 0.4rem; white-space: nowrap; overflow: hidden; }
  .sb-region svg { color: var(--fg-faint); flex: none; }
  .sb-zone { color: var(--fg-faint); }
  .sb-region-short { display: none; color: var(--fg-dim); }
  .sb-region-full { color: var(--fg-dim); }

  .sb-center {
    justify-self: center;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--fg-dim);
    transition: color 0.16s var(--ease);
  }
  .sb-center:hover { color: var(--fg); }
  .sb-id {
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--fg);
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 0.05rem 0.35rem;
    background: var(--tile);
  }
  .sb-uptime b { color: var(--signal); font-weight: 500; }

  .sb-cv {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--fg-dim);
    transition: color 0.16s var(--ease);
  }
  .sb-cv:hover { color: var(--fg); }
  .sb-divider { width: 1px; height: 14px; background: var(--line); }

  .sb-avail {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--signal);
    white-space: nowrap;
  }
  .sb-avail-short { display: none; }
  .sb-pulse {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 0 var(--signal-glow);
    animation: sbPulse 2.4s var(--ease) infinite;
    flex: none;
  }
  @keyframes sbPulse {
    0% { box-shadow: 0 0 0 0 rgba(61, 220, 151, 0.55); }
    70% { box-shadow: 0 0 0 7px rgba(61, 220, 151, 0); }
    100% { box-shadow: 0 0 0 0 rgba(61, 220, 151, 0); }
  }

  @media (max-width: 720px) {
    .sb-region-full, .sb-zone { display: none; }
    .sb-region-short { display: inline; }
    .sb-uptime { display: none; }
    .sb-avail-full { display: none; }
    .sb-avail-short { display: inline; }
    .sb-cv span { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sb-pulse { animation: none; box-shadow: 0 0 8px var(--signal-glow); }
  }
</style>
