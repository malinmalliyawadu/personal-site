---
interface Props {
  startDate: string; // Format: YYYY-MM-DD
  className?: string;
}

const { startDate, className = "" } = Astro.props;
---

<div class={`career-beams ${className}`} data-start-date={startDate}></div>

<style>
  .career-beams {
    position: fixed;
    inset: 0;
    z-index: -10;
    overflow: hidden;
    pointer-events: none;
  }

  .career-beams::before,
  .career-beams::after,
  .milestone-beam-1,
  .milestone-beam-2,
  .milestone-beam-3 {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    transform-origin: center;
    z-index: -1;
  }

  /* First beam layer */
  .career-beams::before {
    background: radial-gradient(
      circle at var(--x) var(--y),
      rgba(99, 102, 241, 0.15) 0%,
      rgba(139, 92, 246, 0.1) 25%,
      rgba(0, 0, 0, 0) 50%
    );
    filter: blur(calc(var(--beam-blur) * 1px));
    opacity: var(--beam-opacity);
    transform: scale(var(--beam-scale));
    animation: pulse-beam 8s ease-in-out infinite alternate;
  }

  /* Second beam layer */
  .career-beams::after {
    background: linear-gradient(
      var(--beam-angle),
      rgba(99, 102, 241, 0) 0%,
      rgba(139, 92, 246, var(--beam-intensity)) 45%,
      rgba(147, 51, 234, var(--beam-intensity)) 55%,
      rgba(99, 102, 241, 0) 100%
    );
    filter: blur(calc(var(--beam-blur) * 2px));
    opacity: var(--beam-opacity);
    transform: scale(var(--beam-scale)) rotate(var(--beam-rotation));
    animation: rotate-beam 20s linear infinite;
  }

  /* Milestone beams - these appear at career milestones */
  /* 3 year milestone - Pink/Orange beam */
  .milestone-beam-1 {
    background: conic-gradient(
      from 90deg at 50% 50%,
      rgba(236, 72, 153, 0) 0%,
      rgba(236, 72, 153, var(--milestone1-intensity)) 25%,
      rgba(249, 115, 22, var(--milestone1-intensity)) 50%,
      rgba(249, 115, 22, 0) 75%,
      rgba(236, 72, 153, 0) 100%
    );
    filter: blur(calc(var(--beam-blur) * 1.5px));
    opacity: var(--milestone1-opacity);
    transform: scale(var(--milestone1-scale)) rotate(45deg);
    animation: rotate-milestone1 25s linear infinite;
    display: var(--milestone1-display);
  }

  /* 5 year milestone - Green/Cyan beam */
  .milestone-beam-2 {
    background: conic-gradient(
      from 180deg at 50% 50%,
      rgba(16, 185, 129, 0) 0%,
      rgba(16, 185, 129, var(--milestone2-intensity)) 25%,
      rgba(6, 182, 212, var(--milestone2-intensity)) 50%,
      rgba(6, 182, 212, 0) 75%,
      rgba(16, 185, 129, 0) 100%
    );
    filter: blur(calc(var(--beam-blur) * 1.8px));
    opacity: var(--milestone2-opacity);
    transform: scale(var(--milestone2-scale)) rotate(135deg);
    animation: rotate-milestone2 30s linear infinite reverse;
    display: var(--milestone2-display);
  }

  /* 10 year milestone - Full rainbow beam */
  .milestone-beam-3 {
    background: conic-gradient(
      from 270deg at 50% 50%,
      rgba(239, 68, 68, var(--milestone3-intensity)) 0%,
      rgba(249, 115, 22, var(--milestone3-intensity)) 15%,
      rgba(234, 179, 8, var(--milestone3-intensity)) 30%,
      rgba(34, 197, 94, var(--milestone3-intensity)) 45%,
      rgba(6, 182, 212, var(--milestone3-intensity)) 60%,
      rgba(99, 102, 241, var(--milestone3-intensity)) 75%,
      rgba(168, 85, 247, var(--milestone3-intensity)) 90%,
      rgba(239, 68, 68, var(--milestone3-intensity)) 100%
    );
    filter: blur(calc(var(--beam-blur) * 2px));
    opacity: var(--milestone3-opacity);
    transform: scale(var(--milestone3-scale)) rotate(225deg);
    animation: rotate-milestone3 40s linear infinite;
    display: var(--milestone3-display);
  }

  @keyframes pulse-beam {
    0% {
      opacity: calc(0.4 + (var(--experience-years, 1) * 0.01));
      transform: scale(calc(0.97 - (var(--experience-years, 1) * 0.002)));
    }
    100% {
      opacity: calc(0.7 + (var(--experience-years, 1) * 0.015));
      transform: scale(calc(1.03 + (var(--experience-years, 1) * 0.003)));
    }
  }

  @keyframes rotate-beam {
    0% {
      transform: scale(var(--beam-scale)) rotate(var(--beam-rotation));
    }
    100% {
      transform: scale(var(--beam-scale)) rotate(calc(var(--beam-rotation) + 360deg));
    }
  }

  @keyframes rotate-milestone1 {
    0% {
      transform: scale(var(--milestone1-scale)) rotate(45deg);
      opacity: var(--milestone1-opacity);
    }
    50% {
      opacity: calc(var(--milestone1-opacity) * 0.7);
    }
    100% {
      transform: scale(var(--milestone1-scale)) rotate(405deg);
      opacity: var(--milestone1-opacity);
    }
  }

  @keyframes rotate-milestone2 {
    0% {
      transform: scale(var(--milestone2-scale)) rotate(135deg);
      opacity: var(--milestone2-opacity);
    }
    50% {
      opacity: calc(var(--milestone2-opacity) * 0.7);
    }
    100% {
      transform: scale(var(--milestone2-scale)) rotate(495deg);
      opacity: var(--milestone2-opacity);
    }
  }

  @keyframes rotate-milestone3 {
    0% {
      transform: scale(var(--milestone3-scale)) rotate(225deg);
      opacity: var(--milestone3-opacity);
    }
    50% {
      opacity: calc(var(--milestone3-opacity) * 0.8);
    }
    100% {
      transform: scale(var(--milestone3-scale)) rotate(585deg);
      opacity: var(--milestone3-opacity);
    }
  }
</style>

<script define:vars={{ startDate }}>
  document.addEventListener('DOMContentLoaded', () => {
    const beamContainer = document.querySelector('.career-beams');
    if (!beamContainer) return;
    
    // Calculate years of experience
    function calculateExperience() {
      const start = new Date(startDate);
      const now = new Date();
      const diffTime = Math.abs(now - start);
      const diffDays = diffTime / (1000 * 60 * 60 * 24);
      const years = diffDays / 365.25;
      return years;
    }
    
    // Update beam properties based on years of experience
    function updateBeams() {
      const years = calculateExperience();
      const container = document.querySelector('.career-beams');
      if (!container) return;
      
      // Store experience years as a CSS variable for animations
      container.style.setProperty('--experience-years', years.toFixed(2));
      
      // More experience = thicker, brighter, more colorful beams
      // Set CSS variables that control the beam appearance
      container.style.setProperty('--beam-intensity', Math.min(0.15 + (years * 0.015), 0.6).toFixed(2));
      container.style.setProperty('--beam-opacity', Math.min(0.3 + (years * 0.03), 0.9).toFixed(2));
      container.style.setProperty('--beam-blur', Math.min(60 + (years * 3), 120).toFixed(0));
      container.style.setProperty('--beam-scale', Math.min(0.8 + (years * 0.05), 1.8).toFixed(2));
      container.style.setProperty('--beam-rotation', `${Math.random() * 360}deg`);
      container.style.setProperty('--beam-angle', `${Math.random() * 360}deg`);
      
      // Milestone 1 (3+ years)
      if (years >= 3) {
        container.style.setProperty('--milestone1-intensity', Math.min(0.2 + ((years - 3) * 0.02), 0.5).toFixed(2));
        container.style.setProperty('--milestone1-opacity', Math.min(0.4 + ((years - 3) * 0.05), 0.8).toFixed(2));
        container.style.setProperty('--milestone1-scale', Math.min(1.0 + ((years - 3) * 0.05), 1.5).toFixed(2));
        container.style.setProperty('--milestone1-display', 'block');
        
        // Create milestone beam 1 if it doesn't exist
        if (!container.querySelector('.milestone-beam-1')) {
          const beam = document.createElement('div');
          beam.className = 'milestone-beam-1';
          container.appendChild(beam);
        }
      } else {
        container.style.setProperty('--milestone1-display', 'none');
      }
      
      // Milestone 2 (5+ years)
      if (years >= 5) {
        container.style.setProperty('--milestone2-intensity', Math.min(0.2 + ((years - 5) * 0.025), 0.6).toFixed(2));
        container.style.setProperty('--milestone2-opacity', Math.min(0.4 + ((years - 5) * 0.06), 0.85).toFixed(2));
        container.style.setProperty('--milestone2-scale', Math.min(1.1 + ((years - 5) * 0.06), 1.7).toFixed(2));
        container.style.setProperty('--milestone2-display', 'block');
        
        // Create milestone beam 2 if it doesn't exist
        if (!container.querySelector('.milestone-beam-2')) {
          const beam = document.createElement('div');
          beam.className = 'milestone-beam-2';
          container.appendChild(beam);
        }
      } else {
        container.style.setProperty('--milestone2-display', 'none');
      }
      
      // Milestone 3 (10+ years)
      if (years >= 10) {
        container.style.setProperty('--milestone3-intensity', Math.min(0.25 + ((years - 10) * 0.03), 0.7).toFixed(2));
        container.style.setProperty('--milestone3-opacity', Math.min(0.5 + ((years - 10) * 0.07), 0.9).toFixed(2));
        container.style.setProperty('--milestone3-scale', Math.min(1.2 + ((years - 10) * 0.08), 2.0).toFixed(2));
        container.style.setProperty('--milestone3-display', 'block');
        
        // Create milestone beam 3 if it doesn't exist
        if (!container.querySelector('.milestone-beam-3')) {
          const beam = document.createElement('div');
          beam.className = 'milestone-beam-3';
          container.appendChild(beam);
        }
      } else {
        container.style.setProperty('--milestone3-display', 'none');
      }
    }
    
    // Track mouse movement
    function trackMouseMovement() {
      window.addEventListener('mousemove', (e) => {
        const container = document.querySelector('.career-beams');
        if (!container) return;
        
        // Calculate mouse position as percentage of viewport
        const x = (e.clientX / window.innerWidth) * 100;
        const y = (e.clientY / window.innerHeight) * 100;
        
        // Update the beam position
        container.style.setProperty('--x', `${x}%`);
        container.style.setProperty('--y', `${y}%`);
      });
    }
    
    // Initialize beams
    updateBeams();
    trackMouseMovement();
    
    // Update beam angles periodically for movement even without mouse
    setInterval(() => {
      const container = document.querySelector('.career-beams');
      if (!container) return;
      
      const newAngle = Math.random() * 360;
      container.style.setProperty('--beam-angle', `${newAngle}deg`);
    }, 5000);
    
    // Handle window resizing
    window.addEventListener('resize', updateBeams);
  });
</script> 