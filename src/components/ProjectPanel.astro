---
interface Stat {
  label: string;
  value: string;
}
interface Props {
  anchor: string;
  index: number;
  title: string;
  tag: string;
  year: string;
  description: string;
  image: string;
  imageW: number;
  imageH: number;
  phoneImage?: string;
  phoneImageW?: number;
  phoneImageH?: number;
  phoneImageAlt?: string;
  demo?: string;
  github?: string;
  appStore?: string;
  playStore?: string;
  stack: readonly string[];
  stats: readonly Stat[];
  wip?: boolean;
  reverse?: boolean;
}

const {
  anchor,
  index,
  title,
  tag,
  year,
  description,
  image,
  imageW,
  imageH,
  phoneImage,
  phoneImageW,
  phoneImageH,
  phoneImageAlt,
  demo,
  github,
  appStore,
  playStore,
  stack,
  stats,
  wip = false,
  reverse = false,
} = Astro.props;

const host = demo ? new URL(demo).host : "preview";
const num = String(index + 1).padStart(2, "0");
---

<article id={anchor} class={`proj reveal ${reverse ? "is-reverse" : ""}`}>
  <div class="proj-media">
    <div class="shot">
      <div class="shot-bar font-mono">
        <span class="shot-dots" aria-hidden="true"><i></i><i></i><i></i></span>
        {
          demo ? (
            <a href={demo} target="_blank" rel="noopener noreferrer" class="shot-url is-link" aria-label={`Open ${host} in a new tab`}>
              {host}
            </a>
          ) : (
            <span class="shot-url">{host}</span>
          )
        }
      </div>
      <div class="shot-img">
        <img src={image} width={imageW} height={imageH} alt={`${title} screenshot`} loading="lazy" decoding="async" />
      </div>
    </div>
    {
      phoneImage && (
        <div class="shot-phone">
          <img src={phoneImage} width={phoneImageW} height={phoneImageH} alt={phoneImageAlt || `${title} mobile app`} loading="lazy" decoding="async" />
        </div>
      )
    }
  </div>

  <div class="proj-body">
    <div class="proj-head">
      <span class="proj-num font-mono">{num}</span>
      <span class={`proj-status font-mono ${wip ? "is-wip" : "is-live"}`}>
        <span class="ps-dot"></span>{wip ? "building" : "live"}
      </span>
      <span class="proj-tag font-mono">{tag}</span>
    </div>

    <h3 class="proj-title">{title}</h3>
    <p class="proj-desc">{description}</p>

    <div class="proj-stats">
      {
        stats.map((s) => (
          <div class="pstat">
            <span class="pstat-val font-mono">{s.value}</span>
            <span class="pstat-label">{s.label}</span>
          </div>
        ))
      }
    </div>

    <ul class="proj-stack">
      {stack.map((t) => <li class="chip">{t}</li>)}
    </ul>

    <div class="proj-links font-mono">
      {
        demo && (
          <a href={demo} target="_blank" rel="noopener noreferrer" class="plink plink-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            visit site
          </a>
        )
      }
      {
        github && (
          <a href={github} target="_blank" rel="noopener noreferrer" class="plink">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2A10 10 0 0 0 8.84 21.5c.5.08.66-.22.66-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.74c0 .27.16.57.67.48A10 10 0 0 0 12 2Z"/></svg>
            source
          </a>
        )
      }
      {
        appStore && (
          <a href={appStore} target="_blank" rel="noopener noreferrer" class="plink">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.05 12.04a4.3 4.3 0 0 1 2.05-3.6 4.4 4.4 0 0 0-3.47-1.88c-1.46-.15-2.86.86-3.6.86-.74 0-1.9-.84-3.12-.82a4.62 4.62 0 0 0-3.9 2.37c-1.66 2.9-.42 7.18 1.2 9.53.8 1.15 1.74 2.44 2.98 2.4 1.2-.05 1.65-.78 3.1-.78 1.44 0 1.85.78 3.11.75 1.29-.02 2.1-1.17 2.89-2.33a9.6 9.6 0 0 0 1.3-2.7 4.18 4.18 0 0 1-2.55-3.97ZM14.7 5.1a4.23 4.23 0 0 0 .96-3.04 4.3 4.3 0 0 0-2.78 1.44 4.02 4.02 0 0 0-.99 2.93 3.56 3.56 0 0 0 2.81-1.33Z"/></svg>
            app store
          </a>
        )
      }
      {
        playStore && (
          <a href={playStore} target="_blank" rel="noopener noreferrer" class="plink">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 3.5c-.3.2-.5.6-.5 1.1v14.8c0 .5.2.9.5 1.1l8.2-8.5L4 3.5Zm10 6.3 2.7-2.8L6.4 1.2c-.4-.2-.8-.2-1.1-.1L14 9.8Zm0 4.4L5.3 22.9c.3.1.7.1 1.1-.1l10.3-5.8-2.7-2.8Zm5.6-3.3-2.4-1.4-3 3 3 3 2.4-1.3c.8-.5.8-1.6 0-2.3Z"/></svg>
            play store
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .proj {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(1.5rem, 3vw, 2.6rem);
    align-items: center;
    padding: clamp(1.4rem, 3vw, 2rem) 0;
    scroll-margin-top: calc(var(--statusbar-h) + 40px);
  }
  .proj + .proj {
    border-top: 1px solid var(--line);
  }
  .proj.is-reverse .proj-media {
    order: 2;
  }

  /* Media / browser frame */
  .proj-media {
    position: relative;
  }
  .shot {
    border: 1px solid var(--line);
    border-radius: 11px;
    overflow: hidden;
    background: var(--base-2);
    box-shadow: 0 30px 60px -40px rgba(0, 0, 0, 0.95);
  }
  .shot-bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 0.8rem;
    background: var(--inset);
    border-bottom: 1px solid var(--line);
  }
  .shot-dots {
    position: absolute;
    left: 0.8rem;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    gap: 5px;
  }
  .shot-dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--line);
    display: block;
  }
  .shot-url {
    max-width: min(60%, 320px);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.66rem;
    color: var(--fg-faint);
    background: var(--base);
    padding: 0.18rem 0.7rem;
    border-radius: 5px;
    border: 1px solid var(--line);
    transition: color 0.16s var(--ease), border-color 0.16s var(--ease);
  }
  .shot-url.is-link:hover,
  .shot-url.is-link:focus-visible {
    color: var(--route);
    border-color: rgba(77, 163, 255, 0.5);
  }
  .shot-img {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .shot-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }
  .shot-phone {
    position: absolute;
    right: -10px;
    bottom: -22px;
    width: 27%;
    max-width: 130px;
    border-radius: 16px;
    border: 3px solid var(--inset);
    background: var(--base-2);
    overflow: hidden;
    box-shadow: 0 24px 50px -22px rgba(0, 0, 0, 0.95);
  }
  .shot-phone img {
    width: 100%;
    display: block;
  }
  /* Dynamic island */
  .shot-phone::after {
    content: "";
    position: absolute;
    top: 5px;
    left: 50%;
    transform: translateX(-50%);
    width: 30%;
    height: 6px;
    border-radius: 99px;
    background: #05070b;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.04);
    z-index: 2;
  }

  /* Body */
  .proj-head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 0.85rem;
    flex-wrap: wrap;
  }
  .proj-num {
    font-size: 0.72rem;
    color: var(--fg-faint);
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 0.05rem 0.4rem;
  }
  .proj-status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.66rem;
  }
  .ps-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }
  .is-live {
    color: var(--signal);
  }
  .is-live .ps-dot {
    background: var(--signal);
    box-shadow: 0 0 7px var(--signal-glow);
  }
  .is-wip {
    color: var(--amber);
  }
  .is-wip .ps-dot {
    background: var(--amber);
    box-shadow: 0 0 7px rgba(255, 180, 84, 0.5);
  }
  .proj-tag {
    font-size: 0.66rem;
    color: var(--fg-faint);
    margin-left: auto;
  }
  .proj-title {
    font-family: "Clash Display", sans-serif;
    font-weight: 600;
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    letter-spacing: -0.02em;
    line-height: 1.06;
    color: var(--fg);
    margin-bottom: 0.7rem;
  }
  .proj-desc {
    font-size: 0.94rem;
    color: var(--fg-dim);
    line-height: 1.6;
    margin-bottom: 1.2rem;
  }
  .proj-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem;
    padding: 0.95rem 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin-bottom: 1.1rem;
  }
  .pstat {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .pstat-val {
    font-size: 1.35rem;
    font-weight: 500;
    color: var(--signal);
    line-height: 1;
  }
  .pstat-label {
    font-size: 0.72rem;
    color: var(--fg-faint);
  }
  .proj-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
  }
  .proj-stack .chip {
    font-size: 0.66rem;
    padding: 0.2rem 0.5rem;
  }
  .proj-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .plink {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.8rem;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--tile);
    color: var(--fg-dim);
    font-size: 0.72rem;
    transition: border-color 0.16s var(--ease), color 0.16s var(--ease), transform 0.16s var(--ease);
  }
  .plink svg {
    width: 14px;
    height: 14px;
  }
  .plink:hover {
    color: var(--fg);
    border-color: var(--fg-faint);
    transform: translateY(-1px);
  }
  .plink-primary {
    color: var(--signal);
    border-color: rgba(61, 220, 151, 0.4);
  }
  .plink-primary:hover {
    color: #6ef0b4;
    border-color: var(--signal);
  }

  @media (max-width: 820px) {
    .proj {
      grid-template-columns: 1fr;
      gap: 1.6rem;
    }
    .proj.is-reverse .proj-media {
      order: 0;
    }
    .shot-phone {
      right: 8px;
      bottom: 8px;
      width: 22%;
      max-width: 82px;
      margin: 0;
    }
  }
</style>
