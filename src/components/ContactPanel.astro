---
import Panel from "./Panel.astro";
import { profile } from "../data/site";
import { Image } from "astro:assets";
import profilePic from "../images/profile.webp";
---

<Panel id="contact" svc="svc-07" path="svc://connect" status="ready">
  <div class="contact-grid">
    <div class="contact-main">
      <p class="eyebrow reveal">contact · start an engagement</p>
      <h2 class="contact-title font-display reveal">
        Let's open a<br /><span class="ct-accent">connection.</span>
      </h2>
      <p class="contact-lede reveal">
        Available now for contract work - architecture, full-stack delivery, or technical leadership.
        Tell me what you're building and I'll reply within a day.
      </p>

      <div class="term reveal">
        <div class="term-bar font-mono">
          <span class="term-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="term-name">connect@malin.nz</span>
        </div>
        <div class="term-body font-mono">
          <p><span class="t-prompt">$</span> mail --to</p>
          <a href={`mailto:${profile.email}`} class="term-email">{profile.email}</a>
          <p class="term-foot"><span class="t-prompt">$</span> status <span class="t-ok">// available · replies within a day</span></p>
        </div>
      </div>

      <div class="contact-actions font-mono reveal">
        <a href={`mailto:${profile.email}`} class="btn btn-primary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 6h16v12H4z" stroke-linejoin="round"/><path d="m4 7 8 6 8-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Email me
        </a>
        <a href={profile.socials.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
          LinkedIn ↗
        </a>
        <a href={profile.socials.github} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
          GitHub ↗
        </a>
        <a href={profile.cv} download class="btn btn-ghost">
          CV (PDF) ↓
        </a>
      </div>
    </div>

    <aside class="operator reveal">
      <div class="op-photo">
        <Image src={profilePic} alt={`Portrait of ${profile.name}`} width={400} height={400} densities={[2, 3]} class="op-img" />
        <span class="op-live font-mono"><span class="op-dot"></span>online</span>
      </div>
      <div class="op-meta">
        <h3 class="op-name font-display">{profile.name}</h3>
        <p class="op-role">{profile.role}</p>
        <dl class="op-rows font-mono">
          <div><dt>location</dt><dd>{profile.locationShort}</dd></div>
          <div><dt>timezone</dt><dd>{profile.timezone}</dd></div>
          <div><dt>status</dt><dd class="op-avail">available for contract</dd></div>
          <div><dt>response</dt><dd>&lt; 1 business day</dd></div>
        </dl>
      </div>
    </aside>
  </div>
</Panel>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  .contact-main .eyebrow {
    display: block;
    margin-bottom: 0.9rem;
  }
  .contact-title {
    font-weight: 600;
    font-size: clamp(2.2rem, 5.5vw, 3.6rem);
    line-height: 0.98;
    letter-spacing: -0.025em;
    color: var(--fg);
    margin-bottom: 1rem;
  }
  .ct-accent {
    color: var(--signal);
  }
  .contact-lede {
    font-size: 1.02rem;
    color: var(--fg-dim);
    max-width: 32rem;
    line-height: 1.6;
    margin-bottom: 1.6rem;
  }

  .term {
    border: 1px solid var(--line);
    border-radius: 11px;
    overflow: hidden;
    background: var(--base-2);
    margin-bottom: 1.4rem;
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.8rem;
    background: var(--inset);
    border-bottom: 1px solid var(--line);
    font-size: 0.66rem;
    color: var(--fg-faint);
  }
  .term-dots {
    display: inline-flex;
    gap: 5px;
  }
  .term-dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--line);
    display: block;
  }
  .term-body {
    padding: 1.1rem 1.1rem 1.2rem;
    font-size: 0.82rem;
    color: var(--fg-dim);
    line-height: 1.9;
  }
  .t-prompt {
    color: var(--signal);
    margin-right: 0.5rem;
  }
  .term-email {
    display: inline-block;
    font-size: clamp(1.05rem, 2.6vw, 1.6rem);
    color: var(--fg);
    padding: 0.2rem 0;
    border-bottom: 1px solid var(--line);
    transition: color 0.16s var(--ease), border-color 0.16s var(--ease);
    word-break: break-all;
  }
  .term-email:hover {
    color: var(--signal);
    border-color: var(--signal);
  }
  .term-foot {
    margin-top: 0.3rem;
  }
  .t-ok {
    color: var(--signal);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  /* Operator card */
  .operator {
    border: 1px solid var(--line);
    border-radius: 13px;
    overflow: hidden;
    background: var(--tile);
  }
  .op-photo {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  .op-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: grayscale(0.2) contrast(1.02);
  }
  .op-live {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.55rem;
    border-radius: 6px;
    background: rgba(8, 11, 17, 0.78);
    backdrop-filter: blur(6px);
    border: 1px solid var(--line);
    font-size: 0.62rem;
    color: var(--signal);
  }
  .op-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 6px var(--signal-glow);
  }
  .op-meta {
    padding: 1.1rem 1.15rem 1.25rem;
  }
  .op-name {
    font-weight: 600;
    font-size: 1.18rem;
    color: var(--fg);
    line-height: 1.1;
    margin-bottom: 0.2rem;
  }
  .op-role {
    font-size: 0.8rem;
    color: var(--fg-dim);
    margin-bottom: 1rem;
  }
  .op-rows {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.7rem;
  }
  .op-rows > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
  }
  .op-rows > div:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .op-rows dt {
    color: var(--fg-faint);
  }
  .op-rows dd {
    color: var(--fg-dim);
    text-align: right;
  }
  .op-avail {
    color: var(--signal) !important;
  }

  @media (max-width: 820px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .operator {
      display: grid;
      grid-template-columns: 130px 1fr;
    }
    .op-photo {
      border-bottom: none;
      border-right: 1px solid var(--line);
      aspect-ratio: auto;
    }
  }
  @media (max-width: 460px) {
    .operator {
      grid-template-columns: 1fr;
    }
    .op-photo {
      border-right: none;
      border-bottom: 1px solid var(--line);
      aspect-ratio: 1 / 1;
      max-height: 280px;
    }
  }
</style>
