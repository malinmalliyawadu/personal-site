---
interface Props {
  title: string;
  issuer: string;
  issueDate: string;
  expiryDate?: string;
  image: string;
  link: string;
  skills?: string[];
}

import { Image } from 'astro:assets';
const { title, issuer, issueDate, expiryDate, image, link, skills } = Astro.props;

// Format date to show month and year
const formatDate = (dateString: string) => {
  const date = new Date(dateString);
  return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
};
---

<a href={link} target="_blank" rel="noopener noreferrer" class="block h-full">
  <div class="bg-gray-800/40 rounded-lg overflow-hidden h-full transition-all duration-300 hover:scale-[1.02] hover:bg-gray-800/60 backdrop-blur-sm border border-gray-700/50 shadow-xl flex flex-col">
    <div class="p-4 flex items-center justify-center bg-gray-900/30">
      <Image src={image} alt={title} width={128} height={128} class="h-32 object-contain" />
    </div>
    <div class="p-4 flex-1 flex flex-col">
      <h3 class="text-xl font-bold text-white mb-1">{title}</h3>
      <div class="text-gray-300 mb-2">
        <span class="font-medium">{issuer}</span>
      </div>
      <div class="text-sm text-gray-400 flex flex-col">
        <span>Issued: {formatDate(issueDate)}</span>
        {expiryDate && (
          <span class="">Expires: {formatDate(expiryDate)}</span>
        )}
      </div>
      
    </div>
  </div>
</a> 