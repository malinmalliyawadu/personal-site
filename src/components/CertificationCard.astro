---
interface Props {
  title: string;
  issuer: string;
  issueDate: string;
  expiryDate?: string;
  image: string;
  link: string;
  skills?: string[];
}

import { Image } from 'astro:assets';
const { title, issuer, issueDate, expiryDate, image, link, skills } = Astro.props;

// Format date to show month and year
const formatDate = (dateString: string) => {
  const date = new Date(dateString);
  return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
};
---

<a href={link} target="_blank" rel="noopener noreferrer" class="block h-full">
  <div class="cert-card bg-gray-800/40 rounded-lg overflow-hidden h-full transition-all duration-300 hover:scale-[1.02] hover:bg-gray-800/60 backdrop-blur-sm border border-gray-700/50 shadow-xl flex flex-col">
    <div class="cert-image-container p-4 flex items-center justify-center bg-gray-900/30">
      <Image src={image} alt={title} width={128} height={128} class="h-32 object-contain" />
    </div>
    <div class="p-4 flex-1 flex flex-col">
      <h3 class="cert-title text-xl font-bold text-white mb-1">{title}</h3>
      <div class="cert-issuer text-gray-300 mb-2">
        <span class="font-medium">{issuer}</span>
      </div>
      <div class="cert-dates text-sm text-gray-400 flex flex-col">
        <span>Issued: {formatDate(issueDate)}</span>
        {expiryDate && (
          <span class="">Expires: {formatDate(expiryDate)}</span>
        )}
      </div>
      
    </div>
  </div>
</a>

<style>
  /* Light mode styles - Glassy white appearance */
  :global(html.light) .cert-card {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0.5));
    border-color: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 
      0 8px 32px rgba(31, 38, 135, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.8),
      inset 0 -1px 0 rgba(255, 255, 255, 0.3);
  }
  
  :global(html.light) .cert-card:hover {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.8), rgba(255, 255, 255, 0.6));
    box-shadow: 
      0 12px 40px rgba(31, 38, 135, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      inset 0 -1px 0 rgba(255, 255, 255, 0.4);
  }
  
  :global(html.light) .cert-image-container {
    background: rgba(255, 255, 255, 0.5);
  }
  
  :global(html.light) .cert-title {
    color: #1f2937;
  }
  
  :global(html.light) .cert-issuer {
    color: #4b5563;
  }
  
  :global(html.light) .cert-dates {
    color: #6b7280;
  }
</style> 