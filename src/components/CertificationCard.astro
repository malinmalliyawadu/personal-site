---
interface Props {
  title: string;
  issuer: string;
  issueDate: string;
  expiryDate?: string;
  image: string;
  link: string;
  skills?: string[];
}

import { Image } from 'astro:assets';
const { title, issuer, issueDate, expiryDate, image, link } = Astro.props;

const formatDate = (dateString: string) => {
  const date = new Date(dateString);
  return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
};

---

<a href={link} target="_blank" rel="noopener noreferrer" class="cert-card block h-full group">
  <div class="h-full flex items-center gap-5 p-5">
    <div class="flex-shrink-0">
      <Image src={image} alt={title} width={80} height={80} class="w-14 h-14 md:w-16 md:h-16 object-contain" />
    </div>
    <div class="flex-1 min-w-0">
      <h3 class="font-display text-base md:text-lg font-semibold text-ink leading-snug mb-1">{title}</h3>
      <p class="text-sm text-ink-soft mb-1.5">{issuer}</p>
      <span class="font-mono text-[0.65rem] tracking-[0.1em] uppercase text-ink-faint">
        {formatDate(issueDate)}{expiryDate && ` — ${formatDate(expiryDate)}`}
      </span>
    </div>
    <svg xmlns="http://www.w3.org/2000/svg" class="cert-arrow w-4 h-4 flex-shrink-0 transition-all duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
    </svg>
  </div>
</a>

<style>
  .cert-card {
    border: 1px solid var(--line);
    background: var(--paper-raised);
    transition: border-color 0.2s ease;
  }

  .cert-card:hover {
    border-color: var(--ink);
  }

  .cert-arrow {
    color: var(--ink-faint);
  }

  .cert-card:hover .cert-arrow {
    color: var(--accent);
  }
</style>
