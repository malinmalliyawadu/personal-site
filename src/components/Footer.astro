---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-line py-12">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8">
      <div>
        <a href="#hero" class="font-display text-2xl font-semibold text-ink hover:text-accent transition-colors">
          Malin<span class="text-accent">.nz</span>
        </a>
        <p class="mt-3 max-w-md text-sm text-ink-soft leading-relaxed">
          Full-stack developer specializing in building beautiful, performant,
          and accessible web experiences.
        </p>
      </div>

      <div class="flex items-center gap-6 font-mono text-[0.7rem] font-medium tracking-[0.15em] uppercase">
        <a
          href="https://github.com/malinmalliyawadu"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-link"
        >
          GitHub
        </a>
        <a
          href="https://www.linkedin.com/in/malin-malliya-wadu-94956522/"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-link"
        >
          LinkedIn
        </a>
        <a
          href="mailto:malin.malliya.wadu@gmail.com"
          class="footer-link"
        >
          Email
        </a>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-line flex flex-col md:flex-row justify-between gap-2 font-mono text-[0.65rem] tracking-[0.12em] uppercase text-ink-faint">
      <p>© {currentYear} Malin Malliya Wadu</p>
      <p>Wellington, Aotearoa New Zealand</p>
    </div>
  </div>
</footer>

<style>
  .footer-link {
    color: var(--ink-soft);
    transition: color 0.15s ease;
  }

  .footer-link:hover {
    color: var(--accent);
  }
</style>
