---
const currentYear = new Date().getFullYear();
---

<footer class="footer-main bg-gray-900 text-gray-400 py-16 border-t border-gray-800">
  <div class="container mx-auto px-4">
    <div class="flex flex-col md:flex-row justify-between items-center">
      <div class="mb-6 md:mb-0">
        <a href="#hero" class="footer-logo text-2xl font-bold text-white hover:text-indigo-400 transition-colors">
          Malin<span class="text-indigo-400">.nz</span>
        </a>
        <p class="footer-description mt-2 max-w-md">
          Full-stack developer specializing in building beautiful, performant,
          and accessible web experiences.
        </p>
      </div>
      
      <div class="flex space-x-6">
        <a 
          href="https://github.com/malinmalliyawadu" 
          target="_blank"
          rel="noopener noreferrer"
          class="footer-link text-gray-400 hover:text-white transition-colors"
          aria-label="GitHub"
        >
          <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
          </svg>
        </a>
        <a 
          href="https://www.linkedin.com/in/malin-malliya-wadu-94956522/"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-link text-gray-400 hover:text-white transition-colors"
          aria-label="LinkedIn"
        >
          <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 118.3 6.5a1.78 1.78 0 01-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0013 14.19V19h-3v-9h2.9v1.3a3.11 3.11 0 012.7-1.4c1.55 0 3.36.86 3.36 3.66z"></path>
          </svg>
        </a>
        <a 
          href="mailto:malin.malliya.wadu@gmail.com"
          class="footer-link text-gray-400 hover:text-white transition-colors"
          aria-label="Email"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </a>
      </div>
    </div>
    
    <div class="footer-bottom mt-8 pt-8 border-t border-gray-800 text-center text-sm">
      <p class="footer-copyright">© {currentYear} Malin Malliya Wadu. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  /* Light mode styles - Glassy white appearance */
  :global(html.light) .footer-main {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.8), rgba(255, 255, 255, 0.6));
    border-top-color: rgba(0, 0, 0, 0.1);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 
      0 -4px 20px rgba(31, 38, 135, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }
  
  :global(html.light) .footer-logo {
    color: #1f2937;
  }
  
  :global(html.light) .footer-logo:hover {
    color: #4f46e5;
  }
  
  :global(html.light) .footer-logo span {
    color: #4f46e5;
  }
  
  :global(html.light) .footer-description {
    color: #6b7280;
  }
  
  :global(html.light) .footer-link {
    color: #6b7280;
  }
  
  :global(html.light) .footer-link:hover {
    color: #4f46e5;
  }
  
  :global(html.light) .footer-bottom {
    border-top-color: rgba(0, 0, 0, 0.1);
  }
  
  :global(html.light) .footer-copyright {
    color: #9ca3af;
  }
</style> 