---
import { profile } from "../data/site";
---

<footer class="footer">
  <div class="foot-panel panel">
    <div class="foot-log font-mono" id="foot-log" aria-hidden="true">
      <div class="fl-bar">
        <span class="fl-title"><span class="fl-dot"></span>tail -f /var/log/deploy.log</span>
        <span class="fl-meta">streaming</span>
      </div>
      <ul class="fl-lines" id="fl-lines"></ul>
    </div>

    <div class="foot-grid">
      <div class="foot-id">
        <span class="foot-name font-display">Malin Malliya Wadu</span>
        <span class="foot-loc font-mono">{profile.locationShort} · {profile.timezone}</span>
      </div>
      <nav class="foot-links font-mono" aria-label="Footer">
        <a href={`mailto:${profile.email}`}>email</a>
        <a href={profile.socials.linkedin} target="_blank" rel="noopener noreferrer">linkedin</a>
        <a href={profile.socials.github} target="_blank" rel="noopener noreferrer">github</a>
        <a href={profile.cv} download>cv</a>
      </nav>
      <p class="foot-built font-mono">
        built with Astro · vanilla canvas · self-hosted type
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }
  .foot-panel {
    overflow: hidden;
  }
  .foot-log {
    border-bottom: 1px solid var(--line);
    background: var(--base-2);
  }
  .fl-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.66rem;
    color: var(--fg-faint);
  }
  .fl-title {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .fl-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 7px var(--signal-glow);
  }
  .fl-meta {
    color: var(--signal);
  }
  .fl-lines {
    list-style: none;
    margin: 0;
    padding: 0.7rem 1rem;
    min-height: 96px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.32rem;
    font-size: 0.72rem;
  }
  /* .fl-line and its children are injected via JS, so their styles live in the
     is:global block below (scoped styles never reach runtime-injected nodes). */

  .foot-grid {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1.1rem clamp(1rem, 3vw, 1.5rem);
  }
  .foot-id {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .foot-name {
    font-weight: 600;
    font-size: 1rem;
    color: var(--fg);
  }
  .foot-loc {
    font-size: 0.66rem;
    color: var(--fg-faint);
  }
  .foot-links {
    display: flex;
    gap: 1.1rem;
    font-size: 0.72rem;
  }
  .foot-links a {
    color: var(--fg-dim);
    transition: color 0.16s var(--ease);
  }
  .foot-links a:hover {
    color: var(--signal);
  }
  .foot-built {
    font-size: 0.64rem;
    color: var(--fg-faint);
    width: 100%;
    text-align: center;
    border-top: 1px solid var(--line);
    padding-top: 0.9rem;
    margin-top: 0.2rem;
  }
  @media (min-width: 720px) {
    .foot-built {
      width: auto;
      border-top: none;
      padding-top: 0;
      margin-top: 0;
      text-align: right;
    }
  }
</style>

<!-- Global: these nodes are created at runtime by the script below, so they
     carry no scoped attribute and must be styled globally. -->
<style is:global>
  .fl-line {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--fg-dim);
    font-size: 0.72rem;
    opacity: 0;
    transform: translateY(4px);
    animation: flLineIn 0.4s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  @keyframes flLineIn {
    to { opacity: 1; transform: none; }
  }
  .fl-line .fl-id {
    color: var(--fg-faint);
    flex: none;
  }
  .fl-line .fl-status {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 6px var(--signal-glow);
    flex: none;
  }
  .fl-line .fl-msg {
    min-width: 0;
  }
  .fl-line.is-incident .fl-status {
    background: var(--coral);
    box-shadow: 0 0 7px rgba(255, 107, 107, 0.6);
  }
  .fl-line.is-incident .fl-msg {
    color: var(--coral);
  }
  @media (prefers-reduced-motion: reduce) {
    .fl-line { animation: none; opacity: 1; transform: none; }
  }
</style>

<script>
  const host = document.getElementById("fl-lines");
  if (host) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const ms = () => Math.floor(28 + Math.random() * 180);
    const events = [
      () => `GET /cv.pdf -> 200 · ${ms()}ms`,
      () => `deploy ok · ap-southeast-2 · ${ms()}ms`,
      () => `health check · 200 OK · ${ms()}ms`,
      () => `build passed · gh-pages · ${40 + Math.floor(Math.random() * 40)}s`,
      () => `cache hit · edge · ${ms()}ms`,
      () => `GET /malin.nz -> 200 · ${ms()}ms`,
      () => `lighthouse · perf 98 · a11y 100`,
    ];
    let seq = 4120 + Math.floor(Math.random() * 800);
    let count = 0;

    const push = () => {
      seq += Math.floor(1 + Math.random() * 5);
      count++;
      const incident = count === 5; // one tasteful coral easter egg
      const msg = incident
        ? "incident resolved · 0 customer impact"
        : events[Math.floor(Math.random() * events.length)]();
      const li = document.createElement("li");
      li.className = "fl-line" + (incident ? " is-incident" : "");
      li.innerHTML = `<span class="fl-id">#${seq}</span><span class="fl-status"></span><span class="fl-msg">${msg}</span>`;
      host.appendChild(li);
      while (host.children.length > 4) host.removeChild(host.firstElementChild as Node);
    };

    push();
    push();
    push();
    if (!reduce) setInterval(push, 2600);
  }
</script>
