---
import Panel from "./Panel.astro";

const deps = [
  { name: "Trade Me", logo: "/logos/trademe.png", role: "NZ's largest marketplace", years: "2011-2019", href: "#exp-trademe" },
  { name: "ANZ Bank", logo: "/logos/anz.svg", role: "Open banking APIs", years: "2025-2026", href: "#exp-anz" },
  { name: "Stats NZ", logo: "/logos/statsnz.svg", role: "National census pipelines", years: "2026-now", href: "#exp-statsnz" },
  { name: "PartsTrader", logo: "/logos/partstrader.svg", role: "US auto-parts SaaS", years: "2022-2025", href: "#exp-partstrader" },
  { name: "Kiwi Wealth", logo: "/logos/kiwiwealth.svg", role: "Wealth platform", years: "2019-2020", href: "#exp-kiwiwealth" },
  { name: "Open Polytechnic", logo: "/logos/open-polytechnic.jpeg", role: "CI/CD + microservices", years: "2021-2022", href: "#exp-openpoly" },
];

// Pro-bono / charity work - shown as a small static row that links into the projects section.
const charities = [
  { name: "Everybody Eats", logo: "/logos/everybody-eats.svg", href: "#work-ee" },
  { name: "Compassion Soup Kitchen", logo: "/logos/compassion-soup-kitchen.svg", href: "#work-csk" },
  { name: "Fair Food", logo: "/logos/fairfood.png", href: "#work-ff" },
];
---

<Panel id="trusted" svc="svc-01" path="svc://upstream-deps" status="9 resolved">
  <div class="sec-head reveal">
    <p class="eyebrow">trusted by · upstream dependencies</p>
    <h2 class="section-title">Banks, government, and the marketplaces millions use</h2>
    <p class="section-lede">
      Fifteen years shipping inside regulated and high-traffic environments - from New Zealand's
      largest marketplace to a major bank and the national statistics office. Between contracts, I
      build and run software pro-bono for Aotearoa charities - shipped end to end and live today.
    </p>
  </div>

  <ul class="dep-grid">
    {
      deps.map((d) => (
        <li class="dep reveal">
          <a href={d.href} class="dep-link" aria-label={`${d.name} - ${d.role}, ${d.years}. Jump to role in experience.`}>
            <div class="dep-chip">
              <img src={d.logo} alt={`${d.name} logo`} loading="lazy" decoding="async" />
            </div>
            <div class="dep-meta font-mono">
              <span class="dep-name">{d.name}<span class="dep-jump">role ↓</span></span>
              <span class="dep-role">{d.role}</span>
              <span class="dep-years">{d.years}</span>
            </div>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="charity reveal">
    <p class="charity-head font-mono">
      <span class="charity-dot" aria-hidden="true"></span>
      pro-bono · charity kitchens &amp; food-rescue
    </p>
    <ul class="charity-row">
      {
        charities.map((c) => (
          <li class="charity-item">
            <a href={c.href} class="charity-link" aria-label={`${c.name} - jump to project in selected work.`}>
              <div class="charity-chip">
                <img src={c.logo} alt={`${c.name} logo`} loading="lazy" decoding="async" />
              </div>
              <span class="charity-name font-mono">{c.name}<span class="charity-jump">project ↓</span></span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Panel>

<style>
  .sec-head {
    margin-bottom: 1.6rem;
    max-width: 46rem;
  }
  .sec-head .eyebrow {
    margin-bottom: 0.7rem;
    display: block;
  }
  .sec-head .section-title {
    margin-bottom: 0.6rem;
  }

  .dep-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.8rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .dep-link {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    color: inherit;
  }
  .dep-chip {
    height: 84px;
    display: grid;
    place-items: center;
    padding: 0 1.4rem;
    border-radius: 11px;
    border: 1px solid var(--line);
    background: linear-gradient(180deg, #fbfcfe, #e9eef4);
    transition: transform 0.18s var(--ease), border-color 0.18s var(--ease), box-shadow 0.18s var(--ease);
  }
  .dep-chip img {
    max-height: 34px;
    max-width: 78%;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.72;
    transition: filter 0.2s var(--ease), opacity 0.2s var(--ease);
  }
  .dep-link:hover .dep-chip,
  .dep-link:focus-visible .dep-chip {
    transform: translateY(-2px);
    border-color: rgba(77, 163, 255, 0.45);
    box-shadow: 0 14px 30px -18px rgba(0, 0, 0, 0.9);
  }
  .dep-link:hover .dep-chip img,
  .dep-link:focus-visible .dep-chip img {
    filter: none;
    opacity: 1;
  }
  .dep-meta {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    padding-left: 0.1rem;
  }
  .dep-name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    color: var(--fg);
  }
  .dep-jump {
    margin-left: auto;
    font-size: 0.62rem;
    color: var(--route);
    opacity: 0;
    transform: translateX(-3px);
    transition: opacity 0.16s var(--ease), transform 0.16s var(--ease);
  }
  .dep-link:hover .dep-jump,
  .dep-link:focus-visible .dep-jump {
    opacity: 1;
    transform: translateX(0);
  }
  .dep-role {
    font-size: 0.68rem;
    color: var(--fg-dim);
  }
  .dep-years {
    font-size: 0.64rem;
    color: var(--fg-faint);
  }

  /* Pro-bono ticker */
  .charity {
    margin-top: 1.5rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }
  .charity-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.9rem;
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    color: var(--fg-faint);
  }
  .charity-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 8px var(--signal-glow);
  }
  .charity-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.8rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .charity-item {
    display: flex;
  }
  .charity-link {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    width: 100%;
    color: inherit;
  }
  .charity-chip {
    height: 70px;
    display: grid;
    place-items: center;
    padding: 0 1.4rem;
    border-radius: 11px;
    border: 1px solid var(--line);
    background: linear-gradient(180deg, #fbfcfe, #e9eef4);
    transition: transform 0.18s var(--ease), border-color 0.18s var(--ease), box-shadow 0.18s var(--ease);
  }
  .charity-chip img {
    max-height: 32px;
    max-width: 80%;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.72;
    transition: filter 0.2s var(--ease), opacity 0.2s var(--ease);
  }
  .charity-link:hover .charity-chip,
  .charity-link:focus-visible .charity-chip {
    transform: translateY(-2px);
    border-color: rgba(77, 163, 255, 0.45);
    box-shadow: 0 14px 30px -18px rgba(0, 0, 0, 0.9);
  }
  .charity-link:hover .charity-chip img,
  .charity-link:focus-visible .charity-chip img {
    filter: none;
    opacity: 1;
  }
  .charity-name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.64rem;
    letter-spacing: 0.02em;
    color: var(--fg-faint);
    padding-left: 0.1rem;
  }
  .charity-jump {
    margin-left: auto;
    font-size: 0.62rem;
    color: var(--route);
    opacity: 0;
    transform: translateX(-3px);
    transition: opacity 0.16s var(--ease), transform 0.16s var(--ease);
  }
  .charity-link:hover .charity-jump,
  .charity-link:focus-visible .charity-jump {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 760px) {
    .dep-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 420px) {
    .dep-grid {
      grid-template-columns: 1fr;
    }
    .charity-row {
      grid-template-columns: 1fr;
    }
    .dep-link {
      flex-direction: row;
      align-items: center;
      gap: 1rem;
    }
    .dep-chip {
      width: 120px;
      flex: none;
      height: 64px;
    }
  }
</style>
